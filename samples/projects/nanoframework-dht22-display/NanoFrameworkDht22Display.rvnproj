<Project Sdk="Raven.Sdk">
  <PropertyGroup>
    <TargetFramework>netnano1.0</TargetFramework>
    <AssemblyName>NanoFrameworkDht22Display</AssemblyName>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="nanoFramework.Iot.Device.Dhtxx" Version="2.0.0-preview.109" />
    <PackageReference Include="nanoFramework.Iot.Device.Ssd13xx" Version="2.0.0-preview.109" />
    <PackageReference Include="nanoFramework.System.Device.I2c" Version="2.0.0-preview.12" />
    <PackageReference Include="nanoFramework.System.Threading" Version="2.0.0-preview.14" />
  </ItemGroup>
</Project>
