import Raven.CodeAnalysis.Macros.*
import Raven.CodeAnalysis.Syntax.*
import Raven.CodeAnalysis.Syntax.SyntaxFactory.*

[assembly: RavenCompilerPlugin(typeof(ObservableMacro))]
[assembly: RavenCompilerPlugin(typeof(SubscribeMacro))]

class ObservableMacro : IAttachedDeclarationMacro {
    val Name: string => "Observable"
    val Targets: MacroTarget => MacroTarget.Property

    func Expand(context: AttachedMacroContext) -> MacroExpansionResult {
        let property: PropertyDeclarationSyntax = context.CurrentDeclaration else {
            return MacroExpansionResult.Empty
        }

        if !IsStorageProperty(property) {
            return MacroExpansionResult {
                MacroDiagnostics = [
                    MacroExpansionDiagnostic.Error(
                        "#[Observable] requires a mutable storage property without accessors or an expression body.",
                        property.GetLocation(),
                        "OBS001")
                ]
            }
        }

        let propertyName = property.Identifier.ValueText
        let backingFieldName = "_${propertyName}"
        let signalStorageName = "_${propertyName}Changed"
        let signalMemberName = "${propertyName}Changed"

        MacroExpansionResult {
            ReplacementDeclaration = CreateReplacementProperty(property, backingFieldName, signalStorageName)
            IntroducedMembers = [
                CreateBackingField(property, backingFieldName),
                CreateSignalStorage(property, signalStorageName),
                CreateSignalProperty(property, signalStorageName, signalMemberName)
            ]
        }
    }

    static func IsStorageProperty(property: PropertyDeclarationSyntax) -> bool {
        let propertyText = property.ToFullString().Trim()
        property.BindingKeyword.ValueText == "var"
            && !propertyText.Contains("{")
            && !propertyText.Contains("=>")
    }

    static func CreateBackingField(property: PropertyDeclarationSyntax, backingFieldName: string) -> PropertyDeclarationSyntax {
        StoredPropertyDeclaration(
            List<AttributeListSyntax>(),
            TokenList([PrivateKeyword]),
            VarKeyword,
            Identifier(backingFieldName),
            property.Type,
            property.Initializer)
    }

    static func CreateSignalStorage(property: PropertyDeclarationSyntax, signalStorageName: string) -> PropertyDeclarationSyntax {
        let subjectType = CreateSubjectType(property.Type.Type)

        PropertyDeclaration(
            List<AttributeListSyntax>(),
            TokenList([PrivateKeyword]),
            ValKeyword,
            Identifier(signalStorageName),
            TypeAnnotationClause(subjectType),
            EqualsValueClause(
                InvocationExpression(
                    subjectType,
                    ArgumentList(SeparatedList<ArgumentSyntax>()))))
    }

    static func CreateSignalProperty(property: PropertyDeclarationSyntax, signalStorageName: string, signalMemberName: string) -> PropertyDeclarationSyntax {
        let observableType = CreateObservableType(property.Type.Type)

        PropertyDeclaration(
            List<AttributeListSyntax>(),
            TokenList(),
            ValKeyword,
            Identifier(signalMemberName),
            TypeAnnotationClause(observableType),
            ArrowExpressionClause(IdentifierName(signalStorageName)))
    }

    static func CreateReplacementProperty(property: PropertyDeclarationSyntax, backingFieldName: string, signalStorageName: string) -> PropertyDeclarationSyntax {
        property with {
            AttributeLists = FilterNonMacroAttributeLists(property.AttributeLists)
            AccessorList = CreateAccessorList(backingFieldName, signalStorageName)
            ExpressionBody = null
            Initializer = null
            TerminatorToken = Token(SyntaxKind.None)
        }
    }

    static func FilterNonMacroAttributeLists(attributeLists: SyntaxList<AttributeListSyntax>) -> SyntaxList<AttributeListSyntax> {
        List<AttributeListSyntax>([
            for attributeList in attributeLists
            if attributeList.Attributes.Count > 0 && !attributeList.Attributes[0].IsMacroAttribute()
                => attributeList
        ])
    }

    static func CreateAccessorList(backingFieldName: string, signalStorageName: string) -> AccessorListSyntax {
        AccessorList(
            List<AccessorDeclarationSyntax>([
                AccessorDeclaration(
                    SyntaxKind.GetAccessorDeclaration,
                    List<AttributeListSyntax>(),
                    TokenList(),
                    GetKeyword,
                    ArrowExpressionClause(IdentifierName(backingFieldName))),
                AccessorDeclaration(
                    SyntaxKind.SetAccessorDeclaration,
                    List<AttributeListSyntax>(),
                    TokenList(),
                    SetKeyword,
                    CreateSetterBody(backingFieldName, signalStorageName))
            ]))
    }

    static func CreateSetterBody(backingFieldName: string, signalStorageName: string) -> BlockStatementSyntax {
        BlockStatement(
            List<StatementSyntax>([
                IfStatement(
                    InfixOperatorExpression(
                        SyntaxKind.NotEqualsExpression,
                        IdentifierName("value"),
                        NotEqualsToken,
                        IdentifierName(backingFieldName)),
                    BlockStatement(
                        List<StatementSyntax>([
                            LocalDeclarationStatement(
                                VariableDeclaration(
                                    ValKeyword,
                                    SeparatedList<VariableDeclaratorSyntax>([
                                        SyntaxNodeOrToken(
                                            VariableDeclarator(
                                                Identifier("oldValue"),
                                                null,
                                                EqualsValueClause(IdentifierName(backingFieldName))))
                                    ]))),
                            AssignmentStatement(
                                SyntaxKind.SimpleAssignmentStatement,
                                IdentifierName(backingFieldName),
                                EqualsToken,
                                IdentifierName("value")),
                            ExpressionStatement(
                                InvocationExpression(
                                    MemberAccessExpression(
                                        SyntaxKind.SimpleMemberAccessExpression,
                                        IdentifierName(signalStorageName),
                                        DotToken,
                                        IdentifierName("OnNext")),
                                    ArgumentList(
                                        SeparatedList<ArgumentSyntax>([
                                            SyntaxNodeOrToken(Argument(IdentifierName("value")))
                                        ]))))
                        ])))
            ]))
    }

    static func CreateSubjectType(valueType: TypeSyntax) -> TypeSyntax {
        GenericName(
            Identifier("Subject"),
            TypeArgumentList(
                SeparatedList<TypeArgumentSyntax>([
                    SyntaxNodeOrToken(TypeArgument(valueType))
                ])))
    }

    static func CreateObservableType(valueType: TypeSyntax) -> TypeSyntax {
        GenericName(
            Identifier("IObservable"),
            TypeArgumentList(
                SeparatedList<TypeArgumentSyntax>([
                    SyntaxNodeOrToken(TypeArgument(valueType))
                ])))
    }
}

class SubscribeMacro : IInvocableMacro {
    val Name: string => "subscribe"
    val AcceptsArguments: bool => true

    func Expand(context: FreestandingMacroContext) -> FreestandingMacroExpansionResult {
        if context.Arguments.Length != 2 {
            return FreestandingMacroExpansionResult.Empty
        }

        let propertyAccess: MemberAccessExpressionSyntax = context.Arguments[0].Expression else {
            return FreestandingMacroExpansionResult.Empty
        }

        let callback = context.Arguments[1].Expression

        let propertyIdentifier: IdentifierNameSyntax = propertyAccess.Name else {
            return FreestandingMacroExpansionResult.Empty
        }

        let signalName = "${propertyIdentifier.Identifier.ValueText}Changed"

        FreestandingMacroExpansionResult {
            Expression = InvocationExpression(
                MemberAccessExpression(
                    SyntaxKind.SimpleMemberAccessExpression,
                    MemberAccessExpression(
                        SyntaxKind.SimpleMemberAccessExpression,
                        propertyAccess.Expression,
                        DotToken,
                        IdentifierName(signalName)),
                    DotToken,
                    IdentifierName("Subscribe")),
                ArgumentList(
                    SeparatedList<ArgumentSyntax>([
                        SyntaxNodeOrToken(Argument(callback))
                    ])))
        }
    }
}
