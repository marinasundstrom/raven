namespace MyServiceBusRabbitMqSample

import MyServiceBus.*

class SubmitOrderConsumer : IConsumer<SubmitOrder> {
    async func Consume(context: ConsumeContext<SubmitOrder>) -> Task {
        let (orderId, customer) = context.Message
        Console.WriteLine("Received SubmitOrder ${orderId} for ${customer}")

        await context.Publish(
            OrderSubmitted(orderId, DateTimeOffset.UtcNow))
    }
}

class OrderSubmittedConsumer : IConsumer<OrderSubmitted> {
    func Consume(context: ConsumeContext<OrderSubmitted>) -> Task {
        let (orderId, acceptedAt) = context.Message
        Console.WriteLine("Observed OrderSubmitted ${orderId} at ${acceptedAt}")
        return Task.CompletedTask
    }
}

[Consumer("check-order-status")]
public func GetOrderStatus(
    request: CheckOrderStatus,
    context: ConsumeContext<CheckOrderStatus>,
    cancellationToken: CancellationToken) -> Task<OrderStatus> {
    let (orderId) = request
    Console.WriteLine("Received CheckOrderStatus ${orderId}")
    Console.WriteLine("Consumer function context order: ${context.Message.OrderId}")
    Console.WriteLine("Consumer function cancellation requested: ${cancellationToken.IsCancellationRequested}")

    return Task.FromResult(OrderStatus(orderId, "Accepted"))
}
