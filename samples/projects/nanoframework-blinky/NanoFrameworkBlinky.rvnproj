<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netnano1.0</TargetFramework>
    <AssemblyName>NanoFrameworkBlinky</AssemblyName>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="nanoFramework.System.Device.Gpio" Version="2.0.0-preview.18" />
  </ItemGroup>

  <ItemGroup Condition="'$(RavenLedPin)' != ''">
    <RavenConstant Include="LedPin" Value="$(RavenLedPin)" />
  </ItemGroup>
</Project>
