import System.Device.Gpio.*
import System.Threading.*

#if PICO or PICO2
const LedPin: int = 25
#endif

func SelectLedPin<T>(pin: T) -> T { pin }

func Main() {
    use gpio = GpioController()
    use led = gpio.OpenPin(SelectLedPin(LedPin), PinMode.Output)

    loop {
        led.Write(PinValue.High)
        Thread.Sleep(500)

        led.Write(PinValue.Low)
        Thread.Sleep(500)
    }
}
