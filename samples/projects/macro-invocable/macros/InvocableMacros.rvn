import System.Collections.Immutable.*
import Raven.CodeAnalysis.Macros.*
import Raven.CodeAnalysis.Syntax.*
import Raven.CodeAnalysis.Syntax.SyntaxFactory.*
import Raven.CodeAnalysis.Text.*
import Raven.Macros.*

[assembly: RavenCompilerPlugin(typeof(AddMacro))]
[assembly: RavenCompilerPlugin(typeof(GuardMacro))]
[assembly: RavenCompilerPlugin(typeof(ChooseMacro))]

class AddMacro : IInvocableMacro {
    val Name: string => "add"
    val AcceptsArguments: bool => true

    func Expand(context: FreestandingMacroContext) -> FreestandingMacroExpansionResult {
        if context.Arguments.Length != 2 {
            return FreestandingMacroExpansionResult.Empty
        }

        FreestandingMacroExpansionResult {
            Expression = quote! {
                #(context.Arguments[0].Expression) + #(context.Arguments[1].Expression)
            }
        }
    }
}

class GuardMacro : ITokenTreeMacro, IMacroKeywordProvider {
    static val UnlessKeywordRawKind: int => 80001

    val Name: string => "guard"

    val Keywords: ImmutableArray<MacroKeyword>
        => [MacroKeyword("unless", UnlessKeywordRawKind)]

    func Expand(context: TokenTreeMacroContext) -> FreestandingMacroExpansionResult {
        let stream = context.CreateTokenStream()

        if stream.IsEndOfFile {
            return Error(context, TextSpan(0, 0), "Expected 'unless' followed by a Raven expression.")
        }

        let keyword = stream.ReadToken()
        if keyword.RawKind != UnlessKeywordRawKind {
            return Error(context, keyword.Span, "Expected the 'unless' keyword.")
        }

        if stream.IsEndOfFile {
            return Error(context, keyword.Span, "Expected a Raven expression after 'unless'.")
        }

        let expressionSpan = TextSpan.FromBounds(keyword.Span.End, context.BodySpan.Length)
        let condition = context.ParseExpression(expressionSpan)

        FreestandingMacroExpansionResult {
            Expression = PrefixOperatorExpression(
                SyntaxKind.LogicalNotExpression,
                ExclamationToken,
                condition)
        }
    }

    static func Error(
        context: TokenTreeMacroContext,
        span: TextSpan,
        message: string
    ) -> FreestandingMacroExpansionResult {
        FreestandingMacroExpansionResult {
            MacroDiagnostics = [
                context.CreateBodyDiagnostic(span, message, code: "GUARD001")
            ]
        }
    }
}

class ChooseMacro : ITokenTreeMacro, IMacroKeywordProvider {
    static val TestKeywordRawKind: int => 80002
    static val ThenKeywordRawKind: int => 80003
    static val OtherwiseKeywordRawKind: int => 80004

    val Name: string => "choose"

    val Keywords: ImmutableArray<MacroKeyword>
        => [
            MacroKeyword("test", TestKeywordRawKind, MacroKeywordClassification.ReservedWord),
            MacroKeyword("then", ThenKeywordRawKind, MacroKeywordClassification.ReservedWord),
            MacroKeyword("otherwise", OtherwiseKeywordRawKind, MacroKeywordClassification.ReservedWord)
        ]

    func Expand(context: TokenTreeMacroContext) -> FreestandingMacroExpansionResult {
        let stream = context.CreateTokenStream()

        if stream.IsEndOfFile {
            return Error(context, TextSpan(0, 0), "Expected a 'test' clause.")
        }

        let testKeyword = stream.ReadToken()
        if testKeyword.RawKind != TestKeywordRawKind {
            return Error(context, testKeyword.Span, "Expected the 'test' keyword.")
        }

        var thenKeyword = testKeyword
        while !stream.IsEndOfFile {
            let token = stream.ReadToken()
            if token.RawKind == ThenKeywordRawKind {
                thenKeyword = token
                break
            }
        }

        if thenKeyword.RawKind != ThenKeywordRawKind {
            return Error(context, testKeyword.Span, "Expected a 'then' clause.")
        }

        var otherwiseKeyword = thenKeyword
        while !stream.IsEndOfFile {
            let token = stream.ReadToken()
            if token.RawKind == OtherwiseKeywordRawKind {
                otherwiseKeyword = token
                break
            }
        }

        if otherwiseKeyword.RawKind != OtherwiseKeywordRawKind {
            return Error(context, thenKeyword.Span, "Expected an 'otherwise' clause.")
        }

        let condition = context.ParseExpression(
            TextSpan.FromBounds(testKeyword.Span.End, thenKeyword.SpanStart))
        let whenTrue = context.ParseExpression(
            TextSpan.FromBounds(thenKeyword.Span.End, otherwiseKeyword.SpanStart))
        let whenFalse = context.ParseExpression(
            TextSpan.FromBounds(otherwiseKeyword.Span.End, context.BodySpan.Length))

        FreestandingMacroExpansionResult {
            Expression = IfExpression(
                IfKeyword,
                condition,
                whenTrue,
                ElseExpressionClause(ElseKeyword, whenFalse))
        }
    }

    static func Error(
        context: TokenTreeMacroContext,
        span: TextSpan,
        message: string
    ) -> FreestandingMacroExpansionResult {
        FreestandingMacroExpansionResult {
            MacroDiagnostics = [
                context.CreateBodyDiagnostic(span, message, code: "CHOOSE001")
            ]
        }
    }
}
