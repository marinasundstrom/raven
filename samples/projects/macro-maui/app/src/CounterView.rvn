namespace MauiCounter

import Microsoft.Maui.Controls.*
import Microsoft.Maui.*

public component! IncrementButton(Increment: () -> unit = func () => {}) {
    let increment = Increment

    maui! {
        <Button
            Text="Increment"
            on:Clicked={func (_, _) => increment()} />
    }
}

public component! CounterView(InitialCount: int = 0) {
    var count = InitialCount

    maui! {
        <VerticalStackLayout
            Padding={Thickness(24.0)}
            Spacing="16.0"
            VerticalOptions={LayoutOptions.Center}>
            <Label
                ref={countLabel}
                Text={"Count: ${count}"}
                FontSize="32.0" />
            {IncrementButton {
                Increment = func () => {
                    count = count + 1
                    countLabel.Text = "Count: ${count}"
                }
            }}
            <HorizontalStackLayout Spacing="8.0">
                {[for caption in ["Declarative Raven", "Native MAUI"] =>
                    Label { Text = caption }]}
            </HorizontalStackLayout>
        </VerticalStackLayout>
    }
}
