import System.*
import System.Collections.Immutable.*
import System.Text.*
import Raven.CodeAnalysis.*
import Raven.CodeAnalysis.Macros.*
import Raven.CodeAnalysis.Syntax.*
import Raven.CodeAnalysis.Syntax.SyntaxFactory.*
import Raven.CodeAnalysis.Text.*

[assembly: RavenCompilerPlugin(typeof(MauiMacro))]

/// Constructs a native MAUI view tree from XML-shaped source.
///
/// Attributes assign CLR properties, `{expression}` embeds ordinary Raven
/// expressions, and `on:Event={handler}` subscribes a native .NET event.
[MacroAlias("Maui")]
class MauiMacro : IMacroDefinition, IMacroFragmentProvider, IMacroTokenClassifier, IMacroTokenSymbolProvider, IMacroCompletionProvider, IMacroEmbeddedLanguageProvider {
    val Name: string => "Maui"
    val Alias: string? => "maui"
    val ExpressionResultType: Type? => typeof(Microsoft.Maui.Controls.View)

    func Expand(context: TokenTreeMacroContext) -> FreestandingMacroExpansionResult {
        let result = MauiDslParser(context).Parse()
        if let error: MauiDslError = result.Error {
            return FreestandingMacroExpansionResult.FromDiagnostic(
                context.CreateBodyDiagnostic(
                    error.Span,
                    error.Message,
                    code: "MAUI001"))
        }

        if result.Diagnostics.Length > 0 {
            return FreestandingMacroExpansionResult.FromDiagnostics(result.Diagnostics)
        }

        let expression = ParseExpression(
            result.ExpressionText,
            context.Syntax.SyntaxTree?.Options)
        FreestandingMacroExpansionResult.FromExpression(expression)
    }

    func GetFragmentRegions(
        context: TokenTreeMacroContext
    ) -> ImmutableArray<MacroFragmentRegion> {
        MauiDslParser(context).Parse().Fragments
    }

    func ClassifyToken(
        context: TokenTreeMacroContext,
        token: SyntaxToken
    ) -> MacroTokenClassification {
        if token.Kind == SyntaxKind.IdentifierToken {
            return MacroTokenClassification.Identifier
        }

        if token.Kind == SyntaxKind.StringLiteralToken
            || token.Kind == SyntaxKind.MultiLineStringLiteralToken
            || token.Kind == SyntaxKind.CharacterLiteralToken
            || token.Kind == SyntaxKind.NumericLiteralToken {
            return MacroTokenClassification.Literal
        }

        if token.Kind == SyntaxKind.LessThanToken
            || token.Kind == SyntaxKind.GreaterThanToken
            || token.Kind == SyntaxKind.SlashToken
            || token.Kind == SyntaxKind.EqualsToken
            || token.Kind == SyntaxKind.OpenBraceToken
            || token.Kind == SyntaxKind.CloseBraceToken
            || token.Kind == SyntaxKind.ColonToken
            || token.Kind == SyntaxKind.MinusToken {
            return MacroTokenClassification.Punctuation
        }

        MacroTokenClassification.Default
    }

    func GetEmbeddedLanguageProjection(
        context: TokenTreeMacroContext
    ) -> MacroEmbeddedLanguageProjection? {
        let result = MauiDslParser(context).Parse()
        context.CreateEmbeddedLanguageProjection("xml", result.Projection)
    }

    func GetTokenSymbol(context: TokenTreeMacroContext, token: SyntaxToken) -> ISymbol? {
        if token.Kind != SyntaxKind.IdentifierToken {
            return null
        }
        let body = context.GetBodyText()
        let tag: MauiOpenTag = FindOpenTag(body, token.Span.Start) else {
            return null
        }
        let controlType: INamedTypeSymbol = FindControlType(context, tag.Name) else {
            return null
        }
        if token.Span.Start >= tag.NameSpan.Start && token.Span.End <= tag.NameSpan.End {
            return controlType
        }

        var current: INamedTypeSymbol? = controlType
        while let currentType: INamedTypeSymbol = current {
            for member in currentType.GetMembers(token.ValueText) {
                if member is IPropertySymbol property {
                    return property
                }
                if member is IEventSymbol eventSymbol {
                    return eventSymbol
                }
            }
            current = currentType.BaseType
        }
        null
    }

    func GetCompletions(
        context: TokenTreeMacroContext,
        bodyRelativePosition: int
    ) -> ImmutableArray<MacroCompletionItem> {
        let body = context.GetBodyText()
        let tagSpan: TextSpan = FindTagCompletionSpan(body, bodyRelativePosition) else {
            return GetAttributeCompletions(context, body, bodyRelativePosition)
        }
        let prefix = body.Substring(tagSpan.Start, tagSpan.Length)
        let controls: INamespaceSymbol = FindNamespace(
            context.Compilation.GlobalNamespace,
            "Microsoft.Maui.Controls") else {
            return []
        }
        var items: ImmutableArray<MacroCompletionItem> = []
        for member in controls.GetMembers() {
            if member is INamedTypeSymbol type
                && type.DeclaredAccessibility == Accessibility.Public
                && !type.IsAbstract
                && type.Name.StartsWith(prefix, StringComparison.OrdinalIgnoreCase)
                && IsView(type) {
                let symbol: ISymbol = type
                items = items.Add(MacroCompletionItem(
                    type.Name,
                    type.Name,
                    tagSpan,
                    Description: "MAUI control",
                    Symbol: symbol))
            }
        }
        items
    }

    private static func GetAttributeCompletions(
        context: TokenTreeMacroContext,
        body: string,
        position: int
    ) -> ImmutableArray<MacroCompletionItem> {
        let span: TextSpan = FindAttributeCompletionSpan(body, position) else {
            return []
        }
        let tag: MauiOpenTag = FindOpenTag(body, span.Start) else {
            return []
        }
        let controlType: INamedTypeSymbol = FindControlType(context, tag.Name) else {
            return []
        }
        let prefix = body.Substring(span.Start, span.Length)
        var items: ImmutableArray<MacroCompletionItem> = []
        var current: INamedTypeSymbol? = controlType
        while let currentType: INamedTypeSymbol = current {
            for member in currentType.GetMembers() {
                if member.DeclaredAccessibility != Accessibility.Public {
                    continue
                }
                var label = member.Name
                var description = "MAUI property"
                if member is IEventSymbol {
                    label = "on:" + member.Name
                    description = "MAUI event"
                } else if !(member is IPropertySymbol) {
                    continue
                }
                if label.StartsWith(prefix, StringComparison.OrdinalIgnoreCase) {
                    items = items.Add(MacroCompletionItem(
                        label,
                        label,
                        span,
                        Description: description,
                        Symbol: member))
                }
            }
            current = currentType.BaseType
        }
        items.Add(MacroCompletionItem("ref", "ref", span, Description: "Typed MAUI control reference"))
    }

    private static func FindControlType(
        context: TokenTreeMacroContext,
        name: string
    ) -> INamedTypeSymbol? {
        let metadataName = if name.Contains(".") { name } else { "Microsoft.Maui.Controls." + name }
        context.Compilation.GetTypeByMetadataName(metadataName)
    }

    private static func FindNamespace(root: INamespaceSymbol, name: string) -> INamespaceSymbol? {
        var current: INamespaceSymbol? = root
        for segment in name.Split(".") {
            let parent: INamespaceSymbol = current else {
                return null
            }
            current = parent.LookupNamespace(segment)
        }
        current
    }

    private static func IsView(type: INamedTypeSymbol) -> bool {
        var current: INamedTypeSymbol? = type
        while let currentType: INamedTypeSymbol = current {
            if currentType.ToFullyQualifiedMetadataName() == "Microsoft.Maui.Controls.View" {
                return true
            }
            current = currentType.BaseType
        }
        false
    }

    private static func FindOpenTag(body: string, position: int) -> MauiOpenTag? {
        if body.Length == 0 {
            return null
        }
        let openPosition = body.LastIndexOf("<", Math.Min(position, body.Length - 1))
        let closePosition = body.LastIndexOf(">", Math.Min(position, body.Length - 1))
        if 0 > openPosition || closePosition > openPosition || openPosition + 1 >= body.Length || body[openPosition + 1] == '/' {
            return null
        }
        var end = openPosition + 1
        while end < body.Length && IsMauiNameCharacter(body[end]) {
            end = end + 1
        }
        MauiOpenTag(
            body.Substring(openPosition + 1, end - openPosition - 1),
            TextSpan(openPosition + 1, end - openPosition - 1))
    }

    private static func FindTagCompletionSpan(body: string, position: int) -> TextSpan? {
        var start = position
        while start > 0 && IsMauiNameCharacter(body[start - 1]) {
            start = start - 1
        }
        if start == 0 || body[start - 1] != '<' {
            return null
        }
        TextSpan(start, position - start)
    }

    private static func FindAttributeCompletionSpan(body: string, position: int) -> TextSpan? {
        if body.Length == 0 {
            return null
        }
        let openPosition = body.LastIndexOf("<", Math.Min(position, body.Length - 1))
        let closePosition = body.LastIndexOf(">", Math.Min(position, body.Length - 1))
        if 0 > openPosition || closePosition > openPosition {
            return null
        }
        var start = position
        while start > openPosition && IsMauiNameCharacter(body[start - 1]) {
            start = start - 1
        }
        TextSpan(start, position - start)
    }

    private static func IsMauiNameCharacter(value: char) -> bool {
        Char.IsLetterOrDigit(value) || value == '_' || value == '-' || value == ':' || value == '.'
    }
}

[LocalMacro]
class MauiOpenTag(val Name: string, val NameSpan: TextSpan)

[LocalMacro]
class MauiDslError(val Span: TextSpan, val Message: string)

[LocalMacro]
class MauiDslExpansion {
    val ExpressionText: string
    val Error: MauiDslError?
    val Fragments: ImmutableArray<MacroFragmentRegion>
    val Diagnostics: ImmutableArray<Diagnostic>
    val Projection: string

    init(
        expressionText: string,
        error: MauiDslError?,
        fragments: ImmutableArray<MacroFragmentRegion>,
        diagnostics: ImmutableArray<Diagnostic>,
        projection: string
    ) {
        ExpressionText = expressionText
        Error = error
        Fragments = fragments
        Diagnostics = diagnostics
        Projection = projection
    }
}

[LocalMacro]
class MauiDslParser {
    private val _context: TokenTreeMacroContext
    private val _source: string
    private val _projection: StringBuilder
    private val _builder = StringBuilder()
    private var _position: int = 0
    private var _error: MauiDslError? = null
    private var _fragments: ImmutableArray<MacroFragmentRegion> = []
    private var _fragmentLocals: ImmutableArray<MacroFragmentLocal> = []
    private var _referenceNames: ImmutableArray<string> = []
    private var _diagnostics: ImmutableArray<Diagnostic> = []
    private var _lastSpliceIsCollection = false

    init(context: TokenTreeMacroContext) {
        _context = context
        _source = context.GetBodyText()
        _projection = StringBuilder(_source)
    }

    func Parse() -> MauiDslExpansion {
        _ = _builder.Append("{")
        SkipWhitespace()
        let root = ParseElement()
        SkipWhitespace()
        if _error is null && !IsEnd() {
            ErrorAt(_position, 1, "Expected a single MAUI root view.")
        }
        _ = _builder.Append(root + "}")

        MauiDslExpansion(
            _builder.ToString(),
            _error,
            _fragments,
            _diagnostics,
            _projection.ToString())
    }

    private func ParseElement() -> string {
        let openingPosition = _position
        if !Consume("<") {
            ErrorAt(_position, 1, "Expected '<' to start a MAUI view.")
            return "Microsoft.Maui.Controls.ContentView()"
        }

        let nameStart = _position
        let name = ReadName()
        if name.Length == 0 {
            ErrorAt(nameStart, 0, "Expected a MAUI view type name.")
            return "Microsoft.Maui.Controls.ContentView()"
        }
        if name.Contains(":") || name.StartsWith(".") || name.EndsWith(".") || name.Contains("..") {
            ErrorAt(nameStart, name.Length, "MAUI view type names must be simple or dot-qualified names.")
            return "Microsoft.Maui.Controls.ContentView()"
        }

        var variableName = _context.CreateUniqueName("mauiView")
        let typeName = QualifyTypeName(name)
        let initializer = StringBuilder()
        let subscriptions = StringBuilder()
        var referenceName: string? = null
        var referenceSpan = TextSpan(0, 0)
        SkipWhitespace()

        while _error is null && !IsEnd() && !At(">") && !At("/>") {
            let attributeStart = _position
            let attributeName = ReadName()
            if attributeName.Length == 0 {
                ErrorAt(_position, 1, "Expected a property, event, or '>'.")
                return variableName
            }
            SkipWhitespace()
            if !Consume("=") {
                ErrorAt(_position, 0, "Expected '=' after '" + attributeName + "'.")
                return variableName
            }
            SkipWhitespace()

            if attributeName == "ref" {
                if referenceName is not null {
                    ErrorAt(attributeStart, attributeName.Length, "A MAUI view can declare only one ref.")
                    return variableName
                }
                let parsedReference = ParseReference()
                referenceName = parsedReference.Name
                referenceSpan = parsedReference.Span
                variableName = parsedReference.Name
            } else {
                var value = ""
                if At("\"") {
                    value = ConvertQuotedValue(typeName, attributeName, ReadQuotedValue())
                } else if At("{") {
                    value = ParseExpressionSplice()
                } else {
                    ErrorAt(_position, 1, "Expected a quoted string or Raven expression for '" + attributeName + "'.")
                    return variableName
                }

                if attributeName.StartsWith("on:", StringComparison.Ordinal) {
                    let eventName = attributeName.Substring(3)
                    if eventName.Length == 0 {
                        ErrorAt(attributeStart, attributeName.Length, "Expected an event name after 'on:'.")
                        return variableName
                    }
                    _ = subscriptions.Append("." + eventName + " += (" + value + ");")
                } else {
                    _ = initializer.Append(attributeName + " = " + value + "\n")
                }
            }
            SkipWhitespace()
        }

        if let localName: string = referenceName {
            if _referenceNames.Contains(localName) {
                ErrorAt(referenceSpan.Start, referenceSpan.Length, "The MAUI ref '" + localName + "' is already declared.")
                return variableName
            }
            _referenceNames = _referenceNames.Add(localName)
            var referenceType: ITypeSymbol = _context.Compilation.ErrorTypeSymbol
            if let resolvedType: ITypeSymbol = _context.Compilation.GetTypeByMetadataName(typeName) {
                referenceType = resolvedType
            }
            _fragmentLocals = _fragmentLocals.Add(
                _context.CreateFragmentLocal(localName, referenceType, referenceSpan))
        }

        _ = _builder.Append("let " + variableName + " = " + typeName + " {")
        _ = _builder.Append(initializer.ToString())
        _ = _builder.Append("};")
        if subscriptions.Length > 0 {
            _ = _builder.Append(variableName + subscriptions.ToString())
        }

        if Consume("/>") {
            return variableName
        }
        if !Consume(">") {
            ErrorAt(openingPosition, Math.Max(1, _position - openingPosition), "Expected '>' after MAUI view '" + name + "'.")
            return variableName
        }

        var childCount = 0
        while _error is null && !IsEnd() {
            SkipWhitespace()
            if At("</") {
                Consume("</")
                let closingStart = _position
                let closingName = ReadName()
                SkipWhitespace()
                if !Consume(">") {
                    ErrorAt(_position, 0, "Expected '>' after the closing MAUI view name.")
                } else if closingName != name {
                    ErrorAt(
                        closingStart,
                        closingName.Length,
                        "Closing MAUI view '" + closingName + "' does not match '" + name + "'.")
                }
                return variableName
            }

            var child = ""
            if At("<") {
                child = ParseElement()
                _lastSpliceIsCollection = false
            } else if At("{") {
                child = ParseExpressionSplice()
            } else {
                let textStart = _position
                let text = ReadText()
                if !String.IsNullOrWhiteSpace(text) {
                    ErrorAt(textStart, text.Length, "Text is not implicit MAUI content; use a Label view.")
                    return variableName
                }
                continue
            }

            childCount = childCount + 1
            if IsSingleContentContainer(name) {
                if childCount > 1 {
                    ErrorAt(openingPosition, name.Length + 1, "MAUI view '" + name + "' accepts only one child in this prototype.")
                    return variableName
                }
                _ = _builder.Append(variableName + ".Content = " + child + ";")
            } else {
                if _lastSpliceIsCollection {
                    let childName = _context.CreateUniqueName("mauiChild")
                    _ = _builder.Append("for " + childName + " in " + child + " {")
                    _ = _builder.Append(variableName + ".Children.Add(" + childName + ")")
                    _ = _builder.Append("};")
                } else {
                    _ = _builder.Append(variableName + ".Children.Add(" + child + ");")
                }
            }
        }

        if _error is null {
            ErrorAt(openingPosition, name.Length + 1, "MAUI view '" + name + "' is missing a closing tag.")
        }
        variableName
    }

    private func ParseReference() -> MauiReference {
        let referenceStart = _position
        if !Consume("{") {
            ErrorAt(_position, 1, "Expected a Raven identifier in braces for 'ref'.")
            return MauiReference("mauiRef", TextSpan(_position, 0))
        }
        SkipWhitespace()
        let nameStart = _position
        let name = ReadName()
        let nameSpan = TextSpan(nameStart, name.Length)
        SkipWhitespace()
        if name.Length == 0 || !IsIdentifier(name) || !Consume("}") {
            ErrorAt(referenceStart, Math.Max(1, _position - referenceStart), "A MAUI ref must contain one Raven identifier.")
            return MauiReference("mauiRef", nameSpan)
        }
        Mask(referenceStart, _position)
        MauiReference(name, nameSpan)
    }

    private func ParseExpressionSplice() -> string {
        _lastSpliceIsCollection = false
        let spliceStart = _position
        Consume("{")
        let expressionStart = _position
        var expressionEnd = _position
        var depth = 1
        var inString = false
        var escaped = false

        while !IsEnd() && depth > 0 {
            let current = Current()
            if inString {
                if escaped {
                    escaped = false
                } else if current == "\\" {
                    escaped = true
                } else if current == "\"" {
                    inString = false
                }
                _position = _position + 1
            } else if current == "\"" {
                inString = true
                _position = _position + 1
            } else if current == "{" {
                depth = depth + 1
                _position = _position + 1
            } else if current == "}" {
                depth = depth - 1
                if depth == 0 {
                    expressionEnd = _position
                }
                _position = _position + 1
            } else {
                _position = _position + 1
            }
        }

        if depth > 0 {
            ErrorAt(spliceStart, Math.Max(1, _position - spliceStart), "Unterminated Raven expression.")
            return "null"
        }

        let untrimmed = _source.Substring(expressionStart, expressionEnd - expressionStart)
        let expression = untrimmed.Trim()
        let leadingWhitespace = untrimmed.Length - untrimmed.TrimStart().Length
        let span = TextSpan(expressionStart + leadingWhitespace, expression.Length)
        if span.Length == 0 {
            ErrorAt(spliceStart, _position - spliceStart, "Embedded Raven expressions cannot be empty.")
            return "null"
        }

        _fragments = _fragments.Add(_context.CreateFragmentRegion(
            MacroFragmentKind.Expression,
            span,
            _fragmentLocals))
        Mask(spliceStart, _position)
        let parsed = _context.ParseExpressionResult(span)
        _diagnostics = _diagnostics.AddRange(parsed.Diagnostics)
        if parsed.Syntax is CollectionExpressionSyntax collection {
            _lastSpliceIsCollection = true
        }
        expression
    }

    private func ReadQuotedValue() -> string {
        Consume("\"")
        let start = _position
        while !IsEnd() && !At("\"") {
            _position = _position + 1
        }
        let value = _source.Substring(start, _position - start)
        if !Consume("\"") {
            ErrorAt(start - 1, Math.Max(1, _position - start + 1), "Unterminated quoted property value.")
        }
        value
    }

    private func ReadText() -> string {
        let start = _position
        while !IsEnd() && !At("<") && !At("{") {
            _position = _position + 1
        }
        _source.Substring(start, _position - start)
    }

    private func ReadName() -> string {
        let start = _position
        while !IsEnd() && IsNameCharacter(Current()) {
            _position = _position + 1
        }
        _source.Substring(start, _position - start)
    }

    private static func QualifyTypeName(name: string) -> string {
        if name.Contains(".") { name } else { "Microsoft.Maui.Controls." + name }
    }

    private func ConvertQuotedValue(typeName: string, propertyName: string, value: string) -> string {
        let escapedValue = "\"" + EscapeRavenString(value) + "\""
        let controlType: INamedTypeSymbol = _context.Compilation.GetTypeByMetadataName(typeName) else {
            return escapedValue
        }
        let property: IPropertySymbol = FindProperty(controlType, propertyName) else {
            return escapedValue
        }
        let propertyTypeName = property.Type.ToDisplayString(SymbolDisplayFormat.MinimallyQualifiedFormat)
        if property.Type.SpecialType == SpecialType.System_String {
            return escapedValue
        }

        for attribute in property.GetAttributes() {
            if attribute.AttributeClass.ToFullyQualifiedMetadataName()
                != "System.ComponentModel.TypeConverterAttribute"
                || attribute.ConstructorArguments.Length == 0 {
                continue
            }
            let converterType: ITypeSymbol = attribute.ConstructorArguments[0].Value else {
                continue
            }
            return WrapConvertedValue(
                propertyTypeName,
                converterType.ToDisplayString(SymbolDisplayFormat.MinimallyQualifiedFormat)
                    + "().ConvertFromInvariantString(" + escapedValue + ")")
        }

        WrapConvertedValue(
            propertyTypeName,
            "System.ComponentModel.TypeDescriptor.GetConverter(typeof("
                + propertyTypeName + ")).ConvertFromInvariantString(" + escapedValue + ")")
    }

    private func WrapConvertedValue(typeName: string, expression: string) -> string {
        let localName = _context.CreateUniqueName("mauiConverted")
        "{ let " + localName + ": " + typeName + " = " + expression
            + " else { throw System.InvalidOperationException(\"MAUI value conversion failed.\") }; "
            + localName + " }"
    }

    private static func FindProperty(type: INamedTypeSymbol, name: string) -> IPropertySymbol? {
        var current: INamedTypeSymbol? = type
        while let currentType: INamedTypeSymbol = current {
            for member in currentType.GetMembers(name) {
                if let property: IPropertySymbol = member {
                    return property
                }
            }
            current = currentType.BaseType
        }
        null
    }

    private static func IsSingleContentContainer(name: string) -> bool {
        let separator = name.LastIndexOf(".")
        let simpleName = name.Substring(separator + 1)
        simpleName == "ContentPage"
            || simpleName == "ContentView"
            || simpleName == "ScrollView"
            || simpleName == "Border"
    }

    private static func IsNameCharacter(value: string) -> bool {
        value.Length == 1 && (
            Char.IsLetterOrDigit(value[0])
            || value == "-"
            || value == "_"
            || value == ":"
            || value == ".")
    }

    private static func IsIdentifier(value: string) -> bool {
        if value.Length == 0 || !(Char.IsLetter(value[0]) || value[0] == '_') {
            return false
        }
        var index = 1
        while index < value.Length {
            if !(Char.IsLetterOrDigit(value[index]) || value[index] == '_') {
                return false
            }
            index = index + 1
        }
        true
    }

    private func Mask(start: int, end: int) {
        var position = start
        while position < end {
            if _source[position] != '\r' && _source[position] != '\n' {
                _projection[position] = ' '
            }
            position = position + 1
        }
    }

    private static func EscapeRavenString(value: string) -> string {
        value
            .Replace("\\", "\\\\")
            .Replace("\"", "\\\"")
            .Replace("\r", "\\r")
            .Replace("\n", "\\n")
    }

    private func SkipWhitespace() {
        while !IsEnd() && Char.IsWhiteSpace(_source[_position]) {
            _position = _position + 1
        }
    }

    private func At(value: string) -> bool {
        _position + value.Length <= _source.Length
            && _source.Substring(_position, value.Length) == value
    }

    private func Consume(value: string) -> bool {
        if !At(value) {
            return false
        }
        _position = _position + value.Length
        true
    }

    private func Current() -> string {
        if IsEnd() { "" } else { _source.Substring(_position, 1) }
    }

    private func IsEnd() -> bool {
        _position >= _source.Length
    }

    private func ErrorAt(position: int, length: int, message: string) {
        if _error is null {
            _error = MauiDslError(
                TextSpan(position, Math.Max(0, length)),
                message)
        }
    }
}

[LocalMacro]
class MauiReference(val Name: string, val Span: TextSpan)
