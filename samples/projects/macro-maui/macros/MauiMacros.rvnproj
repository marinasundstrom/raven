<Project Sdk="Raven.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>MauiMacros</AssemblyName>
    <OutputType>Library</OutputType>
    <PackageId>Raven.Maui.Macros</PackageId>
    <Title>Raven MAUI Macros</Title>
    <Description>Experimental MAUI view-composition macros for Raven.</Description>
    <PackageTags>raven;maui;macros;ui;markup;dsl</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.100" />
    <Reference Include="Raven.CodeAnalysis">
      <HintPath>../../../../src/Raven.CodeAnalysis/bin/Debug/net10.0/Raven.CodeAnalysis.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
