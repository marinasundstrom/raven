import System.Text.*
import System.Collections.Immutable.*
import Raven.CodeAnalysis.*
import Raven.CodeAnalysis.Macros.*
import Raven.CodeAnalysis.Syntax.*
import Raven.CodeAnalysis.Syntax.SyntaxFactory.*
import Raven.CodeAnalysis.Text.*

[assembly: RavenCompilerPlugin(typeof(ActorMacro))]

class ActorMacro : IMacroDefinition, IMacroFragmentProvider {
    val Name: string => "Actor"
    val Alias: string? => "actor"
    val Documentation: string? => "Declares an isolated actor. The first parameter is the message protocol; remaining defaulted parameters are private actor state."

    func GetFragmentRegions(context: TokenTreeMacroContext) -> ImmutableArray<MacroFragmentRegion> {
        let declaration: FreestandingMacroDeclarationSyntax = context.Syntax else {
            return []
        }

        var locals: ImmutableArray<MacroFragmentLocal> = []
        if let parameters: ParameterListSyntax = declaration.ParameterList {
            for parameter in parameters.Parameters {
                let typeAnnotation: TypeAnnotationClauseSyntax = parameter.TypeAnnotation else {
                    continue
                }
                let parameterType: ITypeSymbol = context.SemanticModel.GetTypeInfo(typeAnnotation.Type).ConvertedType else {
                    continue
                }
                locals = locals.Add(context.CreateFragmentParameter(
                    parameter.Identifier.ValueText,
                    parameterType,
                    parameter.Identifier.Span))
            }
        }

        [context.CreateFragmentRegion(
            MacroFragmentKind.Block,
            TextSpan(0, context.BodySpan.Length),
            locals)]
    }

    func Expand(
        declaration: FreestandingMacroDeclarationSyntax,
        body: IMacroTokenStream,
        context: TokenTreeMacroContext
    ) -> MemberDeclarationSyntax {
        body.PeekToken()

        let parameters: ParameterListSyntax = declaration.ParameterList else {
            return declaration
        }
        if parameters.Parameters.Count == 0 {
            return declaration
        }

        let messageParameter = parameters.Parameters[0]
        let messageType: TypeAnnotationClauseSyntax = messageParameter.TypeAnnotation else {
            return declaration
        }

        let source = StringBuilder()
        source.Append("class ")
        source.Append(declaration.Identifier.ValueText)
        source.Append(" : Proto.IActor {")

        var index = 1
        while index < parameters.Parameters.Count {
            let state = parameters.Parameters[index]
            let stateType: TypeAnnotationClauseSyntax = state.TypeAnnotation else {
                return declaration
            }
            let initialValue: EqualsValueClauseSyntax = state.DefaultValue else {
                return declaration
            }

            source.Append("private var ")
            source.Append(state.Identifier.ValueText)
            source.Append(stateType.ToString())
            source.Append(initialValue.ToString())
            source.Append(";")
            index = index + 1
        }

        source.Append("static func Props() -> Proto.Props => Proto.Props.FromProducer(func () => ")
        source.Append(declaration.Identifier.ValueText)
        source.Append("());")
        source.Append("func ReceiveAsync(context: Proto.IContext) -> System.Threading.Tasks.Task {")
        source.Append("if let ")
        source.Append(messageParameter.Identifier.ValueText)
        source.Append(": ")
        source.Append(messageType.Type.ToString())
        source.Append(" = context.Message {")

        let expandedBodyStart = source.Length
        let bodyText = context.GetBodyText()
        source.Append(bodyText)
        source.Append("}")
        source.Append("return System.Threading.Tasks.Task.CompletedTask")
        source.Append("} }")

        let tree = ParseSyntaxTree(source.ToString())
        let actorClass = tree.GetRoot().Members[0]
        let sourceMaps: ImmutableArray<MacroExpansionSourceMap> = [
            MacroExpansionSourceMap(
                TextSpan(expandedBodyStart, bodyText.Length),
                TextSpan(0, bodyText.Length))
        ]

        context.WithOrigins(actorClass, sourceMaps)
    }
}
