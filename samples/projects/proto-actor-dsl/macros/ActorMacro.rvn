import System.Text.*
import System.Collections.Immutable.*
import Raven.CodeAnalysis.*
import Raven.CodeAnalysis.Macros.*
import Raven.CodeAnalysis.Syntax.*
import Raven.CodeAnalysis.Syntax.SyntaxFactory.*
import Raven.CodeAnalysis.Text.*

[assembly: RavenCompilerPlugin(typeof(ActorMacro))]

class ActorMacro : IMacroDefinition, IMacroKeywordProvider, IMacroFragmentProvider {
    static val StartedKeywordRawKind: int => 82001
    static val ReceiveKeywordRawKind: int => 82002
    static val StoppingKeywordRawKind: int => 82003

    val Name: string => "Actor"
    val Alias: string? => "actor"
    val Documentation: string? => "Declares an isolated actor with optional lifecycle clauses and one domain-message protocol."

    val Keywords: ImmutableArray<MacroKeyword>
        => [
            MacroKeyword("started", StartedKeywordRawKind),
            MacroKeyword("receive", ReceiveKeywordRawKind),
            MacroKeyword("stopping", StoppingKeywordRawKind)
        ]

    func GetFragmentRegions(context: TokenTreeMacroContext) -> ImmutableArray<MacroFragmentRegion> {
        let declaration: FreestandingMacroDeclarationSyntax = context.Syntax else {
            return []
        }

        let locals = CreateFragmentLocals(declaration, context)
        let stream = context.CreateTokenStream()
        var regions: ImmutableArray<MacroFragmentRegion> = []

        if !stream.IsEndOfFile && stream.PeekToken().RawKind == StartedKeywordRawKind {
            stream.ReadToken()
            let started = stream.ParseStatement()
            if let block: BlockStatementSyntax = started.Syntax {
                regions = regions.Add(context.CreateFragmentRegion(
                    MacroFragmentKind.Block,
                    GetBlockBodySpan(block, context),
                    locals))
            }
        }

        if stream.IsEndOfFile || stream.ReadToken().RawKind != ReceiveKeywordRawKind {
            return regions
        }

        let receive = stream.ParseStatement()
        if let block: BlockStatementSyntax = receive.Syntax {
            regions = regions.Add(context.CreateFragmentRegion(
                MacroFragmentKind.Block,
                GetBlockBodySpan(block, context),
                locals))
        }

        if !stream.IsEndOfFile && stream.PeekToken().RawKind == StoppingKeywordRawKind {
            stream.ReadToken()
            let stopping = stream.ParseStatement()
            if let block: BlockStatementSyntax = stopping.Syntax {
                regions = regions.Add(context.CreateFragmentRegion(
                    MacroFragmentKind.Block,
                    GetBlockBodySpan(block, context),
                    locals))
            }
        }

        regions
    }

    func Expand(
        declaration: FreestandingMacroDeclarationSyntax,
        body: IMacroTokenStream,
        context: TokenTreeMacroContext
    ) -> FreestandingMacroExpansionResult {
        let parameters: ParameterListSyntax = declaration.ParameterList else {
            return DeclarationError(context, declaration, "An actor declaration requires a message parameter.")
        }
        if parameters.Parameters.Count == 0 {
            return DeclarationError(context, declaration, "An actor declaration requires a message parameter.")
        }

        let messageParameter = parameters.Parameters[0]
        let messageType: TypeAnnotationClauseSyntax = messageParameter.TypeAnnotation else {
            return DeclarationError(context, declaration, "The actor message parameter requires an explicit protocol type.")
        }

        let stream = context.CreateTokenStream()
        var startedBody: BlockStatementSyntax? = null
        var stoppingBody: BlockStatementSyntax? = null

        if !stream.IsEndOfFile && stream.PeekToken().RawKind == StartedKeywordRawKind {
            stream.ReadToken()
            let started = stream.ParseStatement()
            if started.HasErrors {
                return FreestandingMacroExpansionResult.FromDiagnostics(started.Diagnostics)
            }
            let block: BlockStatementSyntax = started.Syntax else {
                return BodyError(context, started.BodyRelativeSpan, "The 'started' clause requires a block.")
            }
            startedBody = block
        }

        if stream.IsEndOfFile {
            return BodyError(context, TextSpan(context.BodySpan.Length, 0), "Expected a 'receive' clause.")
        }

        let receiveKeyword = stream.ReadToken()
        if receiveKeyword.RawKind != ReceiveKeywordRawKind {
            return BodyError(
                context,
                TextSpan(receiveKeyword.SpanStart, receiveKeyword.Text.Length),
                "Expected the 'receive' clause after optional startup behavior.")
        }

        let receive = stream.ParseStatement()
        if receive.HasErrors {
            return FreestandingMacroExpansionResult.FromDiagnostics(receive.Diagnostics)
        }
        let receiveBody: BlockStatementSyntax = receive.Syntax else {
            return BodyError(context, receive.BodyRelativeSpan, "The 'receive' clause requires a block.")
        }

        if !stream.IsEndOfFile && stream.PeekToken().RawKind == StoppingKeywordRawKind {
            stream.ReadToken()
            let stopping = stream.ParseStatement()
            if stopping.HasErrors {
                return FreestandingMacroExpansionResult.FromDiagnostics(stopping.Diagnostics)
            }
            let block: BlockStatementSyntax = stopping.Syntax else {
                return BodyError(context, stopping.BodyRelativeSpan, "The 'stopping' clause requires a block.")
            }
            stoppingBody = block
        }

        if !stream.IsEndOfFile {
            let unexpected = stream.PeekToken()
            return BodyError(
                context,
                TextSpan(unexpected.SpanStart, unexpected.Text.Length),
                "Expected the end of the actor declaration.")
        }

        let source = StringBuilder()
        source.Append("class ")
        source.Append(declaration.Identifier.ValueText)

        var dependencyCount = 0
        var index = 1
        while index < parameters.Parameters.Count {
            let dependency = parameters.Parameters[index]
            let dependencyType: TypeAnnotationClauseSyntax = dependency.TypeAnnotation else {
                return DeclarationError(context, dependency, "Actor dependencies and state require explicit types.")
            }

            if let stateInitializer: EqualsValueClauseSyntax = dependency.DefaultValue {
                _ = stateInitializer
            } else {
                if dependencyCount == 0 {
                    _ = source.Append("(")
                } else {
                    _ = source.Append(", ")
                }
                source.Append("private val ")
                source.Append(dependency.Identifier.ValueText)
                source.Append(dependencyType.ToString())
                dependencyCount = dependencyCount + 1
            }

            index = index + 1
        }
        if dependencyCount > 0 {
            source.Append(")")
        }
        source.Append(" : Proto.IActor {")

        index = 1
        while index < parameters.Parameters.Count {
            let state = parameters.Parameters[index]
            let stateType: TypeAnnotationClauseSyntax = state.TypeAnnotation else {
                return DeclarationError(context, state, "Actor dependencies and state require explicit types.")
            }
            if let initialValue: EqualsValueClauseSyntax = state.DefaultValue {
                source.Append("private var ")
                source.Append(state.Identifier.ValueText)
                source.Append(stateType.ToString())
                source.Append(initialValue.ToString())
                source.Append(";")
            }
            index = index + 1
        }

        if dependencyCount > 0 {
            _ = source.Append("static func Props(system: Proto.ActorSystem) -> Proto.Props => ")
            source.Append("Proto.DependencyInjection.Extensions.DI(system).PropsFor<")
            source.Append(declaration.Identifier.ValueText)
            source.Append(">();")
        } else {
            _ = source.Append("static func Props() -> Proto.Props => Proto.Props.FromProducer(func () => ")
            source.Append(declaration.Identifier.ValueText)
            source.Append("());")
        }
        source.Append("func ReceiveAsync(context: Proto.IContext) -> System.Threading.Tasks.Task {")

        var sourceMaps: ImmutableArray<MacroExpansionSourceMap> = []
        let bodyText = context.GetBodyText()

        if let block: BlockStatementSyntax = startedBody {
            source.Append("if let startedEvent: Proto.Started = context.Message {")
            let originalSpan = GetBlockBodySpan(block, context)
            let expandedStart = source.Length
            source.Append(bodyText.Substring(originalSpan.Start, originalSpan.Length))
            sourceMaps = sourceMaps.Add(MacroExpansionSourceMap(
                TextSpan(expandedStart, originalSpan.Length),
                originalSpan))
            source.Append("return System.Threading.Tasks.Task.CompletedTask")
            source.Append("}")
        }

        source.Append("if let ")
        source.Append(messageParameter.Identifier.ValueText)
        source.Append(": ")
        source.Append(messageType.Type.ToString())
        source.Append(" = context.Message {")
        let receiveSpan = GetBlockBodySpan(receiveBody, context)
        let receiveExpandedStart = source.Length
        source.Append(bodyText.Substring(receiveSpan.Start, receiveSpan.Length))
        sourceMaps = sourceMaps.Add(MacroExpansionSourceMap(
            TextSpan(receiveExpandedStart, receiveSpan.Length),
            receiveSpan))
        source.Append("return System.Threading.Tasks.Task.CompletedTask")
        source.Append("}")

        if let stoppingBlock: BlockStatementSyntax = stoppingBody {
            source.Append("if let stoppingEvent: Proto.Stopping = context.Message {")
            let originalSpan = GetBlockBodySpan(stoppingBlock, context)
            let expandedStart = source.Length
            source.Append(bodyText.Substring(originalSpan.Start, originalSpan.Length))
            sourceMaps = sourceMaps.Add(MacroExpansionSourceMap(
                TextSpan(expandedStart, originalSpan.Length),
                originalSpan))
            source.Append("return System.Threading.Tasks.Task.CompletedTask")
            source.Append("}")
        }

        source.Append("return System.Threading.Tasks.Task.CompletedTask")
        source.Append("} }")

        let tree = ParseSyntaxTree(source.ToString())
        let actorClass = tree.GetRoot().Members[0]
        FreestandingMacroExpansionResult.FromNode(context.WithOrigins(actorClass, sourceMaps))
    }

    static func CreateFragmentLocals(
        declaration: FreestandingMacroDeclarationSyntax,
        context: TokenTreeMacroContext
    ) -> ImmutableArray<MacroFragmentLocal> {
        var locals: ImmutableArray<MacroFragmentLocal> = []
        if let parameters: ParameterListSyntax = declaration.ParameterList {
            for parameter in parameters.Parameters {
                let typeAnnotation: TypeAnnotationClauseSyntax = parameter.TypeAnnotation else {
                    continue
                }
                let parameterType: ITypeSymbol = context.SemanticModel.GetTypeInfo(typeAnnotation.Type).ConvertedType else {
                    continue
                }
                locals = locals.Add(context.CreateFragmentParameter(
                    parameter.Identifier.ValueText,
                    parameterType,
                    parameter.Identifier.Span))
            }
        }

        let actorContextType: ITypeSymbol = context.Compilation.GetTypeByMetadataName("Proto.IContext") else {
            return locals
        }
        locals = locals.Add(context.CreateFragmentLocal("context", actorContextType))
        locals
    }

    static func GetBlockBodySpan(block: BlockStatementSyntax, context: TokenTreeMacroContext) -> TextSpan {
        TextSpan.FromBounds(
            block.OpenBraceToken.Span.End - context.BodySpan.Start,
            block.CloseBraceToken.Span.Start - context.BodySpan.Start)
    }

    static func DeclarationError(
        context: TokenTreeMacroContext,
        syntax: SyntaxNode,
        message: string
    ) -> FreestandingMacroExpansionResult {
        FreestandingMacroExpansionResult.FromDiagnostic(
            context.CreateDiagnostic(message, syntax: syntax, code: "ACTOR001"))
    }

    static func BodyError(
        context: TokenTreeMacroContext,
        span: TextSpan,
        message: string
    ) -> FreestandingMacroExpansionResult {
        FreestandingMacroExpansionResult.FromDiagnostic(
            context.CreateBodyDiagnostic(span, message, code: "ACTOR002"))
    }
}
