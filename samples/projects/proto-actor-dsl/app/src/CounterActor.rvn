namespace ProtoActorDslSample

actor! CounterActor(
    command: CounterCommand,
    events: ICounterEvents,
    count: int = 0
) {
    started {
        events.Started()
    }

    receive {
        match command {
            .Add(let amount) => count = count + amount
            .Subtract(let amount) => count = count - amount
            .Reset => count = 0
            .Get => context.Respond(CounterSnapshot(count))
        }
    }

    stopping {
        events.Stopping(count)
    }
}
