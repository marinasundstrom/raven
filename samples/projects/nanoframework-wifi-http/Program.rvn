import nanoFramework.Networking.*
import System.*
import System.Device.Gpio.*
import System.Diagnostics.*
import System.Net.Http.*
import System.Net.Security.*
import System.Threading.*

extern const LedPin: int = 15
extern const Wifi_SSID: string
extern const Wifi_Password: string

union NetworkRequestResult {
    case Success
    case NetworkUnavailable(message: string)
    case NetworkSetupFailed(message: string)
    case HttpFailureStatus(status: string)
    case HttpRequestFailed(message: string)
}

func Pulse(led: GpioPin, pulses: int) {
    var remaining = pulses

    while remaining > 0 {
        led.Write(PinValue.High)
        Thread.Sleep(200)
        led.Write(PinValue.Low)
        Thread.Sleep(250)
        remaining = remaining - 1
    }
}

func SignalFailure(led: GpioPin, pulses: int) {
    loop {
        Pulse(led, pulses)
        Thread.Sleep(1200)
    }
}

func ConnectAndGet(ssid: string, password: string, requestUri: string) -> NetworkRequestResult {
    Debug.WriteLine("Wi-Fi: waiting for an address...")

    try {
        use networkTimeout = CancellationTokenSource(60000)
        if !WifiNetworkHelper.ScanAndConnectDhcp(
            ssid,
            password,
            requiresDateTime: true,
            token: networkTimeout.Token) {
            let status = (int)WifiNetworkHelper.Status
            return .NetworkUnavailable(
                "ScanAndConnectDhcp failed with status " + status.ToString())
        }
    } catch (Exception exception) {
        return .NetworkSetupFailed(exception.Message)
    }

    Debug.WriteLine("Wi-Fi ready. Sending GET " + requestUri)

    try {
        use client = HttpClient {
            Timeout = TimeSpan.FromSeconds(30)
            SslVerification = SslVerification.NoVerification
        }
        Debug.WriteLine("WARNING: TLS certificate verification is disabled for this sample.")

        use response = client.Get(requestUri)
        if response.IsSuccessStatusCode {
            return .Success
        }

        return .HttpFailureStatus(response.StatusCode.ToString())
    } catch (Exception exception) {
        return .HttpRequestFailed(exception.Message)
    }
}

func Main() {
    use gpio = GpioController()
    use led = gpio.OpenPin(LedPin, PinMode.Output)

    // Three startup pulses prove that Main and GP15 are working before Wi-Fi.
    Pulse(led, 3)
    Thread.Sleep(750)

    // Stay off while the blocking network operation runs. High means success.
    led.Write(PinValue.Low)
    let result = ConnectAndGet(Wifi_SSID, Wifi_Password, "https://example.com")

    match result {
        .Success => {
            led.Write(PinValue.High)

            // Keep the pin and controller alive so the success LED stays on.
            loop {
                Thread.Sleep(60000)
            }
        }
        .NetworkUnavailable(let message) => {
            Debug.WriteLine("Wi-Fi failed: " + message)
            SignalFailure(led, 1)
        }
        .NetworkSetupFailed(let message) => {
            Debug.WriteLine("Wi-Fi setup threw: " + message)
            SignalFailure(led, 1)
        }
        .HttpFailureStatus(let status) => {
            Debug.WriteLine("HTTP failure status: " + status)
            SignalFailure(led, 2)
        }
        .HttpRequestFailed(let message) => {
            Debug.WriteLine("HTTP request failed: " + message)
            SignalFailure(led, 3)
        }
    }
}
