<Project Sdk="Raven.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <RavenRunAnalyzers>false</RavenRunAnalyzers>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <DefaultItemExcludes>$(DefaultItemExcludes);extension/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>

    <ProjectReference
      Include="extension/RouteGenerator.rvnproj"
      ReferenceOutputAssembly="false" />

    <SourceGenerator
      Include="extension/bin/$(Configuration)/$(TargetFramework)/RouteGenerator.dll" />
  </ItemGroup>
</Project>
