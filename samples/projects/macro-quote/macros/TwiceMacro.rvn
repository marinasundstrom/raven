import Raven.CodeAnalysis.Macros.*
import Raven.Macros.*

[assembly: RavenCompilerPlugin(typeof(TwiceMacro))]

class TwiceMacro : IFreestandingExpressionMacro {
    val Name: string => "twice"
    val AcceptsArguments: bool => true

    func Expand(context: FreestandingMacroContext) -> FreestandingMacroExpansionResult {
        if context.Arguments.Length != 1 {
            return FreestandingMacroExpansionResult.Empty
        }

        FreestandingMacroExpansionResult {
            Expression = quote! {
                #(context.Arguments[0].Expression) + #(context.Arguments[0].Expression)
            }
        }
    }
}
