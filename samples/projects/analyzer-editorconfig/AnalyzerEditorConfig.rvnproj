<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>AnalyzerEditorConfig</AssemblyName>
    <OutputType>Exe</OutputType>
    <RavenEnabledAnalyzers>NonNullDeclarationsAnalyzer;ThrowStatementUseResultAnalyzer;PreferDuLinqExtensionsAnalyzer</RavenEnabledAnalyzers>
  </PropertyGroup>
</Project>
