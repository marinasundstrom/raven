@page "/"
@rendermode InteractiveServer

<PageTitle>Raven × Blazor</PageTitle>

<main>
    <nav class="nav-shell" aria-label="Main navigation">
        <a class="brand" href="/" aria-label="Raven home">
            <span class="brand-mark">R</span>
            <span>Raven</span>
        </a>
        <div class="nav-meta">
            <span class="status-dot"></span>
            Macro prototype
        </div>
    </nav>

    <section class="hero">
        <div class="eyebrow"><span>Experimental</span> HTML-shaped DSL → native Blazor</div>
        <h1>Components that read like the <em>web.</em></h1>
        <p class="hero-copy">
            A Raven macro turns familiar HTML into a real <code>RenderFragment</code>—with parameters,
            state, nested components, list comprehensions, pattern matching, and event callbacks intact.
        </p>
        <div class="hero-actions">
            <a class="primary-action" href="#playground">Try the components <span>↓</span></a>
            <span class="build-note">Compiled by Raven · Rendered by Blazor</span>
        </div>
    </section>

    <section class="showcase" id="playground">
        <header class="section-heading">
            <div>
                <span class="section-number">01</span>
                <h2>State, without ceremony</h2>
            </div>
            <p>The event expression becomes a typed Blazor callback. Click it—the Raven component owns the state.</p>
        </header>

        <div class="demo-grid">
            <article class="code-card">
                <div class="card-bar">
                    <div class="traffic-lights"><i></i><i></i><i></i></div>
                    <span>Counter.rvn</span>
                    <span class="language-pill">RAVEN</span>
                </div>
                <pre><code class="raven-source"><span class="syntax-attribute">#[Component]</span>
<span class="syntax-keyword">class</span> <span class="syntax-type">Counter</span> {
    <span class="syntax-attribute">#[Parameter]</span>
    <span class="syntax-keyword">var</span> initialCount: <span class="syntax-type">int</span> = <span class="syntax-number">0</span>

    <span class="syntax-keyword">var</span> count: <span class="syntax-type">int</span> = <span class="syntax-number">0</span>

    <span class="syntax-keyword">protected override func</span> <span class="syntax-function">OnInitialized</span>() {
        count = initialCount
    }

    <span class="syntax-keyword">func</span> <span class="syntax-function">increment</span>() {
        count = count + <span class="syntax-number">1</span>
    }

    <span class="syntax-keyword">func</span> <span class="syntax-function">Render</span>() -&gt; <span class="syntax-type">RenderFragment</span> =&gt;
        <span class="syntax-macro">Html!</span> {
            &lt;<span class="syntax-tag">button</span> <span class="syntax-property">onClick</span>={<span class="syntax-function">increment</span>}&gt;
                Count: {count}
            &lt;/<span class="syntax-tag">button</span>&gt;
        }
}</code></pre>
            </article>

            <article class="preview-card counter-preview">
                <div class="preview-label">LIVE PREVIEW</div>
                <div class="component-stage">
                    <DynamicComponent Type="typeof(Counter)" Parameters="CounterParameters" />
                    <p>Each click crosses the generated <code>EventCallback</code>.</p>
                </div>
                <div class="preview-footer"><span></span> Interactive server renderer</div>
            </article>
        </div>
    </section>

    <section class="showcase greeting-showcase">
        <header class="section-heading">
            <div>
                <span class="section-number">02</span>
                <h2>Markup stays markup</h2>
            </div>
            <p>Uppercase tags resolve to Raven component types and pass parameters through Blazor's native component frames.</p>
        </header>

        <div class="demo-grid reverse">
            <article class="preview-card greeting-preview">
                <div class="preview-label">LIVE PREVIEW</div>
                <div class="component-stage">
                    <DynamicComponent Type="typeof(Gallery)" />
                    <p>Two Raven components composed by another Raven component.</p>
                </div>
                <div class="preview-footer"><span></span> Native Blazor component frames</div>
            </article>

            <article class="code-card light-code">
                <div class="card-bar">
                    <div class="traffic-lights"><i></i><i></i><i></i></div>
                    <span>Gallery.rvn</span>
                    <span class="language-pill">RAVEN</span>
                </div>
                <pre><code class="raven-source"><span class="syntax-attribute">#[Component]</span>
<span class="syntax-keyword">class</span> <span class="syntax-type">Gallery</span> {
    <span class="syntax-keyword">func</span> <span class="syntax-function">Render</span>() -&gt; <span class="syntax-type">RenderFragment</span> =&gt;
        <span class="syntax-macro">Html!</span> {
            &lt;<span class="syntax-tag">div</span> <span class="syntax-property">class</span>=<span class="syntax-string">"composition"</span>&gt;
                &lt;<span class="syntax-type">Greeting</span> <span class="syntax-property">name</span>=<span class="syntax-string">"Raven"</span> /&gt;
                &lt;<span class="syntax-type">Counter</span> <span class="syntax-property">initialCount</span>={<span class="syntax-number">3</span>} /&gt;
            &lt;/<span class="syntax-tag">div</span>&gt;
        }
}</code></pre>
            </article>
        </div>
    </section>

    <section class="showcase todo-showcase">
        <header class="section-heading">
            <div>
                <span class="section-number">03</span>
                <h2>Data becomes UI</h2>
            </div>
            <p>Check an item to update the Raven model. The filtered comprehension runs again and Blazor reconciles the keyed components.</p>
        </header>

        <div class="demo-grid todo-grid">
            <article class="code-card">
                <div class="card-bar">
                    <div class="traffic-lights"><i></i><i></i><i></i></div>
                    <span>TodoList.rvn</span>
                    <span class="language-pill">RAVEN</span>
                </div>
                <pre><code class="raven-source"><span class="syntax-attribute">#[Component]</span>
<span class="syntax-keyword">class</span> <span class="syntax-type">TodoList</span> {
    <span class="syntax-keyword">var</span> todos: <span class="syntax-type">Todo</span>[] = [...]
    <span class="syntax-keyword">var</span> showCompleted = <span class="syntax-keyword">false</span>

    <span class="syntax-keyword">func</span> <span class="syntax-function">Render</span>() -&gt; <span class="syntax-type">RenderFragment</span> {
        <span class="syntax-keyword">return</span> <span class="syntax-macro">Html!</span> {
            &lt;<span class="syntax-tag">ul</span> <span class="syntax-property">class</span>=<span class="syntax-string">"todo-list"</span>&gt;
                {[<span class="syntax-keyword">for</span> todo <span class="syntax-keyword">in</span> todos
                    <span class="syntax-keyword">if</span> showCompleted || !todo.IsCompleted =&gt;
                    <span class="syntax-macro">Html!</span> {
                        &lt;<span class="syntax-type">TodoItem</span>
                            <span class="syntax-property">key</span>={todo.Id}
                            <span class="syntax-property">title</span>={todo.Title}
                            <span class="syntax-property">isCompleted</span>={todo.IsCompleted}
                            <span class="syntax-property">toggled</span>={<span class="syntax-function">toggleCallback</span>(todo.Id)} /&gt;
                    }]}
            &lt;/<span class="syntax-tag">ul</span>&gt;
        }
    }
}</code></pre>
            </article>

            <article class="preview-card todo-preview">
                <div class="preview-label">LIVE PREVIEW</div>
                <div class="component-stage todo-stage">
                    <DynamicComponent Type="typeof(TodoList)" />
                </div>
                <div class="preview-footer"><span></span> Re-evaluated from Raven state</div>
            </article>
        </div>
    </section>

    <section class="showcase match-showcase">
        <header class="section-heading">
            <div>
                <span class="section-number">04</span>
                <h2>Control flow is an expression</h2>
            </div>
            <p>Canonical <code>match value</code> destructures closed union cases directly into UI, with exhaustiveness checked by the compiler.</p>
        </header>

        <div class="demo-grid reverse match-grid">
            <article class="preview-card match-preview">
                <div class="preview-label">LIVE PREVIEW</div>
                <div class="component-stage match-stage">
                    <DynamicComponent Type="typeof(MatchShowcase)" />
                </div>
                <div class="preview-footer"><span></span> Prefix match, native fragment</div>
            </article>

            <article class="code-card light-code">
                <div class="card-bar">
                    <div class="traffic-lights"><i></i><i></i><i></i></div>
                    <span>BuildStage.rvn + MatchShowcase.rvn</span>
                    <span class="language-pill">RAVEN</span>
                </div>
                <pre><code class="raven-source"><span class="syntax-keyword">public union class</span> <span class="syntax-type">BuildStage</span> {
    <span class="syntax-keyword">case</span> Designing(feature: <span class="syntax-type">string</span>)
    <span class="syntax-keyword">case</span> Compiling(target: <span class="syntax-type">string</span>)
    <span class="syntax-keyword">case</span> Shipping(version: <span class="syntax-type">string</span>)
}

<span class="syntax-attribute">#[Component]</span>
<span class="syntax-keyword">class</span> <span class="syntax-type">MatchShowcase</span> {
    <span class="syntax-keyword">var</span> stage: <span class="syntax-type">BuildStage</span> = .Designing(<span class="syntax-string">"macro DSLs"</span>)

    <span class="syntax-keyword">func</span> <span class="syntax-function">Render</span>() -&gt; <span class="syntax-type">RenderFragment</span> =&gt;
        <span class="syntax-macro">Html!</span> {
            &lt;<span class="syntax-tag">strong</span>&gt;{<span class="syntax-keyword">match</span> stage {
                .Designing(<span class="syntax-keyword">let</span> feature) =&gt; <span class="syntax-string">"Designing $feature"</span>
                .Compiling(<span class="syntax-keyword">let</span> target) =&gt; <span class="syntax-string">"Compiling $target"</span>
                .Shipping(<span class="syntax-keyword">let</span> version) =&gt; <span class="syntax-string">"Shipping $version"</span>
            }}&lt;/<span class="syntax-tag">strong</span>&gt;
        }
}</code></pre>
            </article>
        </div>
    </section>

    <section class="proof-strip" aria-label="Prototype capabilities">
        <div><strong>Html!</strong><span>Token-tree macro</span></div>
        <div><strong>#[Component]</strong><span>Attached macro</span></div>
        <div><strong>[for … if]</strong><span>List comprehension</span></div>
        <div><strong>match value</strong><span>Exhaustive union rendering</span></div>
    </section>

    <footer>
        <span>Raven language experiment</span>
        <span class="footer-line"></span>
        <span>HTML macro / Blazor target</span>
    </footer>
</main>

@code {
    private static readonly Dictionary<string, object?> CounterParameters = new()
    {
        ["initialCount"] = 7,
    };

}
