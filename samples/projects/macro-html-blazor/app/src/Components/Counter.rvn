import Microsoft.AspNetCore.Components.*

#[Component]
public class Counter {
    #[Parameter]
    var InitialCount: int = 0

    var count: int = 0

    protected override func OnInitialized() {
        count = InitialCount
    }

    func increment() {
        count = count + 1
    }

    func Render() -> RenderFragment =>
        Markup! {
            <button class="counter-button" onClick={increment}>
                Count: {count}
            </button>
        }
}
