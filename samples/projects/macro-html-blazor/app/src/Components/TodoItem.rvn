import System.Threading.Tasks.*
import Microsoft.AspNetCore.Components.*

#[Component]
public class TodoItem {
    #[Parameter]
    var Id: int = 0

    #[Parameter]
    var Title: string = ""

    #[Parameter]
    var IsCompleted: bool = false

    #[Parameter]
    var Toggled: EventCallback<int> = default(EventCallback<int>)

    func toggle() -> Task => Toggled.InvokeAsync(Id)

    func Render() -> RenderFragment =>
        Markup! {
            <li class={if IsCompleted { "todo-item is-complete" } else { "todo-item" }}>
                <label>
                    <input type="checkbox" checked={IsCompleted} onChange={toggle} />
                    <span class="todo-marker">{if IsCompleted { "✓" } else { "" }}</span>
                    <span class="todo-title">{Title}</span>
                </label>
            </li>
        }
}
