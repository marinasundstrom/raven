import Microsoft.AspNetCore.Components.*

#[Component]
public class MatchShowcase {
    var stage: BuildStage = .Designing("macro DSLs")

    func advance() {
        stage = next(stage)
    }

    func next(current: BuildStage) -> BuildStage =>
        match current {
            .Designing(_) => .Compiling("Blazor")
            .Compiling(_) => .Shipping("v0.1")
            .Shipping(_) => .Designing("macro DSLs")
        }

    func Render() -> RenderFragment =>
        Html! {
            <section class="match-board">
                <header class="match-heading">
                    <span class="match-kicker">Expression-oriented UI</span>
                    <h2>Match union cases into UI</h2>
                </header>
                <div class="match-results">
                    <div class="match-result match-primary">
                        <span class="match-label">Prefix match + destructuring</span>
                        <strong>{match stage {
                            .Designing(let feature) => "Designing $feature"
                            .Compiling(let target) => "Compiling $target"
                            .Shipping(let version) => "Shipping $version"
                        }}</strong>
                    </div>
                </div>
                <button class="match-advance" onClick={advance}>Advance state</button>
            </section>
        }
}
