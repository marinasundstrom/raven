import System.*
import System.Collections.Immutable.*
import System.IO.*
import System.Text.*
import Raven.CodeAnalysis.Macros.*
import Raven.CodeAnalysis.*
import Raven.CodeAnalysis.Syntax.*
import Raven.CodeAnalysis.Syntax.SyntaxFactory.*
import Raven.CodeAnalysis.Text.*

[assembly: RavenCompilerPlugin(typeof(HtmlMacro))]

class HtmlMacro : ITokenTreeMacro, IMacroFragmentProvider, IMacroTokenClassifier, IMacroTokenSymbolProvider {
    val Name: string => "Html"

    func GetTokenSymbol(context: TokenTreeMacroContext, token: SyntaxToken) -> ISymbol? {
        if token.Kind != SyntaxKind.IdentifierToken {
            return null
        }

        let expansion = HtmlDslParser(context.GetBodyText(), context.Compilation, context).Parse()
        for component in expansion.Components {
            if component.SymbolSpan.Start == token.Span.Start
                && component.SymbolSpan.Length == token.Span.Length {
                return context.Compilation.GetTypeByMetadataName(component.Name)
            }
        }

        for attribute in expansion.ComponentAttributes {
            if attribute.NameSpan.Start == token.Span.Start
                && attribute.NameSpan.Length == token.Span.Length {
                let component: INamedTypeSymbol = context.Compilation.GetTypeByMetadataName(attribute.ComponentName) else {
                    return null
                }

                for member in component.GetMembers(attribute.AttributeName) {
                    if member is IPropertySymbol property {
                        return property
                    }
                }

                return null
            }
        }

        context.Compilation.GetTypeByMetadataName(token.ValueText)
    }

    func ClassifyToken(
        context: TokenTreeMacroContext,
        token: SyntaxToken
    ) -> MacroTokenClassification {
        if token.Kind == SyntaxKind.IdentifierToken {
            return MacroTokenClassification.Identifier
        }

        if token.Kind == SyntaxKind.StringLiteralToken
            || token.Kind == SyntaxKind.MultiLineStringLiteralToken
            || token.Kind == SyntaxKind.CharacterLiteralToken
            || token.Kind == SyntaxKind.NumericLiteralToken {
            return MacroTokenClassification.Literal
        }

        if token.Kind == SyntaxKind.LessThanToken
            || token.Kind == SyntaxKind.GreaterThanToken
            || token.Kind == SyntaxKind.SlashToken
            || token.Kind == SyntaxKind.EqualsToken
            || token.Kind == SyntaxKind.OpenBraceToken
            || token.Kind == SyntaxKind.CloseBraceToken
            || token.Kind == SyntaxKind.ColonToken
            || token.Kind == SyntaxKind.MinusToken {
            return MacroTokenClassification.Punctuation
        }

        MacroTokenClassification.Default
    }

    func GetFragmentRegions(context: TokenTreeMacroContext) -> ImmutableArray<MacroFragmentRegion> {
        let expansion = HtmlDslParser(context.GetBodyText(), context.Compilation, context).Parse()
        var regions: ImmutableArray<MacroFragmentRegion> = []

        for span in expansion.EmbeddedExpressionSpans {
            if let targetType: ITypeSymbol = expansion.GetExpressionTargetType(span) {
                regions = regions.Add(
                    context.CreateExpressionFragmentRegion(
                        span,
                        targetType))
            } else {
                regions = regions.Add(
                    context.CreateFragmentRegion(MacroFragmentKind.Expression, span))
            }
        }

        regions
    }

    func Expand(context: TokenTreeMacroContext) -> FreestandingMacroExpansionResult {
        let parser = HtmlDslParser(
            context.GetBodyText(),
            context.Compilation,
            context,
            GetCssScope(context))
        let expansion = parser.Parse()

        if let errorMessage: string = expansion.ErrorMessage {
            return FreestandingMacroExpansionResult.FromDiagnostic(
                context.CreateBodyDiagnostic(
                    TextSpan(expansion.ErrorPosition, 0),
                    errorMessage,
                    code: "HTML001"))
        }

        for span in expansion.EmbeddedExpressionSpans {
            let expression = context.ParseExpressionResult(span)
            if expression.HasErrors {
                return FreestandingMacroExpansionResult.FromDiagnostics(expression.Diagnostics)
            }
        }

        let expandedExpression = ParseExpression(expansion.ExpressionText)
        FreestandingMacroExpansionResult.FromExpression(
            context.WithOrigins(expandedExpression, expansion.SourceMaps))
    }

    private static func GetCssScope(context: TokenTreeMacroContext) -> string? {
        let syntaxTree: SyntaxTree = context.Syntax.SyntaxTree else {
            return null
        }
        let filePath = syntaxTree.FilePath
        if String.IsNullOrWhiteSpace(filePath) {
            return null
        }

        let key = "html.blazor.css-scope:${Path.GetFullPath(filePath)}"
        let features = syntaxTree.Options.Features
        if features.ContainsKey(key) {
            return features[key]
        }

        null
    }
}

class HtmlDslExpansion {
    val ExpressionText: string
    val ErrorMessage: string?
    val ErrorPosition: int
    val EmbeddedExpressionSpans: ImmutableArray<TextSpan>
    val Components: ImmutableArray<HtmlComponentReference>
    val ComponentAttributes: ImmutableArray<HtmlComponentAttribute>
    val TypedExpressionTargets: ImmutableArray<HtmlTypedExpressionTarget>
    val SourceMaps: ImmutableArray<MacroExpansionSourceMap>

    init(
        expressionText: string,
        errorMessage: string?,
        errorPosition: int,
        embeddedExpressionSpans: ImmutableArray<TextSpan>,
        components: ImmutableArray<HtmlComponentReference>,
        componentAttributes: ImmutableArray<HtmlComponentAttribute>,
        typedExpressionTargets: ImmutableArray<HtmlTypedExpressionTarget>,
        sourceMaps: ImmutableArray<MacroExpansionSourceMap>
    ) {
        ExpressionText = expressionText
        ErrorMessage = errorMessage
        ErrorPosition = errorPosition
        EmbeddedExpressionSpans = embeddedExpressionSpans
        Components = components
        ComponentAttributes = componentAttributes
        TypedExpressionTargets = typedExpressionTargets
        SourceMaps = sourceMaps
    }

    func GetExpressionTargetType(span: TextSpan) -> ITypeSymbol? {
        for target in TypedExpressionTargets {
            if target.Span == span {
                return target.TargetType
            }
        }

        null
    }
}

class HtmlComponentReference(
    val Name: string,
    val SymbolSpan: TextSpan
)

class HtmlComponentAttribute(
    val ComponentName: string,
    val AttributeName: string,
    val NameSpan: TextSpan
)

class HtmlTypedExpressionTarget(
    val Span: TextSpan,
    val TargetType: ITypeSymbol
)

class HtmlDslParser {
    private val _source: string
    private val _compilation: Compilation
    private val _context: MacroContext
    private val _cssScope: string?
    private val _builderName: string
    private val _builder = StringBuilder()
    private var _embeddedExpressionSpans: ImmutableArray<TextSpan> = []
    private var _components: ImmutableArray<HtmlComponentReference> = []
    private var _componentAttributes: ImmutableArray<HtmlComponentAttribute> = []
    private var _typedExpressionTargets: ImmutableArray<HtmlTypedExpressionTarget> = []
    private var _sourceMaps: ImmutableArray<MacroExpansionSourceMap> = []
    private var _lastEmbeddedExpressionSpan = TextSpan(0, 0)
    private var _position: int = 0
    private var _sequence: int = 0
    private var _errorMessage: string? = null
    private var _errorPosition: int = 0

    init(
        source: string,
        compilation: Compilation,
        context: MacroContext,
        cssScope: string? = null
    ) {
        _source = source
        _compilation = compilation
        _context = context
        _cssScope = cssScope
        _builderName = context.CreateUniqueName("htmlBuilder")
    }

    func Parse() -> HtmlDslExpansion {
        _builder.Append("(${_builderName}: Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder) => {")
        SkipWhitespace()
        ParseElement()
        SkipWhitespace()

        if _errorMessage is null && !IsEnd() {
            Error("Expected a single root HTML element.")
        }

        _builder.Append("}")
        HtmlDslExpansion(
            _builder.ToString(),
            _errorMessage,
            _errorPosition,
            _embeddedExpressionSpans,
            _components,
            _componentAttributes,
            _typedExpressionTargets,
            _sourceMaps)
    }

    private func ParseElement() {
        if !Consume("<") {
            Error("Expected '<' to start an HTML element.")
            return
        }

        let nameStart = _position
        let name = ReadName()
        if name.Length == 0 {
            Error("Expected an HTML element name.")
            return
        }
        if name.StartsWith(".") || name.EndsWith(".") || name.Contains("..") {
            ErrorAt(nameStart, "Qualified element names cannot contain empty segments.")
            return
        }

        let isComponent = IsComponentName(name)
        if isComponent {
            let symbolNameStart = nameStart + name.LastIndexOf(".") + 1
            _components = _components.Add(
                HtmlComponentReference(
                    name,
                    TextSpan(symbolNameStart, name.Length - (symbolNameStart - nameStart))))
            AppendOpenComponent(name)
        } else {
            AppendCall("OpenElement", "\"${Escape(name)}\"")
            if let cssScope: string = _cssScope {
                AppendAttribute(cssScope, "\"\"")
            }
        }
        SkipWhitespace()

        while _errorMessage is null && !IsEnd() && !At(">") && !At("/>") {
            let attributeStart = _position
            let attributeName = ReadName()
            if attributeName.Length == 0 {
                Error("Expected an attribute name or '>'.")
                return
            }
            if isComponent && !IsKeyAttribute(attributeName) {
                _componentAttributes = _componentAttributes.Add(
                    HtmlComponentAttribute(
                        name,
                        attributeName,
                        TextSpan(attributeStart, attributeName.Length)))
            }

            SkipWhitespace()
            if !Consume("=") {
                Error("Expected '=' after attribute '${attributeName}'.")
                return
            }
            SkipWhitespace()

            if At("\"") {
                let value = ReadQuotedValue()
                AppendAttributeOrKey(attributeName, "\"${Escape(value)}\"")
            } else if At("{") {
                let expression = ReadEmbeddedExpression()
                let generatedStart = _builder.Length
                if IsKeyAttribute(attributeName) {
                    AppendKey(expression)
                } else if !isComponent && IsEventAttribute(attributeName) {
                    AppendAttribute(
                        NormalizeEventName(attributeName),
                        "Microsoft.AspNetCore.Components.EventCallback.Factory.Create(" +
                        "self, () => { ${expression}() })")
                } else if isComponent {
                    AppendComponentAttribute(name, attributeName, expression)
                } else {
                    AppendAttribute(attributeName, expression)
                }
                RecordExpressionSourceMap(expression, generatedStart)
            } else {
                Error("Expected a quoted value or Raven expression for attribute '${attributeName}'.")
                return
            }

            SkipWhitespace()
        }

        if Consume("/>") {
            AppendClose(isComponent)
            return
        }

        if !Consume(">") {
            Error("Expected '>' after element '${name}'.")
            return
        }

        if isComponent {
            Error("Component '${name}' must use a self-closing tag in this prototype.")
            return
        }

        while _errorMessage is null && !IsEnd() {
            if At("</") {
                Consume("</")
                let closingName = ReadName()
                SkipWhitespace()
                if !Consume(">") {
                    Error("Expected '>' after closing element '${closingName}'.")
                    return
                }
                if closingName != name {
                    Error("Closing element '${closingName}' does not match '${name}'.")
                    return
                }
                AppendClose(isComponent)
                return
            }

            if At("<") {
                ParseElement()
            } else if At("{") {
                let expression = ReadEmbeddedExpression()
                let generatedStart = _builder.Length
                AppendContent(expression)
                RecordExpressionSourceMap(expression, generatedStart)
            } else {
                let text = ReadText()
                let normalized = NormalizeText(text)
                if normalized.Length > 0 {
                    AppendCall("AddContent", "\"${Escape(normalized)}\"")
                }
            }
        }

        if _errorMessage is null {
            Error("Element '${name}' is missing a closing tag.")
        }
    }

    private func AppendAttribute(name: string, value: string) {
        AppendCall("AddAttribute", "\"${Escape(name)}\", ${value}")
    }

    private func AppendComponentAttribute(
        componentName: string,
        attributeName: string,
        expression: string
    ) {
        if expression.Length == 0 {
            return
        }

        let delegateType: INamedTypeSymbol = GetEventCallbackDelegateType(
            componentName,
            attributeName) else {
            AppendAttribute(attributeName, expression)
            return
        }

        _typedExpressionTargets = _typedExpressionTargets.Add(
            HtmlTypedExpressionTarget(_lastEmbeddedExpressionSpan, delegateType))

        if delegateType.TypeArguments.Length == 0 {
            AppendEventCallbackAttribute(attributeName, expression)
        } else {
            AppendGenericEventCallbackAttribute(
                attributeName,
                expression,
                delegateType.TypeArguments[0].ToDisplayString())
        }
    }

    private func AppendEventCallbackAttribute(name: string, expression: string) {
        let callbackName = _context.CreateUniqueName("htmlCallback")
        _ = _builder.Append("let ${callbackName}: System.Action = ${expression};")
        AppendAttribute(
            name,
            "Microsoft.AspNetCore.Components.EventCallback.Factory.Create(self, ${callbackName})")
    }

    private func AppendGenericEventCallbackAttribute(
        name: string,
        expression: string,
        argumentType: string
    ) {
        let callbackName = _context.CreateUniqueName("htmlCallback")
        _ = _builder.Append(
            "let ${callbackName}: System.Action<${argumentType}> = ${expression};")
        AppendAttribute(
            name,
            "Microsoft.AspNetCore.Components.EventCallback.Factory.Create<${argumentType}>(" +
            "self, ${callbackName})")
    }

    private func AppendAttributeOrKey(name: string, value: string) {
        if IsKeyAttribute(name) {
            AppendKey(value)
        } else {
            AppendAttribute(name, value)
        }
    }

    private func AppendKey(value: string) {
        _ = _builder.Append("${_builderName}.SetKey(${value});")
    }

    private func AppendContent(expression: string) {
        let sequence = _sequence
        _sequence = _sequence + 1
        _ = _builder.Append("HtmlBlazorMacros.HtmlContent.Add(${_builderName}, ${sequence}, (${expression}));")
    }

    private func AppendOpenComponent(name: string) {
        let sequence = _sequence
        _sequence = _sequence + 1
        _ = _builder.Append("${_builderName}.OpenComponent<${name}>(${sequence});")
    }

    private func AppendClose(isComponent: bool) {
        if isComponent {
            AppendCall("CloseComponent", null)
        } else {
            AppendCall("CloseElement", null)
        }
    }

    private func AppendCall(methodName: string, arguments: string?) {
        if arguments is null {
            _ = _builder.Append("${_builderName}.${methodName}();")
        } else {
            let sequence = _sequence
            _sequence = _sequence + 1
            _ = _builder.Append("${_builderName}.${methodName}(${sequence}, ${arguments});")
        }
    }

    private func ReadName() -> string {
        let start = _position
        while !IsEnd() && IsNameCharacter(Current()) {
            _position = _position + 1
        }
        _source.Substring(start, _position - start)
    }

    private func ReadQuotedValue() -> string {
        Consume("\"")
        let start = _position
        while !IsEnd() && !At("\"") {
            _position = _position + 1
        }
        let value = _source.Substring(start, _position - start)
        if !Consume("\"") {
            Error("Unterminated quoted attribute value.")
        }
        value
    }

    private func ReadEmbeddedExpression() -> string {
        let openingPosition = _position
        Consume("{")
        let start = _position
        var depth = 1
        var inString = false

        while !IsEnd() {
            let current = Current()
            if current == "\"" {
                inString = inString == false
                _position = _position + 1
            } else if !inString && current == "{" {
                depth = depth + 1
                _position = _position + 1
            } else if !inString && current == "}" {
                depth = depth - 1
                if depth == 0 {
                    let untrimmedExpression = _source.Substring(start, _position - start)
                    let expression = untrimmedExpression.Trim()
                    let leadingWhitespace = untrimmedExpression.Length - untrimmedExpression.TrimStart().Length
                    let expressionSpan = TextSpan(start + leadingWhitespace, expression.Length)
                    _position = _position + 1
                    if expression.Length == 0 {
                        ErrorAt(openingPosition, "Embedded Raven expressions cannot be empty.")
                    } else {
                        _lastEmbeddedExpressionSpan = expressionSpan
                        _embeddedExpressionSpans = _embeddedExpressionSpans.Add(expressionSpan)
                    }
                    return expression
                }
                _position = _position + 1
            } else {
                _position = _position + 1
            }
        }

        ErrorAt(openingPosition, "Unterminated embedded Raven expression.")
        ""
    }

    private func RecordExpressionSourceMap(expression: string, generatedStart: int) {
        if expression.Length == 0 || _builder.Length <= generatedStart {
            return
        }

        let generatedText = _builder.ToString(
            generatedStart,
            _builder.Length - generatedStart)
        let expressionStart = generatedText.IndexOf(expression, StringComparison.Ordinal)
        if expressionStart < 0 {
            return
        }

        _sourceMaps = _sourceMaps.Add(
            MacroExpansionSourceMap(
                TextSpan(generatedStart + expressionStart, expression.Length),
                _lastEmbeddedExpressionSpan))
    }

    private func ReadText() -> string {
        let start = _position
        while !IsEnd() && !At("<") && !At("{") {
            _position = _position + 1
        }
        _source.Substring(start, _position - start)
    }

    private static func NormalizeText(text: string) -> string {
        let result = StringBuilder()
        var pendingWhitespace = false

        for character in text {
            if Char.IsWhiteSpace(character) {
                pendingWhitespace = true
            } else {
                if pendingWhitespace && result.Length > 0 {
                    result.Append(" ")
                }
                result.Append(character)
                pendingWhitespace = false
            }
        }

        if pendingWhitespace && result.Length > 0 {
            result.Append(" ")
        }
        result.ToString()
    }

    private static func IsNameCharacter(value: string) -> bool {
        value.Length == 1 && (
            Char.IsLetterOrDigit(value[0])
            || value == "-"
            || value == "_"
            || value == ":"
            || value == ".")
    }

    private static func IsEventAttribute(name: string) -> bool {
        name.StartsWith("on", StringComparison.OrdinalIgnoreCase)
    }

    private static func IsKeyAttribute(name: string) -> bool {
        name.Equals("key", StringComparison.OrdinalIgnoreCase)
    }

    private static func IsComponentName(name: string) -> bool {
        let separator = name.LastIndexOf(".")
        let typeNameStart = separator + 1
        typeNameStart < name.Length && Char.IsUpper(name[typeNameStart])
    }

    private func GetEventCallbackDelegateType(
        componentName: string,
        attributeName: string
    ) -> INamedTypeSymbol? {
        let eventCallbackType: INamedTypeSymbol = _compilation.GetTypeByMetadataName(
            "Microsoft.AspNetCore.Components.EventCallback") else {
            return null
        }
        let genericEventCallbackType: INamedTypeSymbol = _compilation.GetTypeByMetadataName(
            "Microsoft.AspNetCore.Components.EventCallback`1") else {
            return null
        }
        let actionType: INamedTypeSymbol = _compilation.GetTypeByMetadataName(
            "System.Action") else {
            return null
        }
        let genericActionType: INamedTypeSymbol = _compilation.GetTypeByMetadataName(
            "System.Action`1") else {
            return null
        }
        let componentType: INamedTypeSymbol = _compilation.GetTypeByMetadataName(componentName) else {
            return null
        }

        for member in componentType.GetMembers(attributeName) {
            if member is IPropertySymbol property {
                if SymbolEqualityComparer.Default.Equals(property.Type, eventCallbackType) {
                    return actionType
                }

                if property.Type is INamedTypeSymbol propertyType
                    && SymbolEqualityComparer.Default.Equals(
                        propertyType.OriginalDefinition,
                        genericEventCallbackType) {
                    return genericActionType.Construct(propertyType.TypeArguments[0]) as INamedTypeSymbol
                }
            }
        }

        null
    }

    private static func NormalizeEventName(name: string) -> string {
        name.ToLowerInvariant()
    }

    private static func Escape(value: string) -> string {
        value
            .Replace("\\", "\\\\")
            .Replace("\"", "\\\"")
            .Replace("\r", "\\r")
            .Replace("\n", "\\n")
    }

    private func Current() -> string {
        if IsEnd() {
            return ""
        }
        _source.Substring(_position, 1)
    }

    private func SkipWhitespace() {
        while !IsEnd() && Char.IsWhiteSpace(_source[_position]) {
            _position = _position + 1
        }
    }

    private func At(value: string) -> bool {
        _position + value.Length <= _source.Length
            && _source.Substring(_position, value.Length) == value
    }

    private func Consume(value: string) -> bool {
        if !At(value) {
            return false
        }
        _position = _position + value.Length
        true
    }

    private func IsEnd() -> bool {
        _position >= _source.Length
    }

    private func Error(message: string) {
        ErrorAt(_position, message)
    }

    private func ErrorAt(position: int, message: string) {
        if _errorMessage is null {
            _errorPosition = position
            _errorMessage = message
        }
    }
}
