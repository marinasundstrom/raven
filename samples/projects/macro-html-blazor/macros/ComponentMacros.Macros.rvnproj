<Project Sdk="Raven.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>ComponentMacros.Macros</AssemblyName>
    <OutputType>Library</OutputType>
    <PackageId>Raven.Blazor.Macros</PackageId>
    <Title>Raven Blazor Macros</Title>
    <Description>Experimental component and markup macros for authoring Blazor components in Raven.</Description>
    <PackageTags>raven;blazor;macros;components;markup;dsl</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components" Version="10.0.0" />
    <Reference Include="Raven.CodeAnalysis">
      <HintPath>../../../../src/Raven.CodeAnalysis/bin/Debug/net10.0/Raven.CodeAnalysis.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
