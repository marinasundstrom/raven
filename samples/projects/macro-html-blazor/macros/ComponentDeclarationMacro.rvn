import System.Text.*
import System.Collections.Immutable.*
import Raven.CodeAnalysis.Macros.*
import Raven.CodeAnalysis.Syntax.*
import Raven.CodeAnalysis.Syntax.SyntaxFactory.*
import Raven.CodeAnalysis.Text.*

[assembly: RavenCompilerPlugin(typeof(ComponentDeclarationMacro))]

class ComponentDeclarationMacro : IMacroDefinition {
    val Name: string => "FunctionComponent"
    val Alias: string? => "component"

    func Expand(
        declaration: FreestandingMacroDeclarationSyntax,
        body: IMacroTokenStream,
        context: TokenTreeMacroContext
    ) -> MemberDeclarationSyntax {
        // Reading the stream establishes that the declaration requires a body;
        // GetBodyText preserves its trivia for the generated Render method.
        body.PeekToken()

        let source = StringBuilder()
        source.Append("public class ")
        source.Append(declaration.Identifier.ValueText)
        source.Append(" : Microsoft.AspNetCore.Components.ComponentBase {")

        if let parameters: ParameterListSyntax = declaration.ParameterList {
            for parameter in parameters.Parameters {
                let typeAnnotation: TypeAnnotationClauseSyntax = parameter.TypeAnnotation else {
                    continue
                }
                source.Append("[Microsoft.AspNetCore.Components.Parameter] var ")
                source.Append(parameter.Identifier.ValueText)
                source.Append(typeAnnotation.ToString())
                if let defaultValue: EqualsValueClauseSyntax = parameter.DefaultValue {
                    source.Append(defaultValue.ToString())
                }
                source.Append(";")
            }
        }

        let bodyText = context.GetBodyText()
        let probePrefix = "class __ComponentProbe { func Render() {"
        let probeTree = ParseSyntaxTree(probePrefix + bodyText + "} }")
        let probeClass: ClassDeclarationSyntax = probeTree.GetRoot().Members[0] else {
            return declaration
        }
        let probeMethod: MethodDeclarationSyntax = probeClass.Members[0] else {
            return declaration
        }
        let probeBody: BlockStatementSyntax = probeMethod.Body else {
            return declaration
        }

        var returnOffset = -1
        if probeBody.Statements.Count > 0
            && probeBody.Statements[probeBody.Statements.Count - 1] is ExpressionStatementSyntax expressionStatement {
            returnOffset = expressionStatement.Span.Start - probePrefix.Length
        }

        var renderBody = bodyText
        if returnOffset >= 0 {
            renderBody = bodyText.Insert(returnOffset, "return ")
        }
        source.Append("func Render() -> Microsoft.AspNetCore.Components.RenderFragment {")
        let expandedBodyStart = source.Length
        source.Append(renderBody)
        source.Append("}")
        source.Append(
            "protected override func BuildRenderTree(" +
            "builder: Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder) {" +
            "Render()(builder)" +
            "}")
        source.Append("}")

        let tree = ParseSyntaxTree(source.ToString())
        let component = tree.GetRoot().Members[0]

        var sourceMaps: ImmutableArray<MacroExpansionSourceMap> = []
        if returnOffset > 0 {
            sourceMaps = sourceMaps.Add(MacroExpansionSourceMap(
                TextSpan(expandedBodyStart, returnOffset),
                TextSpan(0, returnOffset)))
        }
        if returnOffset >= 0 {
            sourceMaps = sourceMaps.Add(MacroExpansionSourceMap(
                TextSpan(
                    expandedBodyStart + returnOffset + "return ".Length,
                    bodyText.Length - returnOffset),
                TextSpan(returnOffset, bodyText.Length - returnOffset)))
        } else {
            sourceMaps = sourceMaps.Add(MacroExpansionSourceMap(
                TextSpan(expandedBodyStart, bodyText.Length),
                TextSpan(0, bodyText.Length)))
        }

        context.WithOrigins(component, sourceMaps)
    }
}
