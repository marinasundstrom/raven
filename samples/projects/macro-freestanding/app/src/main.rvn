import System.Console.*

func Main() -> unit {
    let answer = #add(20, Right: 22)
    let shouldRetry = #guard {
        unless answer == 42
    }
    let verdict = #choose {
        test answer == 42
        then "correct"
        otherwise "wrong"
    }

    WriteLine(answer)
    WriteLine(shouldRetry)
    WriteLine(verdict)
}
