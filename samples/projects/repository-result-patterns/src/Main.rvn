func Main() {
    let repository = ItemRepository()

    let Ok(idToLookFor) = ItemId.Create(42) else {
        Console.WriteLine("Invalid Id")
        return
    }

    let result = repository.GetById(idToLookFor)

    match result {
        Ok(let item) => Console.WriteLine("${item.Id} ${item.Name}")
        Error(RepositoryError.NotFound) => Console.WriteLine("Not found")
        Error(let error) => Console.WriteLine("$error")
    }
}
