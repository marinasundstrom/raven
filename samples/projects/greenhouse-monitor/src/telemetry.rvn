namespace Utilities

import System.*
import System.Collections.Generic.*
import System.Device.I2c.*
import System.Runtime.CompilerServices.*
import System.Threading.*
import System.Threading.Tasks.*

interface ITelemetrySource {
    func Poll(cancellationToken: CancellationToken) -> IAsyncEnumerable<Result<SensorReading[], TelemetryError>>
}

class SimulatedTelemetrySource : ITelemetrySource {
    async func Poll(
        [EnumeratorCancellation] cancellationToken: CancellationToken
    ) -> IAsyncEnumerable<Result<SensorReading[], TelemetryError>> {
        yield ValidateSnapshot([
            SensorReading("Propagation", 23.5, 68.0, 720),
            SensorReading("Tomatoes", 26.0, 64.0, 910),
            SensorReading("Herbs", 21.0, 52.0, 760)
        ])

        await Task.Delay(150, cancellationToken)

        yield ValidateSnapshot([
            SensorReading("Propagation", 24.0, 67.0, 740),
            SensorReading("Tomatoes", 30.5, 64.0, 930),
            SensorReading("Herbs", 21.5, 48.0, 810)
        ])

        await Task.Delay(150, cancellationToken)

        yield ValidateSnapshot([
            SensorReading("Propagation", 24.5, 66.0, 780),
            SensorReading("Tomatoes", 31.0, 63.0, 960),
            SensorReading("Herbs", 22.0, 42.0, 1510)
        ])
    }
}

class Scd4xTelemetrySource : ITelemetrySource {
    async func Poll(
        [EnumeratorCancellation] cancellationToken: CancellationToken
    ) -> IAsyncEnumerable<Result<SensorReading[], TelemetryError>> {
        while !cancellationToken.IsCancellationRequested {
            yield ReadScd4xSnapshot(GetScd4xZone(), 1, cancellationToken)
            await Task.Delay(1000, cancellationToken)
        }
    }
}

func GetScd4xZone() -> string {
    let zone = Environment.GetEnvironmentVariable("GREENHOUSE_ZONE")
    if let configuredZone: string = zone {
        if configuredZone.Trim().Length > 0 {
            return configuredZone.Trim()
        }
    }

    return "Raspberry Pi"
}

func ReadScd4xSnapshot(
    zone: string,
    i2cBusId: int,
    cancellationToken: CancellationToken
) -> Result<SensorReading[], TelemetryError> {
    try {
        cancellationToken.ThrowIfCancellationRequested()

        let settings = I2cConnectionSettings(i2cBusId, 0x62)
        use device = I2cDevice.Create(settings)
        let measurement = ReadScd4xMeasurement(device, cancellationToken)
        let reading = SensorReading(
            zone,
            measurement.TemperatureCelsius,
            measurement.HumidityPercent,
            measurement.CarbonDioxidePpm
        )

        return ValidateSnapshot([reading])
    } catch (OperationCanceledException) {
        throw
    } catch (Exception ex) {
        let error: TelemetryError = .SensorUnavailable(ex.Message)
        return Error(error)
    }
}

func ReadScd4xMeasurement(
    device: I2cDevice,
    cancellationToken: CancellationToken
) -> Scd4xMeasurement {
    device.Write([(byte)0x3F, (byte)0x86])
    Task.Delay(500, cancellationToken).GetAwaiter().GetResult()
    device.Write([(byte)0x36, (byte)0x46])
    Task.Delay(20, cancellationToken).GetAwaiter().GetResult()
    device.Write([(byte)0x21, (byte)0xB1])

    try {
        WaitForScd4xMeasurement(device, cancellationToken)
        device.Write([(byte)0xEC, (byte)0x05])
        Task.Delay(2, cancellationToken).GetAwaiter().GetResult()

        let response: byte[] = [(byte)0, (byte)0, (byte)0, (byte)0, (byte)0, (byte)0, (byte)0, (byte)0, (byte)0]
        device.Read(response)

        if !HasValidScd4xWord(response, 0) ||
           !HasValidScd4xWord(response, 3) ||
           !HasValidScd4xWord(response, 6) {
            throw InvalidOperationException("sensor measurement failed its CRC check")
        }

        let carbonDioxidePpm = ReadScd4xWord(response, 0)
        let rawTemperature = ReadScd4xWord(response, 3)
        let rawHumidity = ReadScd4xWord(response, 6)
        let temperatureCelsius = -45.0 + 175.0 * rawTemperature / 65535.0
        let humidityPercent = 100.0 * rawHumidity / 65535.0

        return Scd4xMeasurement(carbonDioxidePpm, temperatureCelsius, humidityPercent)
    } finally {
        device.Write([(byte)0x3F, (byte)0x86])
        Task.Delay(500).GetAwaiter().GetResult()
    }
}

func WaitForScd4xMeasurement(device: I2cDevice, cancellationToken: CancellationToken) {
    var attempts = 0

    while attempts < 60 {
        cancellationToken.ThrowIfCancellationRequested()
        Task.Delay(100, cancellationToken).GetAwaiter().GetResult()
        device.Write([(byte)0xE4, (byte)0xB8])
        Task.Delay(1, cancellationToken).GetAwaiter().GetResult()

        let response: byte[] = [(byte)0, (byte)0, (byte)0]
        device.Read(response)
        if HasValidScd4xWord(response, 0) && (ReadScd4xWord(response, 0) & 0x7FF) != 0 {
            return
        }

        attempts = attempts + 1
    }

    throw InvalidOperationException("SCD4x did not produce a measurement within six seconds")
}

func ReadScd4xWord(data: byte[], offset: int) -> int {
    return (Convert.ToInt32(data[offset]) << 8) | Convert.ToInt32(data[offset + 1])
}

func HasValidScd4xWord(data: byte[], offset: int) -> bool {
    var crc = 0xFF

    for index in offset ..< offset + 2 {
        crc = crc ^ Convert.ToInt32(data[index])

        for _ in 0 ..< 8 {
            crc = if (crc & 0x80) != 0 {
                ((crc << 1) ^ 0x31) & 0xFF
            } else {
                (crc << 1) & 0xFF
            }
        }
    }

    return crc == Convert.ToInt32(data[offset + 2])
}

record Scd4xMeasurement(
    CarbonDioxidePpm: int,
    TemperatureCelsius: double,
    HumidityPercent: double
)

func ValidateSnapshot(received: SensorReading[]) -> Result<SensorReading[], TelemetryError> {
    if received.Length == 0 {
        let error: TelemetryError = .NoReadings
        return Error(error)
    }

    let validated = List<SensorReading>()
    for reading in received {
        validated.Add(ValidateReading(reading)?)
    }

    return Ok(validated.ToArray())
}

func ValidateReading(reading: SensorReading) -> Result<SensorReading, TelemetryError> {
    if reading.Zone.Trim().Length == 0 {
        let error: TelemetryError = .InvalidReading("unknown", "zone name is required")
        return Error(error)
    }

    if 0.0 > reading.HumidityPercent || reading.HumidityPercent > 100.0 {
        let error: TelemetryError = .InvalidReading(reading.Zone, "humidity must be between 0 and 100 percent")
        return Error(error)
    }

    if 0 > reading.CarbonDioxidePpm {
        let error: TelemetryError = .InvalidReading(reading.Zone, "CO2 cannot be negative")
        return Error(error)
    }

    return Ok(reading)
}
