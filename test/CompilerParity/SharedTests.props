<Project>
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="xunit" Version="2.4.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.4.0" />
    <PackageReference Include="Shouldly" Version="3.0.2" />
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
    <Compile Include="$(MSBuildThisFileDirectory)../Raven.CodeAnalysis.Tests/Syntax/TextSpanTests.cs" Link="TextSpanTests.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../Raven.CodeAnalysis.Tests/Text/LinePositionTests.cs" Link="LinePositionTests.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../Raven.CodeAnalysis.Tests/Text/TextCoordinateContractTests.cs" Link="TextCoordinateContractTests.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)ImplementationIdentityTests.cs" Link="ImplementationIdentityTests.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../Raven.CodeAnalysis.Tests/Text/TextUtilsTests.cs" Link="TextUtilsTests.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../Raven.CodeAnalysis.Tests/Text/TextValueRecordTests.cs" Link="TextValueRecordTests.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../Raven.CodeAnalysis.Tests/Text/SourceTextTests.cs" Link="SourceTextTests.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../Raven.CodeAnalysis.Tests/Text/SourceTextIOTests.cs" Link="SourceTextIOTests.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../Raven.CodeAnalysis.Tests/Text/AnsiExtensionsTests.cs" Link="AnsiExtensionsTests.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../Raven.CodeAnalysis.Tests/Syntax/Parser/SeekableTextSourceTests.cs" Link="SeekableTextSourceTests.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../Raven.CodeAnalysis.Tests/Syntax/Parser/TokenValueTests.cs" Link="TokenValueTests.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../Raven.CodeAnalysis.Tests/Diagnostics/DiagnosticPrimitiveTests.cs" Link="DiagnosticPrimitiveTests.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../Raven.CodeAnalysis.Tests/Diagnostics/LocalizableStringTests.cs" Link="LocalizableStringTests.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../Raven.CodeAnalysis.Tests/Diagnostics/CompilerDiagnosticCatalogTests.cs" Link="CompilerDiagnosticCatalogTests.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../Raven.CodeAnalysis.Tests/Syntax/StringLiteralDecodingTests.cs" Link="StringLiteralDecodingTests.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../Raven.CodeAnalysis.Tests/Syntax/SyntaxFactsTests.cs" Link="SyntaxFactsTests.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../Raven.CodeAnalysis.Tests/Syntax/Parser/ConditionalDirectiveParserTests.cs" Link="ConditionalDirectiveParserTests.cs" />
  </ItemGroup>
</Project>
