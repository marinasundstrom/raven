<Project>
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)../../src/Raven.CodeAnalysis/Raven.CodeAnalysis.csproj" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="xunit" Version="2.4.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.4.0" />
    <Using Include="Xunit" />
    <None Include="$(MSBuildThisFileDirectory)../../src/Raven.CodeAnalysis/Syntax/Model.xml" Link="Model.xml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(MSBuildThisFileDirectory)../../src/Raven.CodeAnalysis/Syntax/Tokens.xml" Link="Tokens.xml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(MSBuildThisFileDirectory)../../src/Raven.CodeAnalysis/Syntax/NodeKinds.xml" Link="NodeKinds.xml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(MSBuildThisFileDirectory)../../src/Raven.CodeAnalysis/Syntax/Factories.xml" Link="Factories.xml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(MSBuildThisFileDirectory)Fixtures/RedOutputRuntime.rvn" Link="RedOutputRuntime.rvn" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(MSBuildThisFileDirectory)Fixtures/GreenOutputRuntime.rvn" Link="GreenOutputRuntime.rvn" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="$(MSBuildThisFileDirectory)RavenRedOutputTests.cs" Link="RavenRedOutputTests.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)RavenGreenOutputTests.cs" Link="RavenGreenOutputTests.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)SyntaxModelLoaderTests.cs" Link="SyntaxModelLoaderTests.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)RedNodeGeneratorTests.cs" Link="RedNodeGeneratorTests.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)GreenNodeGeneratorTests.cs" Link="GreenNodeGeneratorTests.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)VisitorGeneratorTests.cs" Link="VisitorGeneratorTests.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)NodeEmitterTests.cs" Link="NodeEmitterTests.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)NodeModelTests.cs" Link="NodeModelTests.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)NodeSerializationTests.cs" Link="NodeSerializationTests.cs" />
  </ItemGroup>
</Project>
