// Output-contract fixture; production syntax runtime is ported separately.
import System.*
import System.Collections.Generic.*
import System.Linq.*
namespace Raven.CodeAnalysis.Syntax {
    enum SyntaxKind { None, Token, Sample, Alternate }
    internal class SyntaxAnnotation { }
    internal open class SyntaxNode {
        val Position: int
        init(position: int) { Position = position }
    }
    internal class SampleSyntax : SyntaxNode {
        val Green: InternalSyntax.SampleSyntax
        val Parent: SyntaxNode?
        init(green: InternalSyntax.SampleSyntax, parent: SyntaxNode?, position: int) : base(position) {
            Green = green
            Parent = parent
        }
    }
}
namespace Raven.CodeAnalysis.Syntax.InternalSyntax {
    internal class DiagnosticInfo { }
    internal open class GreenNode {
        internal field _diagnostics: DiagnosticInfo[]?
        internal field _annotations: Raven.CodeAnalysis.Syntax.SyntaxAnnotation[]?
        val Kind: Raven.CodeAnalysis.Syntax.SyntaxKind
        val SlotCount: int
        init(kind: Raven.CodeAnalysis.Syntax.SyntaxKind, count: int, diagnostics: IEnumerable<DiagnosticInfo>? = null, annotations: IEnumerable<Raven.CodeAnalysis.Syntax.SyntaxAnnotation>? = null) {
            Kind = kind
            SlotCount = count
            _diagnostics = diagnostics?.ToArray()
            _annotations = annotations?.ToArray()
        }
        virtual val FullWidth: int {
            get {
                var width = 0
                var index = 0
                while index < SlotCount { width += GetSlot(index)?.FullWidth ?? 0; index += 1 }
                return width
            }
        }
        func GetChildStartPosition(index: int) -> int {
            var position = 0
            var slot = 0
            while slot < index { position += GetSlot(slot)?.FullWidth ?? 0; slot += 1 }
            return position
        }
        virtual func GetSlot(index: int) -> GreenNode? { throw InvalidOperationException() }
        func GetSlot<T>(index: int) -> T where T: GreenNode? { return (T)GetSlot(index) }
        internal virtual func Accept(visitor: SyntaxVisitor) { throw InvalidOperationException() }
        internal virtual func Accept<T>(visitor: SyntaxVisitor<T>) -> T { throw InvalidOperationException() }
        virtual func CreateRed(parent: Raven.CodeAnalysis.Syntax.SyntaxNode?, position: int) -> Raven.CodeAnalysis.Syntax.SyntaxNode { throw InvalidOperationException() }
        internal virtual func With(children: GreenNode?[], diagnostics: DiagnosticInfo[]? = null, annotations: Raven.CodeAnalysis.Syntax.SyntaxAnnotation[]? = null) -> GreenNode { throw InvalidOperationException() }
        protected static func AreEqual<T>(a: T[]?, b: T[]?) -> bool {
            if ReferenceEquals(a, b) { return true }
            if a is null || b is null { return false }
            return a!.SequenceEqual(b!)
        }
    }
    internal abstract class SyntaxNode : GreenNode {
        private field _slots: GreenNode?[]
        init(kind: Raven.CodeAnalysis.Syntax.SyntaxKind, slots: GreenNode?[], diagnostics: IEnumerable<DiagnosticInfo>? = null, annotations: IEnumerable<Raven.CodeAnalysis.Syntax.SyntaxAnnotation>? = null) : base(kind, slots.Length, diagnostics, annotations) { _slots = slots }
        override func GetSlot(index: int) -> GreenNode? => _slots[index]
    }
    internal class SyntaxToken : GreenNode {
        override val FullWidth: int => 2
        init(kind: Raven.CodeAnalysis.Syntax.SyntaxKind) : base(kind, 0) { }
    }
    internal class SyntaxList : GreenNode {
        override func GetSlot(index: int) -> GreenNode? => Items[index]
        val Items: SyntaxNode[]
        init(items: SyntaxNode[]) : base(Raven.CodeAnalysis.Syntax.SyntaxKind.None, items.Length) { Items = items }
    }
    internal abstract partial class SyntaxVisitor {
        virtual func DefaultVisit(node: SyntaxNode) { }
    }
    internal abstract partial class SyntaxVisitor<TResult> {
        virtual func DefaultVisit(node: SyntaxNode) -> TResult { throw InvalidOperationException("default visitor") }
    }
    internal abstract partial class SyntaxRewriter : SyntaxVisitor<SyntaxNode?> {
        virtual func Visit(node: SyntaxNode?) -> SyntaxNode? {
            if node is null { return null }
            return node!.Accept<SyntaxNode?>(self)
        }
        override func DefaultVisit(node: SyntaxNode) -> SyntaxNode? => node
        virtual func VisitToken(token: SyntaxToken) -> SyntaxToken => token
        virtual func VisitList(list: SyntaxList) -> SyntaxList? {
            let items = List<SyntaxNode>()
            var changed = false
            for item in list.Items {
                let visited = Visit(item)
                if !ReferenceEquals(item, visited) { changed = true }
                if visited is not null { items.Add(visited!) }
            }
            return if changed { SyntaxList(items.ToArray()) } else { list }
        }
    }
    internal class IdentityRewriter : SyntaxRewriter {
        override func DefaultVisit(node: SyntaxNode) -> SyntaxNode? => null
    }
    internal class DropLeafRewriter : SyntaxRewriter {
        override func VisitSample(node: SampleSyntax) -> SyntaxNode? {
            if node.Child is null { return null }
            return base.VisitSample(node)
        }
    }
    internal class TokenRewriter : SyntaxRewriter {
        private val _token: SyntaxToken
        init(token: SyntaxToken) { _token = token }
        override func VisitToken(token: SyntaxToken) -> SyntaxToken => _token
    }
    internal class RecordingVisitor : SyntaxVisitor {
        var Last: SyntaxNode? { get; set; } = null
        var Samples: int { get; set; } = 0
        override func DefaultVisit(node: SyntaxNode) { Last = node }
        override func VisitSample(node: SampleSyntax) { Samples += 1; Last = node }
    }
    internal class ResultVisitor : SyntaxVisitor<int> {
        override func DefaultVisit(node: SyntaxNode) -> int => -1
        override func VisitSample(node: SampleSyntax) -> int => 42
    }
    internal class DefaultResultVisitor : SyntaxVisitor<int> {
        override func DefaultVisit(node: SyntaxNode) -> int => 7
    }
    internal class UnknownSyntax : ExpressionSyntax {
        init(token: SyntaxToken) : base(Raven.CodeAnalysis.Syntax.SyntaxKind.Sample, [token]) { }
        override val Keyword: SyntaxToken => GetSlot<SyntaxToken>(0)
    }
    public static class Probe {
        static func Run() -> int {
            let kind = Raven.CodeAnalysis.Syntax.SyntaxKind.Sample
            let token = SyntaxToken(Raven.CodeAnalysis.Syntax.SyntaxKind.Token)
            let empty = SyntaxList([])
            let node = SyntaxFactory.Sample(kind, token, empty)
            if node.Kind != kind || node.SlotCount != 3 || !ReferenceEquals(node.Keyword, token) || node.Child is not null { throw InvalidOperationException("slots") }
            if !ReferenceEquals(node, node.Update(kind, token, null, empty)) { throw InvalidOperationException("update identity") }
            let changed = node.Update(Raven.CodeAnalysis.Syntax.SyntaxKind.Alternate, token, node, SyntaxList([node]))
            if ReferenceEquals(node, changed) || changed.Kind != Raven.CodeAnalysis.Syntax.SyntaxKind.Alternate || !ReferenceEquals(changed.Child, node) { throw InvalidOperationException("update change") }
            let diagnostics = [| DiagnosticInfo() |]
            let annotated = node.With([token, node, empty], diagnostics, null)
            if !ReferenceEquals(annotated, annotated.With([token, node, empty], diagnostics, null)) { throw InvalidOperationException("with identity") }
            let visitor = RecordingVisitor()
            node.Accept(visitor)
            if !ReferenceEquals(visitor.Last, node) { throw InvalidOperationException("visitor") }
            if node.CreateRed(null, 17).Position != 17 { throw InvalidOperationException("red") }
            visitor.VisitExpression(node)
            visitor.VisitPrimaryExpression(node)
            if visitor.Samples != 3 { throw InvalidOperationException("abstract visitor dispatch") }
            let unknown = UnknownSyntax(token)
            visitor.VisitExpression(unknown)
            if !ReferenceEquals(visitor.Last, unknown) || visitor.Samples != 3 { throw InvalidOperationException("visitor fallback") }
            if node.Accept<int>(DefaultResultVisitor()) != 7 { throw InvalidOperationException("concrete default visit") }
            let identity = IdentityRewriter()
            if !ReferenceEquals(identity.Visit(node), node) || !ReferenceEquals(identity.Visit(changed), changed) { throw InvalidOperationException("rewrite identity") }
            if !ReferenceEquals(identity.VisitExpression(unknown), unknown) || identity.Visit(null) is not null { throw InvalidOperationException("rewrite fallback") }
            let dropped = (SampleSyntax)DropLeafRewriter().Visit(changed)!
            if dropped.Child is not null || dropped.Items.Items.Length != 0 { throw InvalidOperationException("rewrite deletion") }
            let replacement = SyntaxToken(Raven.CodeAnalysis.Syntax.SyntaxKind.Alternate)
            let rewritten = (SampleSyntax)TokenRewriter(replacement).Visit(changed)!
            if ReferenceEquals(rewritten, changed) || rewritten.Kind != changed.Kind || !ReferenceEquals(rewritten.Keyword, replacement) { throw InvalidOperationException("rewrite token") }
            if ReferenceEquals(rewritten.Items, changed.Items) || !ReferenceEquals(((SampleSyntax)rewritten.Items.Items[0]).Keyword, replacement) { throw InvalidOperationException("rewrite list") }
            let rewrittenChild = (SampleSyntax)rewritten.Child!
            if !ReferenceEquals(rewrittenChild.Keyword, replacement) || rewrittenChild.Child is not null { throw InvalidOperationException("rewrite child") }
            let result = ResultVisitor()
            if result.VisitExpression(node) != 42 || result.VisitPrimaryExpression(node) != 42 || result.VisitExpression(unknown) != -1 { throw InvalidOperationException("generic dispatch") }
            return node.Accept<int>(result)
        }
    }
}
