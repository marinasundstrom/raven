<Project>
  <ItemGroup>
    <PackageReference Include="Raven.Core"
                      Version="[$(RavenSdkPackageVersion)]"
                      IsImplicitlyDefined="true" />
    <PackageReference Include="Raven.Macros"
                      Version="[$(RavenSdkPackageVersion)]"
                      IsImplicitlyDefined="true"
                      PrivateAssets="all"
                      ExcludeAssets="runtime" />
  </ItemGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk.Web" />
  <Import Project="$(RavenSdkRoot)\build\Raven.Web.targets" />
</Project>
