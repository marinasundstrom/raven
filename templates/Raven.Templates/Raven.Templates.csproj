<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RavenPackageReadmePath>$(MSBuildProjectDirectory)\README.md</RavenPackageReadmePath>
  </PropertyGroup>

  <Import Project="..\..\eng\Package.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>Raven.Templates</PackageId>
    <Title>Raven Project Templates</Title>
    <Description>Project templates for Raven console, class library, ASP.NET Core, browser WebAssembly, and .NET nanoFramework applications.</Description>
    <PackageTags>$(PackageTags);templates;dotnet-new;aspnet;webassembly;browser;nanoFramework</PackageTags>
    <PackageType>Template</PackageType>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <IncludeSymbols>false</IncludeSymbols>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <RavenTemplateContentRoot Condition="'$(RavenTemplateContentRoot)' == ''">$(MSBuildProjectDirectory)\content</RavenTemplateContentRoot>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="$(RavenTemplateContentRoot)\**\*"
             Exclude="$(RavenTemplateContentRoot)\**\bin\**;$(RavenTemplateContentRoot)\**\obj\**"
             Pack="true"
             PackagePath="content" />
  </ItemGroup>

</Project>
