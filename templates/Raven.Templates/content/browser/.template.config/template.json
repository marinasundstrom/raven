{
  "$schema": "http://json.schemastore.org/template",
  "author": "Marina Sundström and contributors",
  "classifications": [ "Raven", "Web", "WebAssembly", "Browser" ],
  "identity": "Raven.Templates.Browser",
  "name": "Raven WebAssembly Browser Application",
  "description": "A Raven application that runs on .NET WebAssembly in a browser without Blazor.",
  "shortName": "raven-browser",
  "sourceName": "RavenApp",
  "preferNameDirectory": true,
  "tags": {
    "language": "Raven",
    "type": "project"
  },
  "symbols": {
    "framework": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "net10.0",
      "replaces": "RavenTargetFramework",
      "description": "The target framework for the project."
    },
    "httpPort": {
      "type": "generated",
      "generator": "port",
      "parameters": {
        "low": 5000,
        "high": 5300
      },
      "replaces": "RavenHttpPort"
    },
    "httpsPort": {
      "type": "generated",
      "generator": "port",
      "parameters": {
        "low": 7000,
        "high": 7300
      },
      "replaces": "RavenHttpsPort"
    }
  }
}
