{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "build": {
    "content": [
      {
        "files": [
          "index.md",
          "overview.md",
          "toc.yml",
          "learn.md",
          "raven-in-60-seconds.md",
          "getting-started.md",
          "introduction.md",
          "raven-for-absolute-beginners.md",
          "raven-for-csharp-developers.md",
          "metaprogramming.md",
          "macro-authoring.md",
          "libraries/index.md",
          "libraries/toc.yml",
          "lang/README.md",
          "lang/toc.yml",
          "lang/philosophy.md",
          "lang/feature-meaning.md",
          "lang/proposals/macros/application-model.md",
          "lang/domain-modeling.md",
          "lang/nullability.md",
          "lang/style-guide.md",
          "lang/spec/*.md",
          "compiler/index.md",
          "compiler/toc.yml",
          "compiler/raven-compiler.md",
          "compiler/project-system.md",
          "compiler/extending-projects.md",
          "compiler/source-generators.md",
          "compiler/distribution.md",
          "compiler/raven-core-library.md",
          "compiler/raven-macros-library.md",
          "compiler/json-serialization.md",
          "compiler/diagnostics.md",
          "compiler/analyzers/built-in.md",
          "compiler/analyzers/configuration.md",
          "compiler/raven-vscode-extension.md",
          "compiler/distribution.md",
          "compiler/api/README.md",
          "compiler/api/result-shapes.md",
          "compiler/api/performance.md",
          "compiler/api/operations.md",
          "compiler/api/semantic-analysis.md",
          "compiler/api/symbol-resolution.md",
          "compiler/api/syntax-tree.md",
          "compiler/architecture/dotnet-conformance-and-divergence.md",
          "api/*.yml"
        ],
        "exclude": [
          "lang/spec/design-notes.md"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**",
          "lang/spec/grammar.ebnf"
        ]
      }
    ],
    "output": "../_site",
    "template": [
      "default",
      "modern",
      "template"
    ],
    "globalMetadata": {
      "_appName": "Raven",
      "_appTitle": "Raven programming language",
      "_appLogoPath": "images/raven-mark.svg",
      "_appLogoUrl": "index.html",
      "_appFooter": "The official website of the Raven programming language.",
      "_enableSearch": true,
      "pdf": false
    }
  }
}
