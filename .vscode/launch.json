{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Raven: Test Repository Extension",
            "type": "extensionHost",
            "request": "launch",
            "preLaunchTask": "build:development-environment",
            "runtimeExecutable": "${execPath}",
            "args": [
                "--extensionDevelopmentPath=${workspaceFolder}/src/Raven.VSCode"
            ],
            "env": {
                "RAVEN_DEVELOPMENT_ENVIRONMENT": "repository",
                "RAVEN_VSCODE_DEVELOPMENT": "repository",
                "RAVEN_REPOSITORY_ROOT": "${workspaceFolder}",
                "RAVEN_CONFIGURATION": "Debug",
                "RAVEN_FRAMEWORK": "net11.0",
                "RAVEN_SDK_ROOT": "${workspaceFolder}/artifacts/development/sdk/Debug/net11.0",
                "RAVEN_LANGUAGE_SERVER_PATH": "${workspaceFolder}/src/Raven.LanguageServer/bin/Debug/net11.0/Raven.LanguageServer.dll",
                "RavenCompilerHost": "${workspaceFolder}/src/Raven.Compiler/bin/Debug/net11.0/rvnc.dll",
                "RavenBuildConfiguration": "Debug",
                "RavenCompilerFramework": "net11.0",
                "PATH": "${workspaceFolder}/eng/development:${env:PATH}"
            }
        },
        {
            "name": "Raven: Debug Language Server",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build:language-server",
            "program": "${workspaceFolder}/src/Raven.LanguageServer/bin/Debug/net11.0/Raven.LanguageServer.dll",
            "args": [
                "--stdio"
            ],
            "cwd": "${workspaceFolder}",
            "console": "internalConsole",
            "stopAtEntry": false,
            "justMyCode": false,
            "requireExactSource": false
        },
        {
            "name": "Raven: Debug Compiler",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build:compiler",
            "program": "${workspaceFolder}/src/Raven.Compiler/bin/Debug/net11.0/rvnc.dll",
            "args": [
                "${workspaceFolder}/samples/scripts/hello.rvn",
                "--framework",
                "net11.0",
                "-o",
                "${workspaceFolder}/artifacts/debug/hello.dll"
            ],
            "cwd": "${workspaceFolder}",
            "console": "internalConsole",
            "stopAtEntry": false,
            "justMyCode": false,
            "requireExactSource": false
        }
    ]
}
