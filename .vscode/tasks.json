{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build:development-environment",
            "command": "${workspaceFolder}/scripts/build-development-environment.sh",
            "type": "process",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "build:language-server",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/src/Raven.LanguageServer/Raven.LanguageServer.csproj",
                "--configuration",
                "Debug",
                "--framework",
                "net11.0",
                "/property:WarningLevel=0"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "build:compiler",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/src/Raven.Compiler/Raven.Compiler.csproj",
                "--configuration",
                "Debug",
                "--framework",
                "net11.0",
                "/property:WarningLevel=0"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "compile:vscode-extension",
            "command": "npm",
            "type": "process",
            "args": [
                "--prefix",
                "${workspaceFolder}/src/Raven.VSCode",
                "run",
                "compile"
            ],
            "problemMatcher": []
        }
    ]
}
