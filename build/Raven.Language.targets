<Project>
  <Import
    Project="$(MSBuildThisFileDirectory)Raven.nanoFramework.props"
    Condition="'$(TargetFramework)' == 'netnano1.0' and Exists('$(MSBuildThisFileDirectory)Raven.nanoFramework.props')" />

  <PropertyGroup>
    <RavenCompilerFramework Condition="'$(RavenCompilerFramework)' == '' and '$(TargetFramework)' == 'net11.0'">net11.0</RavenCompilerFramework>
    <RavenCompilerFramework Condition="'$(RavenCompilerFramework)' == ''">net10.0</RavenCompilerFramework>
    <RavenBuildConfiguration Condition="'$(RavenBuildConfiguration)' == '' and '$(Configuration)' != ''">$(Configuration)</RavenBuildConfiguration>
    <RavenBuildConfiguration Condition="'$(RavenBuildConfiguration)' == ''">Debug</RavenBuildConfiguration>
    <RavenSdkRoot Condition="'$(RavenSdkRoot)' == '' and Exists('$(MSBuildThisFileDirectory)..\..\VERSION')">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..'))</RavenSdkRoot>
    <RavenCompilerHost Condition="'$(RavenCompilerHost)' == '' and '$(RavenSdkRoot)' != '' and Exists('$(RavenSdkRoot)\tools\rvnc\rvnc.dll')">$(RavenSdkRoot)\tools\rvnc\rvnc.dll</RavenCompilerHost>
    <RavenCompilerHost Condition="'$(RavenCompilerHost)' == '' and Exists('$(MSBuildThisFileDirectory)..\tools\$(RavenCompilerFramework)\rvnc.dll')">$(MSBuildThisFileDirectory)..\tools\$(RavenCompilerFramework)\rvnc.dll</RavenCompilerHost>
    <RavenCompilerHost Condition="'$(RavenCompilerHost)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\src\Raven.Compiler\bin\$(RavenBuildConfiguration)\$(RavenCompilerFramework)\rvnc.dll'))</RavenCompilerHost>
    <RavenCoreTargetFrameworkCandidate Condition="'$(TargetFramework)' != ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\src\Raven.Core\bin\$(RavenBuildConfiguration)\$(TargetFramework)\Raven.Core.dll'))</RavenCoreTargetFrameworkCandidate>
    <RavenCoreCompilerFrameworkCandidate>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\src\Raven.Core\bin\$(RavenBuildConfiguration)\$(RavenCompilerFramework)\Raven.Core.dll'))</RavenCoreCompilerFrameworkCandidate>
    <RavenCompilerHostDirectory>$([System.IO.Path]::GetDirectoryName('$(RavenCompilerHost)'))</RavenCompilerHostDirectory>
    <RavenCoreCompilerHostCandidate>$([System.IO.Path]::Combine('$(RavenCompilerHostDirectory)', 'Raven.Core.dll'))</RavenCoreCompilerHostCandidate>
    <RavenCoreReferencePath Condition="'$(RavenCoreReferencePath)' == '' and '$(RavenSdkRoot)' != '' and Exists('$(RavenSdkRoot)\sdk\Raven.Core.dll')">$(RavenSdkRoot)\sdk\Raven.Core.dll</RavenCoreReferencePath>
    <RavenCoreReferencePath Condition="'$(RavenCoreReferencePath)' == '' and '$(TargetFramework)' != '' and Exists('$(MSBuildThisFileDirectory)..\tools\$(TargetFramework)\Raven.Core.dll')">$(MSBuildThisFileDirectory)..\tools\$(TargetFramework)\Raven.Core.dll</RavenCoreReferencePath>
    <RavenCoreReferencePath Condition="'$(RavenCoreReferencePath)' == '' and '$(RavenCoreTargetFrameworkCandidate)' != '' and Exists('$(RavenCoreTargetFrameworkCandidate)')">$(RavenCoreTargetFrameworkCandidate)</RavenCoreReferencePath>
    <RavenCoreReferencePath Condition="'$(RavenCoreReferencePath)' == '' and Exists('$(MSBuildThisFileDirectory)..\tools\$(RavenCompilerFramework)\Raven.Core.dll')">$(MSBuildThisFileDirectory)..\tools\$(RavenCompilerFramework)\Raven.Core.dll</RavenCoreReferencePath>
    <RavenCoreReferencePath Condition="'$(RavenCoreReferencePath)' == '' and Exists('$(RavenCoreCompilerFrameworkCandidate)')">$(RavenCoreCompilerFrameworkCandidate)</RavenCoreReferencePath>
    <RavenCoreReferencePath Condition="'$(RavenCoreReferencePath)' == '' and Exists('$(RavenCoreCompilerHostCandidate)')">$(RavenCoreCompilerHostCandidate)</RavenCoreReferencePath>
    <RavenEmitCoreTypesOnly Condition="'$(RavenEmitCoreTypesOnly)' == ''">false</RavenEmitCoreTypesOnly>
    <RavenUseHostFrameworkReferences Condition="'$(RavenUseHostFrameworkReferences)' == ''">true</RavenUseHostFrameworkReferences>
    <RavenCoreArgument Condition="'$(RavenEmitCoreTypesOnly)' == 'true'">--emit-core-types-only</RavenCoreArgument>
    <RavenCoreArgument Condition="'$(RavenCoreArgument)' == '' and '$(RavenCoreReferencePath)' != ''">--raven-core &quot;$(RavenCoreReferencePath)&quot;</RavenCoreArgument>
    <RavenCoreArgument Condition="'$(RavenCoreArgument)' == ''">--emit-core-types-only</RavenCoreArgument>
    <RavenBuildArgs Condition="'$(RavenBuildArgs)' == ''"></RavenBuildArgs>
    <RavenFrameworkReferencesArgument Condition="'$(RavenUseHostFrameworkReferences)' == 'false'">--no-framework-references</RavenFrameworkReferencesArgument>
    <RavenTargetCoreLibraryArgument Condition="'$(RavenTargetCoreLibraryPath)' != ''">--target-core-library &quot;$(RavenTargetCoreLibraryPath)&quot;</RavenTargetCoreLibraryArgument>
    <RavenTargetFrameworkArgument Condition="'$(TargetFramework)' != ''">--framework &quot;$(TargetFramework)&quot;</RavenTargetFrameworkArgument>
    <RavenConfigurationArgument Condition="'$(Configuration)' != ''">--configuration &quot;$(Configuration)&quot;</RavenConfigurationArgument>
    <RavenOutputTypeArgument Condition="'$(OutputType)' == 'Library'">--output-type classlib</RavenOutputTypeArgument>
    <RavenOutputTypeArgument Condition="'$(RavenOutputTypeArgument)' == '' and '$(OutputType)' != ''">--output-type exe</RavenOutputTypeArgument>
    <RavenExternalConstantOverridesArgument Condition="'$(RavenExternalConstantOverrides)' != ''">--constant-overrides &quot;$(RavenExternalConstantOverrides)&quot;</RavenExternalConstantOverridesArgument>

    <DefaultLanguageSourceExtension>.rvn</DefaultLanguageSourceExtension>
    <Language>Raven</Language>
    <TargetRuntime>Managed</TargetRuntime>
    <GenerateAssemblyInfo Condition="'$(GenerateAssemblyInfo)' == ''">false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute Condition="'$(GenerateTargetFrameworkAttribute)' == ''">false</GenerateTargetFrameworkAttribute>
    <ProduceReferenceAssembly Condition="'$(ProduceReferenceAssembly)' == ''">false</ProduceReferenceAssembly>
    <EnableDefaultCompileItems Condition="'$(EnableDefaultCompileItems)' == ''">true</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems Condition="'$(EnableDefaultEmbeddedResourceItems)' == ''">false</EnableDefaultEmbeddedResourceItems>
    <RavenGenerateDocumentation Condition="'$(RavenGenerateDocumentation)' == '' and '$(OutputType)' == 'Library'">true</RavenGenerateDocumentation>
    <RavenGenerateDocumentation Condition="'$(RavenGenerateDocumentation)' == ''">false</RavenGenerateDocumentation>
    <GenerateDocumentationFile Condition="'$(GenerateDocumentationFile)' == ''">$(RavenGenerateDocumentation)</GenerateDocumentationFile>
    <GenerateMarkdownDocumentationFile Condition="'$(GenerateMarkdownDocumentationFile)' == ''">$(RavenGenerateDocumentation)</GenerateMarkdownDocumentationFile>
    <GenerateXmlDocumentationFromMarkdownComments Condition="'$(GenerateXmlDocumentationFromMarkdownComments)' == ''">$(RavenGenerateDocumentation)</GenerateXmlDocumentationFromMarkdownComments>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);_IncludeRavenXmlDocumentationInPackage</TargetsForTfmSpecificBuildOutput>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_IncludeRavenMarkdownDocumentationInPackage</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <ItemGroup>
    <AvailableItemName Include="SourceGenerator" />
    <PropertyPageSchema Include="$(CommonXamlResourcesDirectory)CSharp.ProjectItemsSchema.xaml" Condition="'$(CommonXamlResourcesDirectory)' != ''" />
    <ProjectCapability Include="Managed" />
    <Compile Remove="**/*.cs" />
    <EmbeddedResource Remove="**/*.resx" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsCrossTargetingBuild)' != 'true' and '$(RavenEmitCoreTypesOnly)' != 'true' and '$(RavenCoreReferencePath)' != ''">
    <Reference Include="Raven.Core">
      <HintPath>$(RavenCoreReferencePath)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <PropertyGroup>
    <RavenCommonTargetsPath Condition="'$(IsCrossTargetingBuild)' == 'true'">$(MSBuildToolsPath)\Microsoft.Common.CrossTargeting.targets</RavenCommonTargetsPath>
    <RavenCommonTargetsPath Condition="'$(RavenCommonTargetsPath)' == ''">$(MSBuildToolsPath)\Microsoft.Common.targets</RavenCommonTargetsPath>
  </PropertyGroup>

  <Import Project="$(RavenCommonTargetsPath)" />

  <ItemGroup Condition="'$(EnableDefaultCompileItems)' == 'true'">
    <Compile Remove="@(Compile->WithMetadataValue('DefiningProjectName', 'Microsoft.NET.Sdk.DefaultItems'))" />
    <Compile Include="**/*.rvn" Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder)" />
    <Compile Remove="bin/**/*.rvn;obj/**/*.rvn;**/.*/**/*.rvn" />
  </ItemGroup>

  <PropertyGroup>
    <_RavenCompilerDependencyFile>$(IntermediateOutputPath)$(TargetName).ravendeps</_RavenCompilerDependencyFile>
    <_RavenExternalConstantsStateFile>$(IntermediateOutputPath)$(TargetName).ravenconstants</_RavenExternalConstantsStateFile>
    <CoreCompileDependsOn>_WriteRavenExternalConstantsState;_ReadRavenCompilerDependencies;$(CoreCompileDependsOn)</CoreCompileDependsOn>
  </PropertyGroup>

  <Target Name="CreateManifestResourceNames" />

  <Target Name="_WriteRavenExternalConstantsState">
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <WriteLinesToFile
      File="$(_RavenExternalConstantsStateFile)"
      Lines="$(RavenExternalConstantOverrides);@(RavenConstant->'%(Identity)=%(Value)')"
      Overwrite="true"
      WriteOnlyWhenDifferent="true" />
  </Target>

  <Target Name="_ReadRavenCompilerDependencies">
    <ReadLinesFromFile
      File="$(_RavenCompilerDependencyFile)"
      Condition="Exists('$(_RavenCompilerDependencyFile)')">
      <Output TaskParameter="Lines" ItemName="_RavenCompilerDependency" />
    </ReadLinesFromFile>
  </Target>

  <Target
    Name="CoreCompile"
    DependsOnTargets="$(CoreCompileDependsOn)"
    Inputs="$(MSBuildProjectFullPath);@(Compile);@(_RavenCompilerDependency);@(ReferencePath);@(ProjectReference);@(Analyzer);@(SourceGenerator);$(_RavenExternalConstantsStateFile)"
    Outputs="@(IntermediateAssembly)"
    Condition="'$(IsCrossTargetingBuild)' != 'true'">
    <PropertyGroup>
      <_RavenIntermediateOutputPath Condition="$([System.IO.Path]::IsPathRooted('$(IntermediateOutputPath)'))">$(IntermediateOutputPath)</_RavenIntermediateOutputPath>
      <_RavenIntermediateOutputPath Condition="'$(_RavenIntermediateOutputPath)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\$(IntermediateOutputPath)'))</_RavenIntermediateOutputPath>
    </PropertyGroup>

    <Error
      Condition="!Exists('$(RavenCompilerHost)')"
      Text="Built Raven compiler host not found at '$(RavenCompilerHost)'. Build Raven.Compiler first or set &lt;RavenCompilerHost&gt;." />

    <MakeDir Directories="$(_RavenIntermediateOutputPath)" />

    <ItemGroup>
      <_RavenCoreReference Include="@(ReferencePath)" Condition="Exists('%(FullPath)') and '%(Filename)' == 'Raven.Core'" />
      <_RavenReferencePath Include="@(ReferencePath)" Condition="Exists('%(FullPath)') and '%(Filename)' != 'Raven.Core'" />
    </ItemGroup>

    <PropertyGroup>
      <RavenCoreReferencePath Condition="'$(RavenCoreReferencePath)' == '' and '@(_RavenCoreReference)' != ''">@(_RavenCoreReference->'%(FullPath)')</RavenCoreReferencePath>
      <RavenCoreArgument Condition="'$(RavenEmitCoreTypesOnly)' == 'true'">--emit-core-types-only</RavenCoreArgument>
      <RavenCoreArgument Condition="'$(RavenEmitCoreTypesOnly)' != 'true' and '$(RavenCoreReferencePath)' != ''">--raven-core &quot;$(RavenCoreReferencePath)&quot;</RavenCoreArgument>
      <RavenReferenceArguments>@(_RavenReferencePath->'--refs &quot;%(FullPath)&quot;', ' ')</RavenReferenceArguments>
      <_RavenConstantArguments>@(RavenConstant->'--constant &quot;%(Identity)=%(Value)&quot;', ' ')</_RavenConstantArguments>
    </PropertyGroup>

    <Message Importance="High" Text="Raven CoreCompile: $(MSBuildProjectFile) -&gt; @(IntermediateAssembly)" />
    <Exec
      Command="dotnet &quot;$(RavenCompilerHost)&quot; &quot;$(MSBuildProjectFullPath)&quot; -o &quot;$(_RavenIntermediateOutputPath).&quot; --dependency-file &quot;$(_RavenCompilerDependencyFile)&quot; $(RavenTargetFrameworkArgument) $(RavenConfigurationArgument) $(RavenOutputTypeArgument) $(RavenExternalConstantOverridesArgument) $(_RavenConstantArguments) --no-project-restore $(RavenFrameworkReferencesArgument) $(RavenTargetCoreLibraryArgument) $(RavenCoreArgument) $(RavenReferenceArguments) $(RavenBuildArgs)"
      EchoOff="true"
      IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="_RavenCompilerExitCode" />
    </Exec>
    <Error
      Condition="'$(_RavenCompilerExitCode)' != '0'"
      Code="RAVENBUILD"
      Text="Raven compilation failed. See the compiler diagnostics above." />

    <MakeDir Directories="@(IntermediateRefAssembly->'%(RootDir)%(Directory)')" Condition="'@(IntermediateRefAssembly)' != ''" />
    <Copy
      SourceFiles="@(IntermediateAssembly)"
      DestinationFiles="@(IntermediateRefAssembly)"
      Condition="'@(IntermediateRefAssembly)' != '' and Exists('@(IntermediateAssembly)')" />

    <ItemGroup>
      <_RavenGeneratedFile Include="$(_RavenIntermediateOutputPath)raven/generated/**/*.rvn" />
      <FileWrites Include="@(IntermediateAssembly)" />
      <FileWrites Include="@(IntermediateRefAssembly)" Condition="'@(IntermediateRefAssembly)' != ''" />
      <FileWrites Include="@(IntermediateAssembly->'%(RootDir)%(Directory)%(Filename).pdb')" />
      <FileWrites Include="$(IntermediateOutputPath)$(TargetName).runtimeconfig.json" />
      <FileWrites Include="$(IntermediateOutputPath)$(TargetName)$(ExeExtension)" Condition="'$(OutputType)' != 'Library'" />
      <FileWrites Include="$(_RavenCompilerDependencyFile)" />
      <FileWrites Include="@(_RavenGeneratedFile)" />
    </ItemGroup>
  </Target>

  <Target
    Name="_CopyRavenDocumentationFileToOutputDirectory"
    AfterTargets="CopyFilesToOutputDirectory"
    Condition="'$(RavenGenerateDocumentation)' == 'true' or '$(GenerateDocumentationFile)' == 'true' or '$(GenerateMarkdownDocumentationFile)' == 'true'">
    <PropertyGroup>
      <_RavenXmlDocumentationFile Condition="'$(DocumentationFile)' != ''">$(DocumentationFile)</_RavenXmlDocumentationFile>
      <_RavenXmlDocumentationFile Condition="'$(_RavenXmlDocumentationFile)' == ''">$(IntermediateOutputPath)$(TargetName).xml</_RavenXmlDocumentationFile>
    </PropertyGroup>
    <ItemGroup>
      <_RavenMarkdownDocumentationFiles
        Include="$(IntermediateOutputPath)$(TargetName).docs/**/*"
        Condition="'$(GenerateMarkdownDocumentationFile)' == 'true'" />
    </ItemGroup>
    <Copy
      SourceFiles="$(_RavenXmlDocumentationFile)"
      DestinationFiles="$(OutDir)$(TargetName).xml"
      SkipUnchangedFiles="true"
      Condition="('$(RavenGenerateDocumentation)' == 'true' or '$(GenerateDocumentationFile)' == 'true') and Exists('$(_RavenXmlDocumentationFile)')" />
    <Copy
      SourceFiles="@(_RavenMarkdownDocumentationFiles)"
      DestinationFiles="@(_RavenMarkdownDocumentationFiles->'$(OutDir)$(TargetName).docs/%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true"
      Condition="'@(_RavenMarkdownDocumentationFiles)' != ''" />
    <ItemGroup>
      <FileWrites Include="$(_RavenXmlDocumentationFile)" Condition="Exists('$(_RavenXmlDocumentationFile)')" />
      <FileWrites Include="@(_RavenMarkdownDocumentationFiles)" />
      <FileWrites Include="$(OutDir)$(TargetName).xml" Condition="('$(RavenGenerateDocumentation)' == 'true' or '$(GenerateDocumentationFile)' == 'true') and Exists('$(_RavenXmlDocumentationFile)')" />
      <FileWrites Include="@(_RavenMarkdownDocumentationFiles->'$(OutDir)$(TargetName).docs/%(RecursiveDir)%(Filename)%(Extension)')" />
    </ItemGroup>
  </Target>

  <Target
    Name="_CopyRavenReferenceDocumentationToOutputDirectory"
    AfterTargets="CopyFilesToOutputDirectory"
    Condition="'$(IsCrossTargetingBuild)' != 'true'">
    <ItemGroup>
      <_RavenCopyLocalXmlDocumentationAssembly
        Include="@(ReferenceCopyLocalPaths)"
        Condition="'%(Extension)' == '.dll' and Exists('%(RootDir)%(Directory)%(Filename).xml')" />
      <_RavenCopyLocalMarkdownDocumentationAssembly
        Include="@(ReferenceCopyLocalPaths)"
        Condition="'%(Extension)' == '.dll' and Exists('%(RootDir)%(Directory)%(Filename).docs')" />
      <_RavenCopyLocalXmlDocumentationFile
        Include="@(_RavenCopyLocalXmlDocumentationAssembly->'%(RootDir)%(Directory)%(Filename).xml')" />
      <_RavenCopyLocalMarkdownDocumentationFile
        Include="%(_RavenCopyLocalMarkdownDocumentationAssembly.RootDir)%(_RavenCopyLocalMarkdownDocumentationAssembly.Directory)%(_RavenCopyLocalMarkdownDocumentationAssembly.Filename).docs/**/*">
        <DocumentationAssemblyName>%(_RavenCopyLocalMarkdownDocumentationAssembly.Filename)</DocumentationAssemblyName>
      </_RavenCopyLocalMarkdownDocumentationFile>
    </ItemGroup>
    <Copy
      SourceFiles="@(_RavenCopyLocalXmlDocumentationFile)"
      DestinationFiles="@(_RavenCopyLocalXmlDocumentationFile->'$(OutDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true"
      Condition="'@(_RavenCopyLocalXmlDocumentationFile)' != ''" />
    <Copy
      SourceFiles="@(_RavenCopyLocalMarkdownDocumentationFile)"
      DestinationFiles="@(_RavenCopyLocalMarkdownDocumentationFile->'$(OutDir)%(DocumentationAssemblyName).docs/%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true"
      Condition="'@(_RavenCopyLocalMarkdownDocumentationFile)' != ''" />
    <ItemGroup>
      <FileWrites Include="@(_RavenCopyLocalXmlDocumentationFile->'$(OutDir)%(Filename)%(Extension)')" />
      <FileWrites Include="@(_RavenCopyLocalMarkdownDocumentationFile->'$(OutDir)%(DocumentationAssemblyName).docs/%(RecursiveDir)%(Filename)%(Extension)')" />
    </ItemGroup>
  </Target>

  <Target
    Name="_IncludeRavenXmlDocumentationInPackage"
    Condition="'$(OutputType)' == 'Library' and ('$(RavenGenerateDocumentation)' == 'true' or '$(GenerateDocumentationFile)' == 'true')">
    <ItemGroup>
      <BuildOutputInPackage
        Include="$(OutputPath)$(AssemblyName).xml"
        Condition="Exists('$(OutputPath)$(AssemblyName).xml')" />
    </ItemGroup>
  </Target>

  <Target
    Name="_IncludeRavenMarkdownDocumentationInPackage"
    Condition="'$(OutputType)' == 'Library' and '$(GenerateMarkdownDocumentationFile)' == 'true'">
    <ItemGroup>
      <_RavenMarkdownDocumentation Include="$(OutputPath)$(AssemblyName).docs/**/*" />
      <TfmSpecificPackageFile Include="@(_RavenMarkdownDocumentation)">
        <PackagePath>lib/$(TargetFramework)/$(AssemblyName).docs/%(_RavenMarkdownDocumentation.RecursiveDir)%(_RavenMarkdownDocumentation.Filename)%(_RavenMarkdownDocumentation.Extension)</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>
  </Target>

  <Target
    Name="_CaptureRavenRuntimeDependencies"
    BeforeTargets="CoreCompile"
    Condition="'$(IsCrossTargetingBuild)' != 'true'">
    <PropertyGroup>
      <_RavenRuntimeIntermediatePath Condition="$([System.IO.Path]::IsPathRooted('$(IntermediateOutputPath)'))">$(IntermediateOutputPath)</_RavenRuntimeIntermediatePath>
      <_RavenRuntimeIntermediatePath Condition="'$(_RavenRuntimeIntermediatePath)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\$(IntermediateOutputPath)'))</_RavenRuntimeIntermediatePath>
      <_RavenRuntimeDependencyManifest>$(_RavenRuntimeIntermediatePath).raven-runtime-dependencies</_RavenRuntimeDependencyManifest>
    </PropertyGroup>
    <ReadLinesFromFile
      File="$(_RavenRuntimeDependencyManifest)"
      Condition="Exists('$(_RavenRuntimeDependencyManifest)')">
      <Output TaskParameter="Lines" ItemName="_PreviousRavenRuntimeDependencyName" />
    </ReadLinesFromFile>
  </Target>

  <Target
    Name="_ResolveRavenRuntimeDependencies"
    AfterTargets="CoreCompile"
    BeforeTargets="GenerateBuildDependencyFile;CopyFilesToOutputDirectory"
    DependsOnTargets="_CaptureRavenRuntimeDependencies"
    Condition="'$(IsCrossTargetingBuild)' != 'true'">
    <ReadLinesFromFile
      File="$(_RavenRuntimeDependencyManifest)"
      Condition="Exists('$(_RavenRuntimeDependencyManifest)')">
      <Output TaskParameter="Lines" ItemName="_RavenRuntimeDependencyName" />
    </ReadLinesFromFile>
    <ItemGroup>
      <_ResolvedRavenReferenceName Include="@(ReferencePath->'%(Filename)%(Extension)')" />
      <_ResolvedRavenReferenceName Include="@(ReferenceCopyLocalPaths->'%(Filename)%(Extension)')" />
      <_RavenRuntimeDependencyName Remove="@(_ResolvedRavenReferenceName)" />
      <_StaleRavenRuntimeDependencyName Include="@(_PreviousRavenRuntimeDependencyName)" />
      <_StaleRavenRuntimeDependencyName Remove="@(_RavenRuntimeDependencyName)" />
      <_StaleRavenRuntimeDependencyName Remove="@(_ResolvedRavenReferenceName)" />
      <_RavenRuntimeDependency
        Include="@(_RavenRuntimeDependencyName->'$(_RavenRuntimeIntermediatePath)%(Identity)')"
        Exclude="@(ReferencePath);@(ReferenceCopyLocalPaths);@(ReferenceDependencyPaths)" />
      <ReferenceCopyLocalPaths Include="@(_RavenRuntimeDependency)">
        <CopyLocal>true</CopyLocal>
        <ReferenceSourceTarget>RavenCompilerRuntime</ReferenceSourceTarget>
      </ReferenceCopyLocalPaths>
      <ReferencePath Include="@(_RavenRuntimeDependency)">
        <CopyLocal>true</CopyLocal>
        <IncludeRuntimeDependency>true</IncludeRuntimeDependency>
        <ReferenceSourceTarget>RavenCompilerRuntime</ReferenceSourceTarget>
      </ReferencePath>
      <ReferenceDependencyPaths Include="@(_RavenRuntimeDependency)">
        <CopyLocal>true</CopyLocal>
        <ReferenceSourceTarget>RavenCompilerRuntime</ReferenceSourceTarget>
      </ReferenceDependencyPaths>
      <FileWrites Include="@(_RavenRuntimeDependency->'$(OutDir)%(Filename)%(Extension)')" />
      <FileWrites Include="@(_RavenRuntimeDependency)" />
      <FileWrites Include="$(_RavenRuntimeDependencyManifest)" Condition="Exists('$(_RavenRuntimeDependencyManifest)')" />
    </ItemGroup>
    <Delete
      Files="@(_StaleRavenRuntimeDependencyName->'$(_RavenRuntimeIntermediatePath)%(Identity)');@(_StaleRavenRuntimeDependencyName->'$(OutDir)%(Identity)');$(ProjectDepsFilePath)"
      Condition="'@(_StaleRavenRuntimeDependencyName)' != ''" />
    <Copy
      SourceFiles="@(_RavenRuntimeDependency)"
      DestinationFolder="$(OutDir)"
      SkipUnchangedFiles="true"
      Condition="'@(_RavenRuntimeDependency)' != ''" />
  </Target>

  <Target Name="_CleanRavenArtifacts" AfterTargets="CoreClean">
    <PropertyGroup>
      <_RavenCleanXmlDocumentationFile Condition="'$(DocumentationFile)' != ''">$(DocumentationFile)</_RavenCleanXmlDocumentationFile>
      <_RavenCleanXmlDocumentationFile Condition="'$(_RavenCleanXmlDocumentationFile)' == ''">$(IntermediateOutputPath)$(TargetName).xml</_RavenCleanXmlDocumentationFile>
    </PropertyGroup>
    <Delete Files="$(_RavenCompilerDependencyFile);$(_RavenExternalConstantsStateFile);$(IntermediateOutputPath).raven-runtime-dependencies;$(_RavenCleanXmlDocumentationFile)" />
    <RemoveDir Directories="$(IntermediateOutputPath)raven/generated;$(IntermediateOutputPath)$(TargetName).docs;$(OutDir)$(TargetName).docs" />
  </Target>

  <Import
    Project="$(MSBuildThisFileDirectory)Raven.nanoFramework.targets"
    Condition="'$(TargetFramework)' == 'netnano1.0' and Exists('$(MSBuildThisFileDirectory)Raven.nanoFramework.targets')" />
</Project>
