<Project>
  <PropertyGroup>
    <TargetFrameworkIdentifier>.NETnanoFramework</TargetFrameworkIdentifier>
    <TargetFrameworkVersion>v1.0</TargetFrameworkVersion>
    <TargetFrameworkMoniker>.NETnanoFramework,Version=v1.0</TargetFrameworkMoniker>
    <TargetFrameworkMonikerDisplayName>.NET nanoFramework 1.0</TargetFrameworkMonikerDisplayName>
    <TargetExt>.dll</TargetExt>

    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <BypassFrameworkInstallChecks>true</BypassFrameworkInstallChecks>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <NoStdLib>true</NoStdLib>
    <UseAppHost>false</UseAppHost>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>

    <RavenUseHostFrameworkReferences>false</RavenUseHostFrameworkReferences>
    <RavenEmitCoreTypesOnly>true</RavenEmitCoreTypesOnly>
    <ImplicitImports>disable</ImplicitImports>
    <GeneratePreludeImports>false</GeneratePreludeImports>
    <FrameworkProjections>None</FrameworkProjections>

    <NanoFrameworkCoreVersion Condition="'$(NanoFrameworkCoreVersion)' == ''">2.0.0-preview.52</NanoFrameworkCoreVersion>
    <NanoFrameworkMetadataProcessorVersion Condition="'$(NanoFrameworkMetadataProcessorVersion)' == ''">4.0.0-preview.101</NanoFrameworkMetadataProcessorVersion>
    <NanoFrameworkPackagesDirectory Condition="'$(NanoFrameworkPackagesDirectory)' == '' and '$(RestorePackagesPath)' != ''">$(RestorePackagesPath)</NanoFrameworkPackagesDirectory>
    <NanoFrameworkPackagesDirectory Condition="'$(NanoFrameworkPackagesDirectory)' == ''">$(NuGetPackageRoot)</NanoFrameworkPackagesDirectory>
    <RavenTargetCoreLibraryPath>$([System.IO.Path]::Combine('$(NanoFrameworkPackagesDirectory)', 'nanoframework.corelibrary', '$(NanoFrameworkCoreVersion)', 'lib', 'netnano1.0', 'mscorlib.dll'))</RavenTargetCoreLibraryPath>
    <NanoFrameworkReferenceDirectory>$([System.IO.Path]::GetDirectoryName('$(RavenTargetCoreLibraryPath)'))</NanoFrameworkReferenceDirectory>
    <_TargetFrameworkDirectories>$(NanoFrameworkReferenceDirectory)</_TargetFrameworkDirectories>
    <_FullFrameworkReferenceAssemblyPaths>$(NanoFrameworkReferenceDirectory)</_FullFrameworkReferenceAssemblyPaths>
    <TargetFrameworkDirectory>$(NanoFrameworkReferenceDirectory)</TargetFrameworkDirectory>
    <AssemblySearchPaths>{HintPathFromItem};{TargetFrameworkDirectory};{RawFileName}</AssemblySearchPaths>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="nanoFramework.CoreLibrary" Version="$(NanoFrameworkCoreVersion)" />
    <PackageReference Include="nanoFramework.Tools.MetadataProcessor.CLI" Version="$(NanoFrameworkMetadataProcessorVersion)" PrivateAssets="all" />
  </ItemGroup>
</Project>
