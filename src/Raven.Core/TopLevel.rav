namespace System.Runtime.CompilerServices

import System.*

/// Marks a static type as a container whose static members are promoted as namespace members.
[AttributeUsage(AttributeTargets.Class | AttributeTargets.Struct)]
public class TopLevelAttribute : Attribute {
}

/// Marks a `Raven.Core` method as the implementation adapter for a compiler-owned framework API projection.
///
/// The projection catalog determines which framework method is replaced and remains authoritative.
[AttributeUsage(AttributeTargets.Method)]
public class FrameworkProjectionAttribute : Attribute {
    private val _id: string

    /// Creates a marker for the projection with the specified catalog identifier.
    ///
    /// @param id The stable identifier of the compiler-owned projection.
    init(id: string) {
        _id = id
    }
}
