namespace System

import System.*

/// Describes an error with a human-readable message and an optional underlying cause.
///
/// Error types can implement this contract directly. Union-based errors can
/// alternatively use Raven.Macros.Error to derive the same ordinary interface
/// implementation; the macro does not change this runtime contract.
public interface IError {
    /// Gets a human-readable description of this error value.
    val Message: string

    /// Gets the lower-level error that caused this error, or `null` when this
    /// error has no causal chain.
    val Cause: IError? => null
}

/// Adds contextual information around an existing main error.
///
/// The contextual message describes the current operation. `Cause` preserves
/// the underlying typed error so explicit error propagation does not erase the
/// original failure.
///
/// @typeparam TError The type of the underlying error.
public record ContextError<TError: IError>(
    /// Gets the contextual error message.
    val Message: string,
    /// Gets the underlying error.
    val Cause: TError
) : IError {
    /// Gets the underlying error through the non-generic error interface.
    val IError.Cause: IError? => Cause

    /// Returns the contextual error message.
    override func ToString() -> string? => Message
}

/// Provides context-building operations for strongly typed errors.
///
/// @typeparam TError The error type being extended.
public extension ErrorExtensions<TError: IError> for TError {
    /// Wraps this error with an additional contextual message.
    ///
    /// @param message The contextual message.
    /// @returns A contextual error whose cause is this error.
    func WithContext(message: string) -> ContextError<TError>
        => ContextError<TError>(message, self)
}

/// Provides context-building operations for errors used through `IError`.
public extension ErrorObjectExtensions for IError {
    /// Boxes this error in a contextual error with the specified message.
    ///
    /// @param message The contextual message.
    /// @returns A contextual error whose cause is this error.
    func Box(message: string) -> ContextError<IError>
        => ContextError<IError>(message, self)
}
