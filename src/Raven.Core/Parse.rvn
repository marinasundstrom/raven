namespace System

import System.*
import System.Globalization.*
import System.Optional.*
import System.Result.*
import System.Runtime.CompilerServices.*

/// Provides carrier-returning parsing projections for 32-bit integers.
public extension Int32Extensions for Int32 {

    /// Parses an integer and returns `Some` on success or `None` on failure.
    [FrameworkProjection("system.int32.tryparse.string.option.v1")]
    static func TryParse(input: string?) -> Optional<int> {
        if Int32.TryParse(input, out var value) {
            return Some(value)
        }

        return None
    }

    /// Parses an integer using the specified style and format provider.
    [FrameworkProjection("system.int32.tryparse.string-style-provider.option.v1")]
    static func TryParse(input: string?, style: NumberStyles, provider: IFormatProvider?) -> Optional<int> {
        if Int32.TryParse(input, style, provider, out var value) {
            return Some(value)
        }

        return None
    }

    /// Parses an integer and captures format or overflow failures in a `Result`.
    [FrameworkProjection("system.int32.parse.string.result.v2")]
    static func Parse(input: string) -> Result<int, Union<FormatException, OverflowException>> {
        try {
            return Ok(int.Parse(input))
        } catch FormatException ex {
            return Failure(ex)
        } catch OverflowException ex {
            return Failure(ex)
        }
    }
}

