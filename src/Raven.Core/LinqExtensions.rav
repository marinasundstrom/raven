namespace System.Linq

import System.*
import System.Linq.*
import System.Collections.Generic.*
import System.Option.*
import System.Result.*

/// Provides `Option`- and `Result`-returning sequence operations.
///
/// @typeparam T The sequence element type.
extension EnumerableOption<T> for IEnumerable<T> {

    // -------------------------
    // First
    // -------------------------

    /// Returns the first element as `Some`, or `None` for an empty sequence.
    func FirstOrNone() -> Option<T> {
        val values = self.Take(1).ToList()
        if values.Count == 1 {
            return Some(values[0])
        }
        None
    }

    /// Returns the first matching element as `Some`, or `None` when no element matches.
    func FirstOrNone(predicate: T -> bool) -> Option<T> {
        val values = self.Where(predicate).Take(1).ToList()
        if values.Count == 1 {
            return Some(values[0])
        }
        None
    }

    /// Returns the first element as `Ok`, or an error produced by `errorFactory`.
    func FirstOrError<E>(errorFactory: () -> E) -> Result<T, E> {
        val values = self.Take(1).ToList()
        if values.Count == 1 {
            return Ok(values[0])
        }
        Error(errorFactory())
    }

    /// Returns the first matching element as `Ok`, or an error produced by `errorFactory`.
    func FirstOrError<E>(predicate: T -> bool, errorFactory: () -> E) -> Result<T, E> {
        val values = self.Where(predicate).Take(1).ToList()
        if values.Count == 1 {
            return Ok(values[0])
        }
        Error(errorFactory())
    }

    // -------------------------
    // Last
    // -------------------------

    /// Returns the last element as `Some`, or `None` for an empty sequence.
    func LastOrNone() -> Option<T> {
        val values = self.ToList()
        if values.Count == 0 {
            return None
        }
        Some(values[values.Count - 1])
    }

    /// Returns the last matching element as `Some`, or `None` when no element matches.
    func LastOrNone(predicate: T -> bool) -> Option<T> {
        val values = self.Where(predicate).ToList()
        if values.Count == 0 {
            return None
        }
        Some(values[values.Count - 1])
    }

    /// Returns the last element as `Ok`, or an error produced by `errorFactory`.
    func LastOrError<E>(errorFactory: () -> E) -> Result<T, E> {
        val values = self.ToList()
        if values.Count == 0 {
            return Error(errorFactory())
        }
        Ok(values[values.Count - 1])
    }

    /// Returns the last matching element as `Ok`, or an error produced by `errorFactory`.
    func LastOrError<E>(predicate: T -> bool, errorFactory: () -> E) -> Result<T, E> {
        val values = self.Where(predicate).ToList()
        if values.Count == 0 {
            return Error(errorFactory())
        }
        Ok(values[values.Count - 1])
    }

    // -------------------------
    // Single
    // -------------------------

    /// Returns the only element as `Some`, or `None` unless exactly one element exists.
    func SingleOrNone() -> Option<T> {
        val values = self.Take(2).ToList()
        if values.Count == 1 {
            return Some(values[0])
        }
        None
    }

    /// Returns the only matching element as `Some`, or `None` unless exactly one element matches.
    func SingleOrNone(predicate: T -> bool) -> Option<T> {
        val values = self.Where(predicate).Take(2).ToList()
        if values.Count == 1 {
            return Some(values[0])
        }
        None
    }

    /// Returns the only element as `Ok`, or an error unless exactly one element exists.
    func SingleOrError<E>(errorFactory: () -> E) -> Result<T, E> {
        val values = self.Take(2).ToList()
        if values.Count == 1 {
            return Ok(values[0])
        }
        Error(errorFactory())
    }

    /// Returns the only matching element as `Ok`, or an error unless exactly one element matches.
    func SingleOrError<E>(predicate: T -> bool, errorFactory: () -> E) -> Result<T, E> {
        val values = self.Where(predicate).Take(2).ToList()
        if values.Count == 1 {
            return Ok(values[0])
        }
        Error(errorFactory())
    }

    /// Returns the only element as `Ok`, distinguishing empty and multiple-element errors.
    func SingleOrError<E>(errorIfNone: () -> E, errorIfMany: () -> E) -> Result<T, E> {
        val values = self.Take(2).ToList()
        if values.Count == 1 {
            return Ok(values[0])
        }
        if values.Count == 0 {
            return Error(errorIfNone())
        }
        Error(errorIfMany())
    }

    /// Returns the only matching element as `Ok`, distinguishing no-match and multiple-match errors.
    func SingleOrError<E>(predicate: T -> bool, errorIfNone: () -> E, errorIfMany: () -> E) -> Result<T, E> {
        val values = self.Where(predicate).Take(2).ToList()
        if values.Count == 1 {
            return Ok(values[0])
        }
        if values.Count == 0 {
            return Error(errorIfNone())
        }
        Error(errorIfMany())
    }

    // -------------------------
    // ElementAt
    // -------------------------

    /// Returns the element at `index` as `Some`, or `None` when the index is out of range.
    func ElementAtOrNone(index: int) -> Option<T> {
        if index < 0 {
            return None
        }

        val values = self.Skip(index).Take(1).ToList()
        if values.Count == 1 {
            return Some(values[0])
        }

        None
    }

    /// Returns the element at `index` as `Ok`, or an error when the index is out of range.
    func ElementAtOrError<E>(index: int, errorFactory: () -> E) -> Result<T, E> {
        val opt = self.ElementAtOrNone(index)
        return opt match {
            Some(val v) => Ok(v)
            None => Error(errorFactory())
        }
    }

    // -------------------------
    // Materialization with exception capture
    // -------------------------

    /// Materializes the sequence as an array and captures any exception as an error.
    func ToArrayOrException() -> Result<T[], Exception> {
        try self.ToArray()
    }

    /// Materializes the sequence as an array and maps any exception to an error.
    func ToArrayOrError<E>(errorFactory: Exception -> E) -> Result<T[], E> {
        try {
            return Ok(self.ToArray())
        } catch (Exception ex) {
            return Error(errorFactory(ex))
        }
    }

    /// Materializes the sequence as a list and captures any exception as an error.
    func ToListOrException() -> Result<List<T>, Exception> {
        try self.ToList()
    }

    /// Materializes the sequence as a list and maps any exception to an error.
    func ToListOrError<E>(errorFactory: Exception -> E) -> Result<List<T>, E> {
        try {
            return Ok(self.ToList())
        } catch (Exception ex) {
            return Error(errorFactory(ex))
        }
    }

    /// Materializes the sequence as a hash set and captures any exception as an error.
    func ToHashSetOrException() -> Result<HashSet<T>, Exception> {
        try self.ToHashSet()
    }

    /// Materializes the sequence as a hash set and maps any exception to an error.
    func ToHashSetOrError<E>(errorFactory: Exception -> E) -> Result<HashSet<T>, E> {
        try {
            return Ok(self.ToHashSet())
        } catch (Exception ex) {
            return Error(errorFactory(ex))
        }
    }

    /// Materializes the sequence as a dictionary and captures any exception as an error.
    func ToDictionaryOrException<TKey>(keySelector: T -> TKey) -> Result<Dictionary<TKey, T>, Exception> {
        try self.ToDictionary(keySelector)
    }

    /// Materializes the sequence as a dictionary and maps any exception to an error.
    func ToDictionaryOrError<TKey, E>(
        keySelector: T -> TKey,
        errorFactory: Exception -> E
    ) -> Result<Dictionary<TKey, T>, E> {
        try {
            return Ok(self.ToDictionary(keySelector))
        } catch (Exception ex) {
            return Error(errorFactory(ex))
        }
    }

    /// Materializes projected elements as a dictionary and captures any exception as an error.
    func ToDictionaryOrException<TKey, TValue>(
        keySelector: T -> TKey,
        elementSelector: T -> TValue
    ) -> Result<Dictionary<TKey, TValue>, Exception> {
        try self.ToDictionary(keySelector, elementSelector)
    }

    /// Materializes projected elements as a dictionary and maps any exception to an error.
    func ToDictionaryOrError<TKey, TValue, E>(
        keySelector: T -> TKey,
        elementSelector: T -> TValue,
        errorFactory: Exception -> E
    ) -> Result<Dictionary<TKey, TValue>, E> {
        try {
            return Ok(self.ToDictionary(keySelector, elementSelector))
        } catch (Exception ex) {
            return Error(errorFactory(ex))
        }
    }
}
