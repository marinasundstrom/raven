<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <AssemblyName>Raven.Core</AssemblyName>
    <OutputType>Library</OutputType>
    <ImplicitUsings>false</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RavenEmitCoreTypesOnly>true</RavenEmitCoreTypesOnly>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GenerateXmlDocumentationFromMarkdownComments>true</GenerateXmlDocumentationFromMarkdownComments>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Error.rav" />
    <Compile Include="Option.rav" />
    <Compile Include="Parse.rav" />
    <Compile Include="Result.rav" />
    <Compile Include="TryGet.rav" />
    <Compile Include="LinqExtensions.rav" />
    <Compile Include="TopLevel.rav" />
    <Compile Include="UnionJsonConverter.rav" />
    <Compile Include="Union.rav" />
  </ItemGroup>
</Project>
