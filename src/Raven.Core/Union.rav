namespace System

import System.*
import System.Text.Json.Serialization.*

/// Represents a value that can contain one of two alternative types.
///
/// @typeparam T1 The first alternative type.
/// @typeparam T2 The second alternative type.
[JsonConverter(typeof(RavenParenthesizedUnionJsonConverterFactory))]
union Union<T1, T2>(T1 | T2)

/// Represents a value that can contain one of three alternative types.
///
/// @typeparam T1 The first alternative type.
/// @typeparam T2 The second alternative type.
/// @typeparam T3 The third alternative type.
[JsonConverter(typeof(RavenParenthesizedUnionJsonConverterFactory))]
union Union<T1, T2, T3>(T1 | T2 | T3)

/// Represents a value that can contain one of four alternative types.
///
/// @typeparam T1 The first alternative type.
/// @typeparam T2 The second alternative type.
/// @typeparam T3 The third alternative type.
/// @typeparam T4 The fourth alternative type.
[JsonConverter(typeof(RavenParenthesizedUnionJsonConverterFactory))]
union Union<T1, T2, T3, T4>(T1 | T2 | T3 | T4)

/// Represents a value that can contain one of five alternative types.
///
/// @typeparam T1 The first alternative type.
/// @typeparam T2 The second alternative type.
/// @typeparam T3 The third alternative type.
/// @typeparam T4 The fourth alternative type.
/// @typeparam T5 The fifth alternative type.
[JsonConverter(typeof(RavenParenthesizedUnionJsonConverterFactory))]
union Union<T1, T2, T3, T4, T5>(T1 | T2 | T3 | T4 | T5)
