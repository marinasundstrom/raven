namespace System

import System.*
import System.Collections.Generic.*
import System.Optional.*
import System.Result.*
import System.Text.Json.*
import System.Text.Json.Serialization.*

/// Represents either a successful value (`Ok`) or an expected failure (`Failure`).
/// Use `Result<T, E>` when the caller needs to act on a failure reason. For ordinary
/// absence without an error, use [Optional<T>](xref:T:System.Optional`1).
///
/// ## Handle cases with `if let ... else`
/// A booking accepts between one and six seats. Validation returns the accepted
/// count or an explanation that the form can display. The `if ... else` expression
/// constructs the result; an invalid request is an expected outcome.
///
/// ```raven
/// import System.*
/// import System.Result.*
///
/// func ValidateSeats(requested: int) -> Result<int, string> {
///     return if requested >= 1 && requested <= 6 {
///         Ok(requested)
///     } else {
///         Failure("Choose between 1 and 6 seats.")
///     }
/// }
///
/// let result = ValidateSeats(3)
/// if let Ok(seats) = result {
///     Console.WriteLine("Continue with ${seats} seats.")
/// } else {
///     Console.WriteLine("Correct the seat count before continuing.")
/// }
/// // Continue with 3 seats.
/// ```
///
/// `if let` binds `seats` only in the successful branch. The equivalent `is`
/// pattern is `if result is Ok(let seats) { ... } else { ... }`.
///
/// ## Handle both cases with `match`
/// A form needs the actual error message, not just a success flag. Use `match`
/// when each outcome contributes its own value. Both cases are handled explicitly.
///
/// ```raven
/// let feedback = ValidateSeats(0) match {
///     Ok(let seats) => "Ready to book ${seats} seats."
///     Failure(let message) => message
/// }
/// Console.WriteLine(feedback)
/// // Choose between 1 and 6 seats.
/// ```
///
/// ## Propagate `Failure` with `?`
/// A price calculation cannot continue with an invalid seat count. `?` extracts
/// the value from `Ok`, or immediately returns the existing `Failure` from
/// `CalculateTotal`. The error message is preserved. The final `Ok` wraps the
/// calculated total; `?` does not wrap successful return values automatically.
///
/// ```raven
/// func CalculateTotal(requested: int) -> Result<int, string> {
///     let seats = ValidateSeats(requested)?
///     Ok(seats * 25)
/// }
///
/// let total = CalculateTotal(3) // Ok(75)
/// let invalid = CalculateTotal(0) // Failure("Choose between 1 and 6 seats.")
/// Console.WriteLine(total.UnwrapOr(0))
/// if invalid is Failure(let message) {
///     Console.WriteLine(message)
/// } else {
///     Console.WriteLine("Booking can continue.")
/// }
/// // 75
/// // Choose between 1 and 6 seats.
/// ```
///
/// Use `?` when this function cannot recover and its caller should receive the
/// failure. Branch or match when you need to display, recover from, or translate it.
///
/// ## Propagate different error types with `?`
/// Validation and payment can have different error contracts. An ad-hoc union in
/// `Result<int, SeatError | PaymentError>` lets the booking operation preserve either
/// error without converting it to a string or introducing another error wrapper.
/// This example uses an explicit payment decision so both outcomes are easy to try.
///
/// ```raven
/// record SeatError(val Message: string)
/// record PaymentError(val Message: string)
///
/// func ReserveSeats(requested: int) -> Result<int, SeatError> {
///     return if requested >= 1 && requested <= 6 {
///         Ok(requested)
///     } else {
///         Failure(SeatError("Choose between 1 and 6 seats."))
///     }
/// }
///
/// func Charge(amount: int, approved: bool) -> Result<int, PaymentError> {
///     return if approved {
///         Ok(amount)
///     } else {
///         Failure(PaymentError("Payment declined."))
///     }
/// }
///
/// func Book(requested: int, approved: bool) -> Result<int, SeatError | PaymentError> {
///     let seats = ReserveSeats(requested)?
///     let paid = Charge(seats * 25, approved)?
///     Ok(paid)
/// }
///
/// let confirmation = Book(2, false) match {
///     Ok(let paid) => "Booked for ${paid}."
///     Failure(SeatError error) => "Update your request: ${error.Message}"
///     Failure(PaymentError error) => "Try another payment method: ${error.Message}"
/// }
/// Console.WriteLine(confirmation)
/// // Try another payment method: Payment declined.
/// ```
///
/// Each `?` returns its original error through the enclosing result's error union.
/// There is still one `Failure` case: its payload is either a `SeatError` or a
/// `PaymentError`, and the typed patterns distinguish them. `Book(0, true)` returns
/// a seat error before calling `Charge`; `Book(2, true)` returns `Ok(50)`.
/// Use a dedicated error union instead when you want a single named domain contract.
///
/// @typeparam T The successful value type.
/// @typeparam E The error value type.
[JsonConverter(typeof(ResultJsonConverterFactory))]
public union Result<T, E>: IPropagatable<Result<T, E>, T, E> {
    /// Represents a successful result value.
    case Ok(T)

    /// Represents an error result.
    case Failure(E)

    /// Attempts to extract the successful output used by the propagation protocol.
    func TryGetOutput(out output: T) -> bool {
        output = default
        if self is Ok(val value) {
            output = value
            return true
        }
        return false
    }

    /// Attempts to extract the residual used by the propagation protocol.
    func TryGetResidual(out residual: E) -> bool {
        residual = default
        if self is Failure(val error) {
            residual = error
            return true
        }
        return false
    }

    /// Constructs an error result from a propagated residual.
    static func FromResidual(residual: E) -> Result<T, E> => Failure(residual)

    /// Gets a value indicating whether this result is `Ok`.
    val HasOk: bool => self is Ok(val message)

    /// Gets a value indicating whether this result is `Failure`.
    val HasError: bool => self is Failure(val message)

    /// Gets the successful value as an option.
    val IsOk: Optional<T> {
        get {
            self match {
                Ok(val value) => Some(value)
                Failure(_) => None
            }
        }
    }

    /// Gets the error value as an option.
    val IsError: Optional<E> {
        get {
            self match {
                Failure(val e) => Some(e)
                Ok(_) => None
            }
        }
    }

    /// Projects the value inside `Ok` using `mapper`. `Failure` stays `Failure`.
    func Map<TResult>(mapper: T -> TResult) -> Result<TResult, E> {
        self match {
            Ok(val value) => Ok(mapper(value))
            Failure(val error) => Failure(error)
        }
    }

    /// Monadic bind / flatMap: chains a `Result`-producing function.
    func Then<TResult>(binder: T -> Result<TResult, E>) -> Result<TResult, E> {
        self match {
            Ok(val value) => binder(value)
            Failure(val error) => Failure(error)
        }
    }

    /// Maps the error channel.
    func MapError<E2>(mapper: E -> E2) -> Result<T, E2> {
        self match {
            Ok(val value) => Ok(value)
            Failure(val error) => Failure(mapper(error))
        }
    }

    /// Matches the result and produces a value.
    func Match<TResult>(ok: T -> TResult, error: E -> TResult) -> TResult {
        self match {
            Ok(val value) => ok(value)
            Failure(val e) => error(e)
        }
    }

    /// Runs `action` if this is `Ok`, returning the original result.
    func Tap(action: T -> ()) -> Result<T, E> {
        self match {
            Ok(val value) => {
                action(value)
                Ok(value)
            }
            Failure(val e) => Failure(e)
        }
    }

    /// Runs `action` if this is `Failure`, returning the original result.
    func TapError(action: E -> ()) -> Result<T, E> {
        self match {
            Ok(val value) => Ok(value)
            Failure(val e) => {
                action(e)
                Failure(e)
            }
        }
    }

    /// Recovers from an error by mapping it to a new result.
    func OrElse(recover: E -> Result<T, E>) -> Result<T, E> {
        self match {
            Ok(val value) => Ok(value)
            Failure(val e) => recover(e)
        }
    }

    /// Unwrap the value if Ok, otherwise return the value from `factory()`.
    func UnwrapOrElse(factory: () -> T) -> T {
        self match {
            Ok(val value) => value
            Failure(_) => factory()
        }
    }

    /// Converts `Ok(x)` to a single-item sequence and `Failure` to an empty sequence.
    func ToEnumerable() -> IEnumerable<T> {
        val list = List<T>()
        if self is Ok(val value) {
            list.Add(value)
        }
        list
    }

    /// Returns an enumerator over the zero-or-one successful values.
    func GetEnumerator() -> IEnumerator<T> {
        self.ToEnumerable().GetEnumerator()
    }
    
    /// Returns the successful value, or the default value for an error.
    func UnwrapOrDefault() -> T {
        if self is Ok(val value) {
            return value
        }
        default
    }

    /// Returns the successful value, or throws for an error.
    func UnwrapOrThrow() -> T {
        var error: E = default
        if self is Ok(val value) {
            return value
        } else if self is Failure(val error2) {
            error = error2
        }
        throw InvalidOperationException(error.ToString())
    }

    /// Returns the successful value, or `defaultValue` for an error.
    func UnwrapOr(defaultValue: T) -> T {
        if self is Ok(val value) {
            return value
        }
        defaultValue
    }

    /// Returns the error value, or throws when this result is `Ok`.
    func UnwrapError() -> E {
        if self is Failure(val message) {
            return message
        }
        throw InvalidOperationException("Result is not Failure")
    }
}

/// Converts `Result` values to and from tagged JSON objects.
public class ResultJsonConverter<T, E> : JsonConverter<Result<T, E>> {

    /// Reads a tagged JSON object as an `Ok` or `Failure` result.
    override func Read(reader: &Utf8JsonReader, typeToConvert: Type, options: JsonSerializerOptions) -> Result<T, E> {
        use doc = JsonDocument.ParseValue(reader)
        val root = doc.RootElement

        val @case = root.GetProperty("case").GetString()

        return @case match {
            "Ok" => {
                val payload = JsonSerializer.Deserialize<T>(root.GetProperty("value"), options)
                val result: Result<T, E> = Ok(payload)
                result
            }
            "Failure" => {
                val payload = JsonSerializer.Deserialize<E>(root.GetProperty("data"), options)
                val result: Result<T, E> = Failure(payload)
                result
            }
            _ => {
                val fallback: Result<T, E> = Failure(default(E))
                fallback
            }
        }
    }

    /// Writes a result as a tagged JSON object.
    override func Write(writer: Utf8JsonWriter, value: Result<T, E>, options: JsonSerializerOptions) -> () {
        if value is Ok(val okValue) {
            writer.WriteStartObject()
            writer.WriteString("case", "Ok")
            writer.WritePropertyName("value")
            JsonSerializer.Serialize(writer, okValue, options)
            writer.WriteEndObject()
        } else if value is Failure(val errorData) {
            writer.WriteStartObject()
            writer.WriteString("case", "Failure")
            writer.WritePropertyName("data")
            JsonSerializer.Serialize(writer, errorData, options)
            writer.WriteEndObject()
        } else {
            writer.WriteNullValue()
        }
    }
}

/// Creates JSON converters for constructed `Result` types.
public class ResultJsonConverterFactory : JsonConverterFactory {

    /// Determines whether the specified type is a `Result` type.
    override func CanConvert(typeToConvert: Type) -> bool {
        return typeToConvert.IsGenericType
            && typeToConvert.GetGenericTypeDefinition() == typeof(Result<,>)
    }

    /// Creates a converter for the specified constructed `Result` type.
    override func CreateConverter(typeToConvert: Type, options: JsonSerializerOptions) -> JsonConverter? {
        val tArgs = typeToConvert.GetGenericArguments()
        val converterType = typeof(ResultJsonConverter<,>).MakeGenericType([tArgs[0], tArgs[1]])
        return (JsonConverter)(
            Activator.CreateInstance(converterType)
                ?? throw InvalidOperationException("Could not create JsonConverter"))
    }
}

/// Provides contextual error operations for results whose error implements `IError`.
public extension ResultErrorContextExtensions<T, E: IError> for Result<T, E> {
    /// Wraps only the error channel with operation context. The original typed
    /// error is preserved as the contextual error's cause.
    func WithContext(message: string) -> Result<T, ContextError<E>> {
        self.MapError(error => error.WithContext(message))
    }
}
