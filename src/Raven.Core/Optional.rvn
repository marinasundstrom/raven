/// Core Raven value contracts, including Optional and Result, alongside extensions
/// that integrate these contracts with ordinary .NET APIs.
namespace System

import System.*
import System.Collections.Generic.*
import System.Optional.*
import System.Result.*
import System.Text.Json.*
import System.Text.Json.Serialization.*

/// Represents an available value (`Some`) or meaningful absence (`None`).
/// Use `Optional<T>` when having no value is an ordinary outcome. Use
/// [Result<T, E>](xref:T:System.Result`2) when the caller needs a reason for failure.
///
/// ## Handle cases with `if ... else`
/// A profile form can leave its nickname field blank. This function trims the
/// input and makes that absence explicit instead of using an empty string as a
/// special value. The `if ... else` expression produces the optional value.
///
/// ```raven
/// import System.*
/// import System.Optional.*
///
/// func ReadNickname(input: string) -> Optional<string> {
///     let name = input.Trim()
///     return if name.Length == 0 {
///         None
///     } else {
///         Some(name)
///     }
/// }
///
/// let nickname = ReadNickname(" Ada ")
/// if nickname is Some(let displayName) {
///     Console.WriteLine("Welcome, ${displayName}!")
/// } else {
///     Console.WriteLine("Welcome, guest!")
/// }
/// // Welcome, Ada!
/// ```
///
/// `Some(let displayName)` both checks the case and binds its value. `displayName` is available
/// only in the successful branch; the `else` branch handles `None`.
///
/// ## Extract a value or use a fallback with `if let`
/// Continuing the profile example, a heading needs a string in both cases.
/// An `if let` expression binds the nickname when present and supplies a fallback
/// when absent. Both branches compute the heading rather than performing an action.
///
/// ```raven
/// let heading = if let Some(profileName) = ReadNickname("   ") {
///     "Profile: ${profileName}"
/// } else {
///     "Guest profile"
/// }
/// Console.WriteLine(heading)
/// // Guest profile
/// ```
///
/// ## Propagate `None` with `?`
/// A profile handle can be created only when a nickname exists. Here `?` extracts
/// the string from `Some`, or immediately returns `None` from `CreateHandle`.
/// The remaining code runs only when there is a name. Wrap the final value in
/// `Some` to return a successful optional result.
///
/// ```raven
/// func CreateHandle(input: string) -> Optional<string> {
///     let name = ReadNickname(input)?
///     Some("@${name.ToLowerInvariant()}")
/// }
///
/// let handle = CreateHandle(" Ada ") // Some("@ada")
/// let missing = CreateHandle("   ") // None
/// Console.WriteLine(handle.UnwrapOr("guest"))
/// Console.WriteLine(missing.UnwrapOr("guest"))
/// // @ada
/// // guest
/// ```
///
/// Choose an explicit branch when this function should provide a fallback or take
/// a different action. Use `?` when absence should remain absence for its caller.
/// A `match` expression is also available when you want to handle both cases
/// exhaustively.
///
/// @typeparam T The type of the optional value.
[JsonConverter(typeof(OptionalJsonConverterFactory))]
public union Optional<T>: IPropagatable<Optional<T>, T, ()> {
    /// Represents an available value.
    case Some(T)

    /// Represents the absence of a value.
    case None

    /// Attempts to extract the successful output used by the propagation protocol.
    func TryGetOutput(out output: T) -> bool {
        output = default
        if self is Some(val value) {
            output = value
            return true
        }
        return false
    }

    /// Reports absence as the unit residual used by the propagation protocol.
    func TryGetResidual(out residual: ()) -> bool {
        residual = ()
        self is None
    }

    /// Constructs an empty option from a propagated residual.
    static func FromResidual(residual: ()) -> Optional<T> => None

    /// Gets a value indicating whether this option is `Some`.
    val HasSome: bool => self is Some(val v)

    /// Gets a value indicating whether this option is `None`.
    val HasNone: bool => self is None

    /// Projects the value inside `Some` using `mapper`. `None` stays `None`.
    func Map<TResult>(mapper: T -> TResult) -> Optional<TResult> {
        self match {
            Some(val value) => Some(mapper(value))
            None => None
        }
    }

    /// Monadic bind / flatMap: chains an `Optional`-producing function.
    func Then<TResult>(binder: T -> Optional<TResult>) -> Optional<TResult> {
        self match {
            Some(val value) => binder(value)
            None => None
        }
    }

    /// Keeps the value only if `predicate` returns true.
    func Where(predicate: T -> bool) -> Optional<T> {
        self match {
            Some(val value) => if predicate(value) { Some(value) } else { None }
            None => None
        }
    }

    /// Alias for `Where`.
    func Filter(predicate: T -> bool) -> Optional<T> {
        self.Where(predicate)
    }

    /// Returns this option if it is `Some`, otherwise returns `alternative()`.
    func OrElse(alternative: () -> Optional<T>) -> Optional<T> {
        self match {
            Some(val value) => Some(value)
            None => alternative()
        }
    }

    /// Returns the contained value or evaluates `factory()`.
    func UnwrapOrElse(factory: () -> T) -> T {
        self match {
            Some(val value) => value
            None => factory()
        }
    }

    /// Matches the option and produces a value.
    func Match<TResult>(some: T -> TResult, none: () -> TResult) -> TResult {
        self match {
            Some(val value) => some(value)
            None => none()
        }
    }

    /// Runs `action` if this is `Some`, returning the original option.
    func Tap(action: T -> ()) -> Optional<T> {
        self match {
            Some(val value) => {
                action(value)
                Some(value)
            }
            None => None
        }
    }

    /// Runs `action` if this is `None`, returning the original option.
    func TapNone(action: () -> ()) -> Optional<T> {
        self match {
            Some(val value) => Some(value)
            None => {
                action()
                None
            }
        }
    }

    /// Converts `Some(x)` to a single-item sequence and `None` to an empty sequence.
    func ToEnumerable() -> IEnumerable<T> {
        val list = List<T>()
        if self is Some(val value) {
            list.Add(value)
        }
        list
    }

    /// Returns an enumerator over the zero-or-one contained values.
    func GetEnumerator() -> IEnumerator<T> {
        self.ToEnumerable().GetEnumerator()
    }

    /// Bridges `Optional` into a `Result`-producing pipeline.
    /// If this is `None`, returns `Failure(noneError())`.
    func ThenResult<TResult, E>(binder: T -> Result<TResult, E>, noneError: () -> E) -> Result<TResult, E> {
        self match {
            Some(val value) => binder(value)
            None => Failure(noneError())
        }
    }

    /// Maps the contained value into a `Result`. If this is `None`, returns `Failure(noneError())`.
    func MapResult<TResult, E>(mapper: T -> TResult, noneError: () -> E) -> Result<TResult, E> {
        self match {
            Some(val value) => Ok(mapper(value))
            None => Failure(noneError())
        }
    }

    /// Converts this option into a result, using `error` when it is `None`.
    func OkOr<E>(error: E) -> Result<T, E> {
        if self is Some(val value) {
            return Ok(value)
        }
        Failure(error)
    }

    /// Converts this option into a result, evaluating `errorFactory` when it is `None`.
    func OkOr<E>(errorFactory: () -> E) -> Result<T, E> {
        if self is Some(val value) {
            return Ok(value)
        }
        Failure(errorFactory())
    }

    /// Returns the contained value, or the default value when this option is `None`.
    func UnwrapOrDefault() -> T {
        if self is Some(val value) {
            return value
        }
        return default(T)
    }

    /// Returns the contained value, or throws when this option is `None`.
    func UnwrapOrThrow() -> T {
        if self is Some(val value) {
            return value
        }
        throw InvalidOperationException("Optional is None")
    }

    /// Returns the contained value, or `defaultValue` when this option is `None`.
    func UnwrapOr(defaultValue: T) -> T {
        if self is Some(val value) {
            return value
        }
        defaultValue
    }

}

/// Defines nullable-reference conversions for `Optional`.
public extension OptionalExtensions1<T : class> for Optional<T> {
    /// Converts an option to its nullable reference representation.
    static func implicit(opt: Optional<T>) -> T? {
        if opt is Some(val value) {
            return value
        }
        return null
    }

    /// Converts a nullable reference to `Some`, or to `None` when it is `null`.
    static func implicit(value: T?) -> Optional<T> {
        if let present: T = value {
            return Optional<T>.Some(present)
        }
        None
    }
}

/// Defines nullable-value conversions for `Optional`.
public extension OptionalExtensions2<T : struct> for Optional<T> {
    /// Converts an option to its nullable value representation.
    static func implicit(opt: Optional<T>) -> T? {
        if opt is Some(val value) {
            return value
        }
        return null
    }

    /// Converts a nullable value to `Some`, or to `None` when it is `null`.
    static func implicit(value: T?) -> Optional<T> {
        if let present: T = value {
            return Optional<T>.Some(present)
        }
        None
    }
}

/// Converts `Optional` values to and from their natural JSON value representation.
public class OptionalJsonConverter<T> : JsonConverter<Optional<T>> {

    /// Gets whether the converter handles JSON `null` directly.
    override val HandleNull: bool { get; } = true

    /// Reads `null` as `None` and any other JSON value as `Some`.
    override func Read(reader: &Utf8JsonReader, typeToConvert: Type, options: JsonSerializerOptions) -> Optional<T> {
        use doc = JsonDocument.ParseValue(reader)
        val root = doc.RootElement

        if root.ValueKind == JsonValueKind.Null {
            val none: Optional<T> = None
            return none
        }

        val payload = JsonSerializer.Deserialize<T>(root, options)
        val some: Optional<T> = Some(payload)
        some
    }

    /// Writes `Some` as its contained value and `None` as JSON `null`.
    override func Write(writer: Utf8JsonWriter, value: Optional<T>, options: JsonSerializerOptions) -> () {
        if value is Some(val someValue) {
            JsonSerializer.Serialize(writer, someValue, options)
        } else {
            writer.WriteNullValue()
        }
    }
}

/// Creates JSON converters for constructed `Optional` types.
public class OptionalJsonConverterFactory : JsonConverterFactory {

    /// Determines whether the specified type is an `Optional` type.
    override func CanConvert(typeToConvert: Type) -> bool {
        return typeToConvert.IsGenericType
            && typeToConvert.GetGenericTypeDefinition() == typeof(Optional<>)
    }

    /// Creates a converter for the specified constructed `Optional` type.
    override func CreateConverter(typeToConvert: Type, options: JsonSerializerOptions) -> JsonConverter? {
        val tArg = typeToConvert.GetGenericArguments()[0]
        val converterType = typeof(OptionalJsonConverter<>).MakeGenericType([tArg])
        return (JsonConverter)(
            Activator.CreateInstance(converterType)
                ?? throw InvalidOperationException("Could not create JsonConverter"))
    }
}

/// Provides operations for nested options.
public extension OptionalExtensionsNested<T> for Optional<Optional<T>> {

    /// Flattens `Optional<Optional<T>>` into `Optional<T>`.
    func Flatten() -> Optional<T> {
        self match {
            Some(val inner) => inner
            None => None
        }
    }
}
