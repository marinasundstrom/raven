namespace Raven.Macros

import System.*
import System.Globalization.*
import System.Security.Cryptography.*
import System.Text.*
import Raven.CodeAnalysis.Macros.*

/// Computes the SHA-256 digest of a literal value during compilation.
///
/// Import `Raven.Macros.*` to invoke the conventional `sha256Digest!` alias.
/// The canonical `Raven.Macros.Sha256Digest!` spelling remains available when
/// the alias is shadowed or the namespace is not imported. The `Digest` suffix
/// distinguishes the macro from .NET hashing types such as `SHA256`.
///
/// String and character values are hashed as UTF-8. Boolean and numeric values
/// use their culture-invariant textual representation, and `null` hashes an
/// empty byte sequence. The macro expands to a lowercase hexadecimal string
/// literal, so no hashing occurs at runtime.
///
/// ## Example
///
/// ```raven
/// import Raven.Macros.*
///
/// let digest = sha256Digest!("hello")
/// ```
[Raven.CodeAnalysis.Macros.MacroAlias("sha256Digest")]
public macro Sha256Digest(
    value: Raven.CodeAnalysis.Syntax.ExpressionSyntax,
    context: FreestandingMacroContext
) {
    let argument = context.Arguments[0]
    if !argument.HasValue {
        expand FreestandingMacroExpansionResult.FromDiagnostic(
            context.CreateArgumentDiagnostic(
                argument,
                "The sha256Digest macro requires a literal string, character, Boolean, numeric, or null value.",
                code: "SHA256001"))
    }

    let constant = argument.Value
    var canonicalText: string? = null
    if constant is null {
        canonicalText = ""
    } else if constant is string stringValue {
        canonicalText = stringValue
    } else if constant is char character {
        canonicalText = character.ToString()
    } else if constant is bool boolean {
        canonicalText = if boolean { "true" } else { "false" }
    } else if constant is float single {
        canonicalText = single.ToString("R", CultureInfo.InvariantCulture)
    } else if constant is double doubleValue {
        canonicalText = doubleValue.ToString("R", CultureInfo.InvariantCulture)
    } else if constant is decimal decimalValue {
        canonicalText = decimalValue.ToString("G29", CultureInfo.InvariantCulture)
    } else if constant is IFormattable formattable {
        canonicalText = formattable.ToString(null, CultureInfo.InvariantCulture)
    }

    if canonicalText is string canonicalValue {
        let bytes = Encoding.UTF8.GetBytes(canonicalValue)
        let digest = Convert.ToHexStringLower(SHA256.HashData(bytes))
        expand FreestandingMacroExpansionResult.FromExpression(
            MacroSyntax.StringLiteral(digest))
    }

    expand FreestandingMacroExpansionResult.FromDiagnostic(
        context.CreateArgumentDiagnostic(
            argument,
            "The sha256Digest macro requires a literal string, character, Boolean, numeric, or null value.",
            code: "SHA256001"))
}
