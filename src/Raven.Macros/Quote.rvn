namespace Raven.Macros

/// Quotes a Raven expression as an immutable Raven syntax tree.
///
/// Import `Raven.Macros.*` to invoke the conventional `quote!` alias. The
/// canonical `Raven.Macros.Quote!` spelling remains available when the alias
/// is shadowed or the namespace is not imported.
///
/// The resulting value is rooted in Raven's
/// [syntax-tree API](https://marinasundstrom.github.io/raven/compiler/api/syntax-tree.html).
/// Use that reference when inspecting, constructing, or transforming quoted
/// syntax.
///
/// ## Example
///
/// ```raven
/// import Raven.Macros.*
///
/// let syntax = quote! {
///     left + right
/// }
/// ```
[Raven.CodeAnalysis.Macros.MacroAlias("quote")]
public macro Quote(context: Raven.CodeAnalysis.Macros.TokenTreeMacroContext) {
    expand Raven.CodeAnalysis.Macros.StandardMacroExpansions.ExpandQuote(context)
}
