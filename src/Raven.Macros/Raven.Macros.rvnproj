<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <AssemblyName>Raven.Macros</AssemblyName>
    <OutputType>Library</OutputType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GenerateMarkdownDocumentationFile>true</GenerateMarkdownDocumentationFile>
    <GenerateXmlDocumentationFromMarkdownComments>true</GenerateXmlDocumentationFromMarkdownComments>
    <RavenCompilerHost Condition="'$(RavenCompilerHost)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\Raven.Compiler\bin\$(Configuration)\$(TargetFramework)\rvnc.dll'))</RavenCompilerHost>
  </PropertyGroup>

  <ItemGroup>
    <RavenCompile Include="AssemblyInfo.rvn" />
    <RavenCompile Include="Compile.rvn" />
    <RavenCompile Include="EmbedFileContent.rvn" />
    <RavenCompile Include="Quote.rvn" />
    <RavenCompile Include="Sha256Digest.rvn" />
    <ProjectReference Include="../Raven.CodeAnalysis/Raven.CodeAnalysis.csproj"
                      PrivateAssets="all" />
    <ProjectReference Include="../Raven.Compiler/Raven.Compiler.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all"
                      AdditionalProperties="UseRavenCoreReference=false" />
  </ItemGroup>
</Project>
