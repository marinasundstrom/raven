<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <PublishTrimmed>false</PublishTrimmed>
    <PlaygroundRuntimePackVersion>11.0.0-preview.7.26381.103</PlaygroundRuntimePackVersion>
    <RuntimeFrameworkVersion>$(PlaygroundRuntimePackVersion)</RuntimeFrameworkVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0-preview.7.26381.103" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="11.0.0-preview.7.26381.103" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Raven.Playground.Worker\Raven.Playground.Worker.csproj" />
    <ProjectReference Include="..\Raven.Core\Raven.Core.rvnproj"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Raven.Macros\Raven.Macros.rvnproj"
                      ReferenceOutputAssembly="false" />
    <Reference Include="Raven.Core"
               HintPath="..\Raven.Core\bin\$(Configuration)\net11.0\Raven.Core.dll"
               Private="true"
               ExternallyResolved="true" />
    <Reference Include="Raven.Macros"
               HintPath="..\Raven.Macros\bin\$(Configuration)\net11.0\Raven.Macros.dll"
               Private="true"
               ExternallyResolved="true" />
  </ItemGroup>

  <ItemGroup>
    <PlaygroundDocumentationSnippet Include="../../docs/**/snippets/**/*.rvn" />
    <Content Remove="wwwroot/snippets/**" />
    <Content Include="wwwroot/snippets/index.json" />
    <Content Include="@(PlaygroundDocumentationSnippet->'wwwroot/snippets/%(Filename)%(Extension)')" />
  </ItemGroup>

  <Target Name="PreparePlaygroundStaticAssets" BeforeTargets="PrepareForBuild">
    <MakeDir Directories="$(MSBuildProjectDirectory)/wwwroot/snippets" />
    <Copy SourceFiles="../../docs/snippets/index.json"
          DestinationFiles="$(MSBuildProjectDirectory)/wwwroot/snippets/index.json"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(PlaygroundDocumentationSnippet)"
          DestinationFolder="$(MSBuildProjectDirectory)/wwwroot/snippets"
          SkipUnchangedFiles="true" />
    <Exec Command="npm ci --no-audit --no-fund"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          Condition="!Exists('$(MSBuildProjectDirectory)/node_modules/monaco-editor/package.json')" />
    <Exec Command="npm run build" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

</Project>
