union PercentageError {
    case OutOfRange(value: int)
}

record struct Percentage private (Value: int) {
    static func Create(value: int) -> Result<Percentage, PercentageError> =>
        value match {
            0..100 => Ok(Percentage(value))
            _ => Error(.OutOfRange(value))
        }
}

record struct ClimateRange(
    Minimum: decimal,
    Maximum: decimal,
    MaximumHumidity: Percentage)

record struct ClimateReading(
    Temperature: decimal,
    Humidity: Percentage)

enum ClimateStatus {
    TooCold
    Healthy
    TooHot
    TooHumid
}

func Evaluate(desired: ClimateRange, reading: ClimateReading) -> ClimateStatus {
    if reading.Humidity.Value > desired.MaximumHumidity.Value {
        return .TooHumid
    }

    if desired.Minimum > reading.Temperature {
        return .TooCold
    }

    if reading.Temperature > desired.Maximum {
        return .TooHot
    }

    return .Healthy
}

func ObserveClimate(
    read: () -> Result<ClimateReading, PercentageError>,
    evaluate: (ClimateReading) -> ClimateStatus,
    publish: (ClimateStatus) -> ()) -> Result<ClimateStatus, PercentageError> {
    let reading = read()?
    let status = evaluate(reading)
    publish(status)
    return Ok(status)
}

class GreenhouseDevice(
    val DeviceId: string,
    val Temperature: decimal,
    val HumidityPercent: int) {

    func ReadClimate() -> Result<ClimateReading, PercentageError> {
        let humidity = Percentage.Create(HumidityPercent)?
        return Ok(ClimateReading(Temperature, humidity))
    }
}

func CheckDevice(device: GreenhouseDevice) -> Result<ClimateStatus, PercentageError> {
    let maximumHumidity = Percentage.Create(75)?
    let desired = ClimateRange(18m, 26m, maximumHumidity)

    return ObserveClimate(
        read: () => device.ReadClimate(),
        evaluate: reading => Evaluate(desired, reading),
        publish: status => Console.WriteLine("${device.DeviceId}: $status"))
}

func Report(device: GreenhouseDevice) {
    match CheckDevice(device) {
        Ok(let status) => Console.WriteLine("Recorded status: $status")
        Error(let error) =>
            Console.WriteLine("${device.DeviceId}: ${Describe(error)}")
    }
}

func Describe(error: PercentageError) -> string {
    return error match {
        .OutOfRange(let value) => "rejected humidity $value%"
    }
}

Report(GreenhouseDevice("greenhouse-west", 24.5m, 82))
Report(GreenhouseDevice("greenhouse-east", 22m, 108))
