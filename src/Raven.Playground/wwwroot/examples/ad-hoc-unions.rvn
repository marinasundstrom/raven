// An ad-hoc union combines existing types without declaring a named union.
func Describe(value: int | string | bool) -> string {
    return value match {
        int number => "number: $number"
        string text => "text: $text"
        bool flag => "flag: $flag"
    }
}

let count: int | string | bool = 42
let state: int | string | bool = "ready"
let enabled: int | string | bool = true

Console.WriteLine(Describe(count))
Console.WriteLine(Describe(state))
Console.WriteLine(Describe(enabled))
