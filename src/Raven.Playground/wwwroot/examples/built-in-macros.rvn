import System.*
import System.Console.*
import System.Linq.*
import Raven.CodeAnalysis.Syntax.*
import Raven.Macros.*

// Raven.Macros is experimental while the macro system evolves.
#[Error]
union ParseError {
    #[ErrorMessage("Invalid value: $value")]
    case InvalidValue(value: string)
}

let projected = query! {
    from value in [1, 2, 3, 4]
    where value > 2
    select value * 10
}

let expression: ExpressionSyntax = quote! {
    projected.Sum() + 2
}

let error: IError = ParseError.InvalidValue("age")

WriteLine("Query total: ${projected.Sum()}")
WriteLine(error.Message)
WriteLine("Quoted Raven: ${expression.ToFullString()}")
