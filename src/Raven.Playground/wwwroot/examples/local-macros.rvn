import System.Collections.Immutable.*
import System.Console.*
import Raven.CodeAnalysis.Macros.*
import Raven.CodeAnalysis.Syntax.*
import Raven.CodeAnalysis.Syntax.SyntaxFactory.*

[LocalMacro]
class PlaygroundMacros : IRavenMacroPlugin {
    val Name: string => "Playground macros"

    func GetMacros() -> ImmutableArray<IMacroDefinition>
        => [AddGreetingMacro(), TwiceMacro(), UnlessMacro()]
}

[LocalMacro]
class AddGreetingMacro : IAttachedDeclarationMacro {
    val Name: string => "AddGreeting"
    val Kind: MacroKind => MacroKind.AttachedDeclaration
    val Targets: MacroTarget => MacroTarget.Type

    func Expand(context: AttachedMacroContext) -> MacroExpansionResult {
        let tree = ParseSyntaxTree(
            "class Generated { func Greeting() -> string => \"Hello from an attached macro\" }")
        let container: ClassDeclarationSyntax = tree.GetRoot().Members[0] else {
            return MacroExpansionResult.Empty
        }
        let method: MethodDeclarationSyntax = container.Members[0] else {
            return MacroExpansionResult.Empty
        }

        MacroExpansionResult {
            IntroducedMembers = [method]
        }
    }
}

[LocalMacro]
class TwiceMacro : IFreestandingExpressionMacro {
    val Name: string => "twice"
    val Kind: MacroKind => MacroKind.FreestandingExpression
    val Targets: MacroTarget => MacroTarget.None
    val AcceptsArguments: bool => true

    func Expand(context: FreestandingMacroContext) -> FreestandingMacroExpansionResult {
        if context.Arguments.Length != 1 {
            return FreestandingMacroExpansionResult.Empty
        }

        FreestandingMacroExpansionResult.FromExpression(
            #quote {
                #(context.Arguments[0].Expression) * 2
            }
        )
    }
}

[LocalMacro]
class UnlessMacro : ITokenTreeExpressionMacro {
    val Name: string => "unless"
    val Kind: MacroKind => MacroKind.FreestandingExpression
    val Targets: MacroTarget => MacroTarget.None

    func Expand(context: TokenTreeMacroContext) -> FreestandingMacroExpansionResult {
        let condition = context.ParseExpression()

        FreestandingMacroExpansionResult.FromExpression(
            #quote {
                !#(condition)
            }
        )
    }
}

#[AddGreeting]
class Greeter {}

let answer = #twice(21)
let shouldContinue = #unless {
    answer == 0
}

WriteLine(Greeter().Greeting())
WriteLine("Twice 21 is $answer")
WriteLine("Should continue: $shouldContinue")
