import System.Console.*
import Raven.CodeAnalysis.Macros.*
import Raven.CodeAnalysis.Syntax.*
import Raven.Macros.*

// Parenthesized invocation arguments can use typed syntax contracts. The
// caller supplies an ordinary Raven expression, not an evaluated value.
macro Twice(value: ExpressionSyntax<int>) -> ExpressionSyntax<int> {
    expand quote! {
        #(value.Syntax) * 2
    }
}

let answer = Twice!(21)

WriteLine("Twice 21 is $answer")
