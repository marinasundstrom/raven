namespace Raven.CodeAnalysis

import System.*
import System.Collections.Generic.*
import System.Collections.Immutable.*
import Raven.CodeAnalysis.Syntax.*

internal static class AttributeDataFactory {
    internal static func TryCreateTypedConstant(expression: BoundExpression, out constant: TypedConstant) -> bool {
        if TryCreateTypedConstantCore(expression, out constant) {
            return constant.Kind != TypedConstantKind.Error
        }
        constant = TypedConstant.CreateError(expression.Type)
        return false
    }

    internal static func Create(boundExpression: BoundExpression?, attribute: AttributeSyntax) -> AttributeData? {
        if boundExpression is not BoundObjectCreationExpression creation ||
            creation.Constructor is not MethodSymbol ctor ||
            ctor.ContainingType is not NamedTypeSymbol attributeType {
            return null
        }
        let argumentConstants = ImmutableArray.CreateBuilder<TypedConstant>()
        let namedArguments = ImmutableArray.CreateBuilder<KeyValuePair<string, TypedConstant>>()
        for argument in creation.Arguments {
            argumentConstants.Add(CreateTypedConstant(argument))
        }
        if let initializer: BoundObjectInitializer = creation.Initializer {
            for entry in initializer.Entries {
                if entry is not BoundObjectInitializerAssignmentEntry assignment {
                    continue
                }
                match assignment.Member {
                    PropertySymbol property => {
                        let constant = CreateTypedConstant(assignment.Value).WithType(property.Type)
                        namedArguments.Add(KeyValuePair<string, TypedConstant>(property.Name, constant))
                    }
                    FieldSymbol @field => {
                        let constant = CreateTypedConstant(assignment.Value).WithType(@field.Type)
                        namedArguments.Add(KeyValuePair<string, TypedConstant>(@field.Name, constant))
                    }
                    _ => {
                    }
                }
            }
        }
        return AttributeData(attributeType, ctor, argumentConstants.ToImmutable(),
            namedArguments.ToImmutable(), attribute.GetReference())
    }

    internal static func CreateTypedConstant(expression: BoundExpression) -> TypedConstant {
        if TryCreateTypedConstantCore(expression, out let constant) {
            return constant
        }
        return TypedConstant.CreateError(expression.Type)
    }

    private static func TryCreateTypedConstantCore(expression: BoundExpression, out constant: TypedConstant) -> bool {
        match expression {
            BoundLiteralExpression literal => {
                let type = literal.GetConvertedType() ?? literal.Type
                if literal.Kind == BoundLiteralExpressionKind.NullLiteral {
                    constant = TypedConstant.CreateNull(type)
                    return true
                }
                constant = TypedConstant.CreatePrimitive(type, literal.Value)
                return true
            }
            BoundConversionExpression conversion => {
                if TryCreateTypedConstantCore(conversion.Expression, out let converted) {
                    constant = converted.WithType(conversion.Type)
                    return true
                }
            }
            BoundTypeOfExpression typeOfExpression => {
                constant = TypedConstant.CreateType(typeOfExpression.SystemType, typeOfExpression.OperandType)
                return true
            }
            BoundCollectionExpression collection when collection.Type is ArrayTypeSymbol arrayType => {
                let elements = ImmutableArray.CreateBuilder<TypedConstant>()
                for element in collection.Elements {
                    if !TryCreateTypedConstantCore(element, out let elementConstant) {
                        constant = TypedConstant.CreateError(arrayType)
                        return false
                    }
                    elements.Add(elementConstant)
                }
                constant = TypedConstant.CreateArray(arrayType, elements.ToImmutable())
                return true
            }
            BoundEmptyCollectionExpression emptyCollection => {
                constant = TypedConstant.CreateArray(emptyCollection.Type, ImmutableArray<TypedConstant>.Empty)
                return true
            }
            BoundFieldAccess fieldAccess when IsConstantField(fieldAccess.Field) => {
                constant = CreateConstant(fieldAccess.Type, fieldAccess.Field.GetConstantValue())
                return true
            }
            BoundMemberAccessExpression { Member: FieldSymbol @field } memberAccess when IsConstantField(@field) => {
                constant = CreateConstant(memberAccess.Type, @field.GetConstantValue())
                return true
            }
            BoundBinaryExpression binary => {
                return TryCreateBinaryConstant(binary, out constant)
            }
            BoundErrorExpression error => {
                constant = TypedConstant.CreateError(error.Type)
                return false
            }
            _ => {
            }
        }
        constant = TypedConstant.CreateError(expression.Type)
        return false
    }

    private static func CreateConstant(type: TypeSymbol?, value: object?) -> TypedConstant {
        return if IsEnumType(type) {
            TypedConstant.CreateEnum(type, value)
        } else {
            TypedConstant.CreatePrimitive(type, value)
        }
    }

    private static func TryCreateBinaryConstant(binary: BoundBinaryExpression, out constant: TypedConstant) -> bool {
        if !TryCreateTypedConstantCore(binary.Left, out let left) ||
            !TryCreateTypedConstantCore(binary.Right, out let right) {
            constant = TypedConstant.CreateError(binary.Type)
            return false
        }
        if left.Value is null || right.Value is null {
            constant = TypedConstant.CreateError(binary.Type)
            return false
        }
        let operatorKind = binary.Operator.OperatorKind & ~(BinaryOperatorKind.Lifted | BinaryOperatorKind.Checked)
        if operatorKind is not (BinaryOperatorKind.BitwiseAnd or BinaryOperatorKind.BitwiseOr or BinaryOperatorKind.BitwiseXor) {
            constant = TypedConstant.CreateError(binary.Type)
            return false
        }
        // Preserve all 64 bits, including unsigned high bits and signed operands.
        let leftBits = ToBits(left.Value!)
        let rightBits = ToBits(right.Value!)
        let bits = operatorKind match {
            BinaryOperatorKind.BitwiseAnd => leftBits & rightBits
            BinaryOperatorKind.BitwiseOr => leftBits | rightBits
            _ => leftBits ^ rightBits
        }
        let storage = if binary.Type is NamedTypeSymbol { TypeKind: TypeKind.Enum } enumType {
            enumType.EnumUnderlyingType
        } else {
            binary.Type
        }
        let storedValue: object? = storage?.SpecialType match {
            SpecialType.System_Boolean => bits != 0
            SpecialType.System_SByte => unchecked((sbyte)bits)
            SpecialType.System_Byte => unchecked((byte)bits)
            SpecialType.System_Int16 => unchecked((short)bits)
            SpecialType.System_UInt16 => unchecked((ushort)bits)
            SpecialType.System_Int32 => unchecked((int)bits)
            SpecialType.System_UInt32 => unchecked((uint)bits)
            SpecialType.System_Int64 => unchecked((long)bits)
            SpecialType.System_UInt64 => bits
            _ => null
        }
        if storedValue is null {
            constant = TypedConstant.CreateError(binary.Type)
            return false
        }
        constant = CreateConstant(binary.Type, storedValue)
        return true
    }

    private static func ToBits(value: object) -> ulong {
        return if let unsigned: ulong = value {
            unsigned
        } else {
            unchecked((ulong)Convert.ToInt64(value))
        }
    }

    private static func IsEnumType(type: TypeSymbol?) -> bool => type is NamedTypeSymbol { TypeKind: TypeKind.Enum }

    private static func IsConstantField(@field: FieldSymbol) -> bool => @field.IsConst || @field.ContainingType?.TypeKind == TypeKind.Enum
}
