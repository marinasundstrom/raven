namespace Raven.CodeAnalysis

internal open partial class BoundTreeWalker : BoundTreeVisitor {
    override func Visit(node: BoundNode) {
        if node is null {
            DefaultVisit(node)
            return
        }
        match node {
            BoundExpression expression => VisitExpression(expression)
            BoundStatement statement => VisitStatement(statement)
        }
    }

    override func VisitExpression(node: BoundExpression) {
        match node {
            BoundPattern pattern => VisitPattern(pattern)
            BoundDesignator designator => VisitDesignator(designator)
            _ => base.VisitExpression(node)
        }
    }

    override func VisitParenthesizedExpression(node: BoundParenthesizedExpression) => VisitExpression(node.Expression)

    override func VisitConversionExpression(node: BoundConversionExpression) => VisitExpression(node.Expression)

    override func VisitAsExpression(node: BoundAsExpression) => VisitExpression(node.Expression)

    override func VisitLiteralExpression(node: BoundLiteralExpression) { }

    override func VisitLocalAccess(node: BoundLocalAccess) { }

    override func VisitExpressionStatement(node: BoundExpressionStatement) => VisitExpression(node.Expression)

    override func VisitRequiredResultExpression(node: BoundRequiredResultExpression) => VisitExpression(node.Operand)

    override func VisitFieldAccess(node: BoundFieldAccess) {
        if let receiver: BoundExpression = node.Receiver {
            VisitExpression(receiver)
        }
    }

    override func VisitMemberAccessExpression(node: BoundMemberAccessExpression) {
        if let receiver: BoundExpression = node.Receiver {
            VisitExpression(receiver)
        }
    }

    override func VisitAndPattern(node: BoundAndPattern) {
        VisitPattern(node.Left)
        VisitPattern(node.Right)
    }

    override func VisitOrPattern(node: BoundOrPattern) {
        VisitPattern(node.Left)
        VisitPattern(node.Right)
    }

    override func VisitNotPattern(node: BoundNotPattern) => VisitPattern(node.Pattern)

    override func VisitDeclarationPattern(node: BoundDeclarationPattern) => VisitDesignator(node.Designator)

    override func VisitComparisonPattern(node: BoundComparisonPattern) => VisitExpression(node.Value)

    override func VisitRangePattern(node: BoundRangePattern) {
        if let lower: BoundExpression = node.LowerBound {
            VisitExpression(lower)
        }
        if let upper: BoundExpression = node.UpperBound {
            VisitExpression(upper)
        }
    }

    override func VisitUnionMemberPattern(node: BoundUnionMemberPattern) => VisitPattern(node.Pattern)

    override func VisitGuardedPattern(node: BoundGuardedPattern) {
        VisitPattern(node.Pattern)
        if let pattern: BoundPattern = node.GuardPattern {
            VisitPattern(pattern)
        }
        if let expression: BoundExpression = node.GuardExpression {
            VisitExpression(expression)
        }
    }
}
