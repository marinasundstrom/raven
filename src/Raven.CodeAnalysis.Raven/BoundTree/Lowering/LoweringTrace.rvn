namespace Raven.CodeAnalysis

import System.Collections.Concurrent.*
import System.Collections.Immutable.*

public interface ILoweringTraceSink {
    func RecordExtensionInvocation(entry: ExtensionInvocationLoweringTrace)
}

public class LoweringTraceLog(private val isEnabled: bool) : ILoweringTraceSink {
    private readonly field _extensionInvocations: ConcurrentQueue<ExtensionInvocationLoweringTrace> = ConcurrentQueue<ExtensionInvocationLoweringTrace>()

    init() : self(isEnabled: true) {
    }

    val ExtensionInvocations: ImmutableArray<ExtensionInvocationLoweringTrace> => _extensionInvocations.ToImmutableArray()

    func ILoweringTraceSink.RecordExtensionInvocation(entry: ExtensionInvocationLoweringTrace) {
        if !isEnabled {
            return
        }
        _extensionInvocations.Enqueue(entry)
    }
}

public record class ExtensionInvocationLoweringTrace(
    val ContainingSymbol: Symbol,
    val Method: MethodSymbol,
    val ReceiverType: TypeSymbol,
    val ReceiverCameFromInvocation: bool,
    val ArgumentTypes: ImmutableArray<TypeSymbol>)
