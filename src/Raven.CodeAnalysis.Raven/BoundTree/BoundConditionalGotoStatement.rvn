namespace Raven.CodeAnalysis

internal partial class BoundConditionalGotoStatement : BoundStatement {
    init(target: LabelSymbol, condition: BoundExpression, jumpIfTrue: bool) {
        Target = target
        Condition = condition
        JumpIfTrue = jumpIfTrue
    }

    val Target: LabelSymbol { get; }

    val Condition: BoundExpression { get; }

    val JumpIfTrue: bool { get; }

    override val Symbol: Symbol => Target
}
