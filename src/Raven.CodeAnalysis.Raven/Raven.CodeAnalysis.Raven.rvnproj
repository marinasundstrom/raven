<Project>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <AssemblyName>Raven.CodeAnalysis.Raven</AssemblyName>
    <OutputType>Library</OutputType>
    <ImplicitImports>false</ImplicitImports>
    <RavenEmitCoreTypesOnly>true</RavenEmitCoreTypesOnly>
    <IsPackable>false</IsPackable>
    <RavenGenerateDocumentation>false</RavenGenerateDocumentation>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <GenerateMarkdownDocumentationFile>false</GenerateMarkdownDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PortSymbolNode Include="ArrayTypeSymbolImplementation" />
    <PortBoundNode Include="BoundLiteralExpression;BoundRequiredResultExpression;BoundDefaultValueExpression;BoundLocalAccess;BoundFieldAccess;BoundMemberAccessExpression;BoundExpressionStatement;BoundDiscardPattern;BoundDiscardDesignator;BoundGuardedPattern;BoundComparisonPattern;BoundRangePattern;BoundNotPattern;BoundAndPattern;BoundOrPattern;BoundDeclarationPattern;BoundSingleVariableDesignator;BoundUnionMemberPattern;BoundConversionExpression;BoundAsExpression;BoundParenthesizedExpression;BoundBlockStatement;BoundIfStatement;BoundWhileStatement;BoundLoopStatement;BoundReturnStatement;BoundBreakStatement;BoundContinueStatement;BoundThrowStatement;BoundGotoStatement;BoundConditionalGotoStatement;BoundLabeledStatement;BoundArrayAccessExpression;BoundArrayCreationExpression;BoundAwaitExpression;BoundBaseExpression;BoundBlockExpression;BoundBreakExpression;BoundConditionalAccessExpression;BoundConditionalReceiverExpression;BoundContinueExpression;BoundDereferenceExpression;BoundIndexExpression;BoundIndexerAccessExpression;BoundNameOfExpression;BoundNamespaceExpression;BoundNullCoalesceExpression;BoundNullableValueExpression;BoundParameterAccess;BoundPropertyAccess;BoundRangeExpression;BoundReturnExpression;BoundSelfExpression;BoundThrowExpression;BoundTupleExpression;BoundTypeExpression;BoundTypeOfExpression;BoundObjectCreationExpression;BoundObjectInitializer;BoundObjectInitializerAssignmentEntry;BoundObjectInitializerExpressionEntry;BoundCollectionExpression;BoundDictionaryExpression;BoundEmptyCollectionExpression;BoundSpreadElement;BoundCollectionComprehensionExpression;BoundLockStatement;BoundTryStatement;BoundCatchClause;BoundPointerMemberAccessExpression;BoundIsPatternExpression;BoundForStatement;BoundYieldExpression;BoundYieldStatement;BoundLocalAssignmentExpression;BoundPropertyAssignmentExpression;BoundFieldAssignmentExpression;BoundArrayAssignmentExpression;BoundParameterAssignmentExpression;BoundIndexerAssignmentExpression;BoundMemberAssignmentExpression;BoundPatternAssignmentExpression;BoundByRefAssignmentExpression;BoundAssignmentStatement;BoundErrorExpression;BoundStackAllocExpression;BoundUnitExpression;BoundVariableExpression;BoundDelegateCreationExpression;BoundMethodGroupExpression;BoundCarrierConditionalAccessExpression;BoundWithExpression;BoundWithAssignment;BoundTryExpression;BoundPropagateExpression;BoundUnionCaseExpression;BoundMatchStatement;BoundMatchExpression;BoundMatchArm;BoundAddressOfExpression;BoundLocalDeclarationStatement;BoundVariableDeclarator;BoundBinaryExpression;BoundUnaryExpression" />
    <PortBoundModelInput Include="../Raven.CodeAnalysis/BoundTree/**/*.cs" Exclude="../Raven.CodeAnalysis/BoundTree/generated/**/*.cs" />
    <PortSymbolVisitorInput Include="../Raven.CodeAnalysis/Symbols/**/*.cs;../../tools/BoundNodeGenerator/**/*.cs;../../tools/BoundNodeGenerator/BoundNodeGenerator.csproj"
                            Exclude="../Raven.CodeAnalysis/Symbols/generated/**/*.cs;../../tools/**/obj/**/*.cs;../../tools/**/bin/**/*.cs" />
    <PortDiagnosticInput Include="../Raven.CodeAnalysis/DiagnosticDescriptors.xml;../../tools/DiagnosticsGenerator/**/*.cs;../../tools/DiagnosticsGenerator/DiagnosticsGenerator.csproj"
                         Exclude="../../tools/**/obj/**/*.cs;../../tools/**/bin/**/*.cs" />
    <PortSyntaxKindInput Include="../Raven.CodeAnalysis/Syntax/*.xml;../../tools/NodeGenerator/**/*.cs;../../tools/NodeGenerator/NodeGenerator.csproj;../../tools/NodesShared/**/*.cs;../../tools/NodesShared/NodesShared.csproj"
                         Exclude="../../tools/**/obj/**/*.cs;../../tools/**/bin/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="9.0.0" />
  </ItemGroup>
  <!-- Unported compiler services remain explicit bootstrap dependencies. -->
  <ItemGroup>
    <ProjectReference Include="../Raven.CodeAnalysis/Raven.CodeAnalysis.csproj" Aliases="Seed" />
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
  <!-- Evaluate generated sources after the language targets exclude default obj inputs. -->
  <PropertyGroup>
    <PortBoundTreeDirectory>$(IntermediateOutputPath)RavenBoundTree</PortBoundTreeDirectory>
    <PortSymbolNodeDirectory>$(IntermediateOutputPath)RavenSymbolNodes</PortSymbolNodeDirectory>
    <PortSymbolVisitorDirectory>$(IntermediateOutputPath)RavenSymbolVisitors</PortSymbolVisitorDirectory>
    <PortSyntaxTreeDirectory>$(IntermediateOutputPath)RavenSyntaxTree</PortSyntaxTreeDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(PortBoundTreeDirectory)/BoundTree.g.rvn" />
    <Compile Remove="Syntax/generated/**/*.rvn" />
    <Compile Include="$(PortSyntaxTreeDirectory)/**/*.g.rvn" />
    <Compile Include="$(PortSymbolNodeDirectory)/*.symbol.g.rvn" />
    <Compile Include="$(PortSymbolVisitorDirectory)/**/*.g.rvn" />
  </ItemGroup>
  <Target Name="GeneratePortSyntaxTree"
          Inputs="$(MSBuildProjectFullPath);@(PortSyntaxKindInput)"
          Outputs="$(PortSyntaxTreeDirectory)/generated/SyntaxKind.g.rvn;$(PortSyntaxTreeDirectory)/generated/SyntaxVisitor.g.rvn">
    <Exec Command="dotnet run --project ../../../tools/NodeGenerator -- --raven-syntax-tree &quot;$(MSBuildProjectDirectory)/$(PortSyntaxTreeDirectory)&quot;"
          WorkingDirectory="../Raven.CodeAnalysis/Syntax" />
  </Target>
  <Target Name="IncludePortSyntaxTree" BeforeTargets="CoreCompile" DependsOnTargets="GeneratePortSyntaxTree">
    <ItemGroup>
      <Compile Remove="Syntax/generated/**/*.rvn;$(PortSyntaxTreeDirectory)/**/*.g.rvn" />
      <Compile Include="$(PortSyntaxTreeDirectory)/**/*.g.rvn" />
    </ItemGroup>
  </Target>
  <Target Name="GeneratePortDiagnostics"
          Inputs="$(MSBuildProjectFullPath);@(PortDiagnosticInput)"
          Outputs="Diagnostics/generated/CompilerDiagnostics.g.rvn;Diagnostics/generated/DiagnosticBagExtensions.g.rvn">
    <Exec Command="dotnet run --project ../../tools/DiagnosticsGenerator -- --raven-catalog &quot;$(MSBuildProjectDirectory)/Diagnostics/generated/CompilerDiagnostics.g.rvn&quot;"
          WorkingDirectory="../Raven.CodeAnalysis" />
    <Exec Command="dotnet run --project ../../tools/DiagnosticsGenerator -- --raven-reporters &quot;$(MSBuildProjectDirectory)/Diagnostics/generated/DiagnosticBagExtensions.g.rvn&quot;"
          WorkingDirectory="../Raven.CodeAnalysis" />
  </Target>
  <Target Name="IncludePortDiagnostics" BeforeTargets="CoreCompile" DependsOnTargets="GeneratePortDiagnostics">
    <ItemGroup>
      <Compile Remove="Diagnostics/generated/CompilerDiagnostics.g.rvn;Diagnostics/generated/DiagnosticBagExtensions.g.rvn" />
      <Compile Include="Diagnostics/generated/CompilerDiagnostics.g.rvn;Diagnostics/generated/DiagnosticBagExtensions.g.rvn" />
    </ItemGroup>
  </Target>
  <Target Name="GeneratePortBoundTree" BeforeTargets="CoreCompile"
          Inputs="$(MSBuildProjectFullPath);@(PortBoundModelInput);@(PortSymbolVisitorInput)"
          Outputs="$(PortBoundTreeDirectory)/BoundTree.g.rvn">
    <Exec Command="dotnet run --project ../../tools/BoundNodeGenerator -- --raven-bound-tree &quot;$(MSBuildProjectDirectory)/$(PortBoundTreeDirectory)&quot; @(PortBoundNode, ' ')"
          WorkingDirectory="../Raven.CodeAnalysis" />
  </Target>
  <Target Name="GeneratePortSymbolVisitors"
          Inputs="$(MSBuildProjectFullPath);@(PortSymbolVisitorInput)"
          Outputs="$(PortSymbolVisitorDirectory)/SymbolVisitor.g.rvn;$(PortSymbolVisitorDirectory)/SymbolVisitor.Generic.g.rvn">
    <Exec Command="dotnet run --project ../../tools/BoundNodeGenerator -- --raven-symbol-visitors &quot;$(MSBuildProjectDirectory)/$(PortSymbolVisitorDirectory)&quot;"
          WorkingDirectory="../Raven.CodeAnalysis" />
  </Target>
  <Target Name="IncludePortSymbolVisitors" BeforeTargets="CoreCompile" DependsOnTargets="GeneratePortSymbolVisitors">
    <ItemGroup>
      <Compile Remove="$(PortSymbolVisitorDirectory)/**/*.g.rvn" />
      <Compile Include="$(PortSymbolVisitorDirectory)/**/*.g.rvn" />
    </ItemGroup>
  </Target>
  <Target Name="GeneratePortSymbolNodes"
          Inputs="$(MSBuildProjectFullPath);@(PortSymbolVisitorInput)"
          Outputs="@(PortSymbolNode->'$(PortSymbolNodeDirectory)/%(Identity).symbol.g.rvn')">
    <Exec Command="dotnet run --project ../../tools/BoundNodeGenerator -- --raven-symbol-nodes &quot;$(MSBuildProjectDirectory)/$(PortSymbolNodeDirectory)&quot; @(PortSymbolNode, ' ')"
          WorkingDirectory="../Raven.CodeAnalysis" />
  </Target>
  <Target Name="IncludePortSymbolNodes" BeforeTargets="CoreCompile" DependsOnTargets="GeneratePortSymbolNodes">
    <ItemGroup>
      <Compile Remove="$(PortSymbolNodeDirectory)/*.symbol.g.rvn" />
      <Compile Include="$(PortSymbolNodeDirectory)/*.symbol.g.rvn" />
    </ItemGroup>
  </Target>
</Project>
