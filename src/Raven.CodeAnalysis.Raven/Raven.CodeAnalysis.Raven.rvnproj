<Project>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <AssemblyName>Raven.CodeAnalysis.Raven</AssemblyName>
    <OutputType>Library</OutputType>
    <ImplicitImports>false</ImplicitImports>
    <RavenEmitCoreTypesOnly>true</RavenEmitCoreTypesOnly>
    <IsPackable>false</IsPackable>
    <RavenGenerateDocumentation>false</RavenGenerateDocumentation>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <GenerateMarkdownDocumentationFile>false</GenerateMarkdownDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PortSymbolVisitorInput Include="../Raven.CodeAnalysis/Symbols/**/*.cs;../../tools/BoundNodeGenerator/**/*.cs;../../tools/BoundNodeGenerator/BoundNodeGenerator.csproj"
                            Exclude="../Raven.CodeAnalysis/Symbols/generated/**/*.cs;../../tools/**/obj/**/*.cs;../../tools/**/bin/**/*.cs" />
    <PortDiagnosticInput Include="../Raven.CodeAnalysis/DiagnosticDescriptors.xml;../../tools/DiagnosticsGenerator/**/*.cs;../../tools/DiagnosticsGenerator/DiagnosticsGenerator.csproj"
                         Exclude="../../tools/**/obj/**/*.cs;../../tools/**/bin/**/*.cs" />
    <PortSyntaxKindInput Include="../Raven.CodeAnalysis/Syntax/*.xml;../../tools/NodeGenerator/**/*.cs;../../tools/NodeGenerator/NodeGenerator.csproj;../../tools/NodesShared/**/*.cs;../../tools/NodesShared/NodesShared.csproj"
                         Exclude="../../tools/**/obj/**/*.cs;../../tools/**/bin/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="9.0.0" />
  </ItemGroup>
  <!-- Unported compiler services remain explicit bootstrap dependencies. -->
  <ItemGroup>
    <ProjectReference Include="../Raven.CodeAnalysis/Raven.CodeAnalysis.csproj" Aliases="Seed" />
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
  <!-- Evaluate generated sources after the language targets exclude default obj inputs. -->
  <PropertyGroup>
    <PortSymbolVisitorDirectory>$(IntermediateOutputPath)RavenSymbolVisitors</PortSymbolVisitorDirectory>
    <PortSyntaxTreeDirectory>$(IntermediateOutputPath)RavenSyntaxTree</PortSyntaxTreeDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Syntax/generated/**/*.rvn" />
    <Compile Include="$(PortSyntaxTreeDirectory)/**/*.g.rvn" />
    <Compile Include="$(PortSymbolVisitorDirectory)/**/*.g.rvn" />
  </ItemGroup>
  <Target Name="GeneratePortSyntaxTree"
          Inputs="$(MSBuildProjectFullPath);@(PortSyntaxKindInput)"
          Outputs="$(PortSyntaxTreeDirectory)/generated/SyntaxKind.g.rvn;$(PortSyntaxTreeDirectory)/generated/SyntaxVisitor.g.rvn">
    <Exec Command="dotnet run --project ../../../tools/NodeGenerator -- --raven-syntax-tree &quot;$(MSBuildProjectDirectory)/$(PortSyntaxTreeDirectory)&quot;"
          WorkingDirectory="../Raven.CodeAnalysis/Syntax" />
  </Target>
  <Target Name="IncludePortSyntaxTree" BeforeTargets="CoreCompile" DependsOnTargets="GeneratePortSyntaxTree">
    <ItemGroup>
      <Compile Remove="Syntax/generated/**/*.rvn;$(PortSyntaxTreeDirectory)/**/*.g.rvn" />
      <Compile Include="$(PortSyntaxTreeDirectory)/**/*.g.rvn" />
    </ItemGroup>
  </Target>
  <Target Name="GeneratePortDiagnostics"
          Inputs="$(MSBuildProjectFullPath);@(PortDiagnosticInput)"
          Outputs="Diagnostics/generated/CompilerDiagnostics.g.rvn;Diagnostics/generated/DiagnosticBagExtensions.g.rvn">
    <Exec Command="dotnet run --project ../../tools/DiagnosticsGenerator -- --raven-catalog &quot;$(MSBuildProjectDirectory)/Diagnostics/generated/CompilerDiagnostics.g.rvn&quot;"
          WorkingDirectory="../Raven.CodeAnalysis" />
    <Exec Command="dotnet run --project ../../tools/DiagnosticsGenerator -- --raven-reporters &quot;$(MSBuildProjectDirectory)/Diagnostics/generated/DiagnosticBagExtensions.g.rvn&quot;"
          WorkingDirectory="../Raven.CodeAnalysis" />
  </Target>
  <Target Name="IncludePortDiagnostics" BeforeTargets="CoreCompile" DependsOnTargets="GeneratePortDiagnostics">
    <ItemGroup>
      <Compile Remove="Diagnostics/generated/CompilerDiagnostics.g.rvn;Diagnostics/generated/DiagnosticBagExtensions.g.rvn" />
      <Compile Include="Diagnostics/generated/CompilerDiagnostics.g.rvn;Diagnostics/generated/DiagnosticBagExtensions.g.rvn" />
    </ItemGroup>
  </Target>
  <Target Name="GeneratePortSymbolVisitors"
          Inputs="$(MSBuildProjectFullPath);@(PortSymbolVisitorInput)"
          Outputs="$(PortSymbolVisitorDirectory)/SymbolVisitor.g.rvn;$(PortSymbolVisitorDirectory)/SymbolVisitor.Generic.g.rvn">
    <Exec Command="dotnet run --project ../../tools/BoundNodeGenerator -- --raven-symbol-visitors &quot;$(MSBuildProjectDirectory)/$(PortSymbolVisitorDirectory)&quot;"
          WorkingDirectory="../Raven.CodeAnalysis" />
  </Target>
  <Target Name="IncludePortSymbolVisitors" BeforeTargets="CoreCompile" DependsOnTargets="GeneratePortSymbolVisitors">
    <ItemGroup>
      <Compile Remove="$(PortSymbolVisitorDirectory)/**/*.g.rvn" />
      <Compile Include="$(PortSymbolVisitorDirectory)/**/*.g.rvn" />
    </ItemGroup>
  </Target>
</Project>
