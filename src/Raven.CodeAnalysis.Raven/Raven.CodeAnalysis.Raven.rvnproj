<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <AssemblyName>Raven.CodeAnalysis.Raven</AssemblyName>
    <OutputType>Library</OutputType>
    <ImplicitImports>false</ImplicitImports>
    <RavenEmitCoreTypesOnly>true</RavenEmitCoreTypesOnly>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PortDiagnosticInput Include="../Raven.CodeAnalysis/DiagnosticDescriptors.xml;../../tools/DiagnosticsGenerator/**/*.cs;../../tools/DiagnosticsGenerator/DiagnosticsGenerator.csproj"
                         Exclude="../../tools/**/obj/**/*.cs;../../tools/**/bin/**/*.cs" />
    <PortSyntaxKindInput Include="../Raven.CodeAnalysis/Syntax/*.xml;../../tools/NodeGenerator/**/*.cs;../../tools/NodeGenerator/NodeGenerator.csproj;../../tools/NodesShared/**/*.cs;../../tools/NodesShared/NodesShared.csproj"
                         Exclude="../../tools/**/obj/**/*.cs;../../tools/**/bin/**/*.cs" />
  </ItemGroup>
  <Target Name="GeneratePortSyntaxKind"
          Inputs="$(MSBuildProjectFullPath);@(PortSyntaxKindInput)"
          Outputs="Syntax/generated/SyntaxKind.g.rvn">
    <Exec Command="dotnet run --project ../../../tools/NodeGenerator -- --raven-syntax-kind &quot;$(MSBuildProjectDirectory)/Syntax/generated/SyntaxKind.g.rvn&quot;"
          WorkingDirectory="../Raven.CodeAnalysis/Syntax" />
  </Target>
  <Target Name="IncludePortSyntaxKind" BeforeTargets="CoreCompile" DependsOnTargets="GeneratePortSyntaxKind">
    <ItemGroup>
      <Compile Remove="Syntax/generated/SyntaxKind.g.rvn" />
      <Compile Include="Syntax/generated/SyntaxKind.g.rvn" />
    </ItemGroup>
  </Target>
  <Target Name="GeneratePortSyntaxFacts"
          Inputs="$(MSBuildProjectFullPath);@(PortSyntaxKindInput)"
          Outputs="Syntax/generated/SyntaxFacts.Tokens.g.rvn;Syntax/generated/SyntaxFacts.Nodes.g.rvn">
    <Exec Command="dotnet run --project ../../../tools/NodeGenerator -- --raven-syntax-facts &quot;$(MSBuildProjectDirectory)/Syntax/generated&quot;"
          WorkingDirectory="../Raven.CodeAnalysis/Syntax" />
  </Target>
  <Target Name="IncludePortSyntaxFacts" BeforeTargets="CoreCompile" DependsOnTargets="GeneratePortSyntaxFacts">
    <ItemGroup>
      <Compile Remove="Syntax/generated/SyntaxFacts.Tokens.g.rvn;Syntax/generated/SyntaxFacts.Nodes.g.rvn" />
      <Compile Include="Syntax/generated/SyntaxFacts.Tokens.g.rvn;Syntax/generated/SyntaxFacts.Nodes.g.rvn" />
    </ItemGroup>
  </Target>
  <Target Name="GeneratePortDiagnostics"
          Inputs="$(MSBuildProjectFullPath);@(PortDiagnosticInput)"
          Outputs="Diagnostics/generated/CompilerDiagnostics.g.rvn">
    <Exec Command="dotnet run --project ../../tools/DiagnosticsGenerator -- --raven-catalog &quot;$(MSBuildProjectDirectory)/Diagnostics/generated/CompilerDiagnostics.g.rvn&quot;"
          WorkingDirectory="../Raven.CodeAnalysis" />
  </Target>
  <Target Name="IncludePortDiagnostics" BeforeTargets="CoreCompile" DependsOnTargets="GeneratePortDiagnostics">
    <ItemGroup>
      <Compile Remove="Diagnostics/generated/CompilerDiagnostics.g.rvn" />
      <Compile Include="Diagnostics/generated/CompilerDiagnostics.g.rvn" />
    </ItemGroup>
  </Target>
</Project>
