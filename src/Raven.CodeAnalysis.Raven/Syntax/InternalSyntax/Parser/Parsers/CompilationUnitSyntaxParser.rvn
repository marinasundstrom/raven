namespace Raven.CodeAnalysis.Syntax.InternalSyntax.Parser

import System.*

import System.Linq.*

import Raven.CodeAnalysis.Syntax.InternalSyntax.SyntaxFactory.*

internal open class CompilationUnitSyntaxParser : SyntaxParser {
    init(parent: ParseContext) : base(parent) {
    }

    private enum MemberOrder {
        Imports
        Aliases
        Members
    }

    func Parse() -> CompilationUnitSyntax {
        _stopwatch.Reset()
        _stopwatch.Start()

        SetTreatNewlinesAsTokens(false)

        let compilationAttributeLists = System.Collections.Generic.List<GreenNode>()
        while (TryParseCompilationAttributeList(out let attributeList)) {
            compilationAttributeLists.Add(attributeList)
        }

        let importDirectives = System.Collections.Generic.List<ImportDirectiveSyntax>()
        let aliasDirectives = System.Collections.Generic.List<AliasDirectiveSyntax>()
        let memberDeclarations = System.Collections.Generic.List<MemberDeclarationSyntax>()

        var nextToken: SyntaxToken? = null

        var order = MemberOrder.Imports

        while (!ConsumeToken(SyntaxKind.EndOfFileToken, out nextToken)) {
            let start = Position
            let importCount = importDirectives.Count
            let aliasCount = aliasDirectives.Count
            let memberCount = memberDeclarations.Count

            // Allow compilation-level attributes (e.g. [assembly: ...] or [module: ...]) to appear after imports/aliases,
            // before any other members/statements.
            if (order != MemberOrder.Members &&
                AttributeDeclarationParser.IsAttributeListStart(self) &&
                TryParseCompilationAttributeList(out let compilationAttributeList)) {
                compilationAttributeLists.Add(compilationAttributeList)
                continue
            }

            ParseNamespaceMemberDeclarations(nextToken!, importDirectives, aliasDirectives, memberDeclarations, ref order)

            if (Position == start &&
                importDirectives.Count == importCount &&
                aliasDirectives.Count == aliasCount &&
                memberDeclarations.Count == memberCount &&
                !PeekToken().IsKind(SyntaxKind.EndOfFileToken)) {
                ReadToken()
            }

            SetTreatNewlinesAsTokens(false)
        }

        let attributeLists = List(compilationAttributeLists)

        let cu = CompilationUnit(List(importDirectives), List(aliasDirectives), attributeLists, List(memberDeclarations), nextToken!)

        _stopwatch.Stop()

        return cu
    }

    func ParseMemberDeclaration() -> MemberDeclarationSyntax? {
        if (PeekToken().IsKind(SyntaxKind.EndOfFileToken)) {
            return null
        }

        let imports = System.Collections.Generic.List<ImportDirectiveSyntax>()
        let aliases = System.Collections.Generic.List<AliasDirectiveSyntax>()
        let members = System.Collections.Generic.List<MemberDeclarationSyntax>()
        var order = MemberOrder.Imports
        ParseNamespaceMemberDeclarations(PeekToken(), imports, aliases, members, ref order)

        return if imports.Count == 0 && aliases.Count == 0 && members.Count == 1 {
            members[0]
        } else {
            null
        }
    }

    private func TryParseCompilationAttributeList(out attributeList: AttributeListSyntax) -> bool {
        attributeList = default(AttributeListSyntax)!

        if (!AttributeDeclarationParser.IsAttributeListStart(self)) {
            return false
        }

        let checkpoint = CreateCheckpoint()
        let parsedAttributeList = AttributeDeclarationParser.ParseAttributeList(self)

        if (IsCompilationAttributeList(parsedAttributeList)) {
            attributeList = parsedAttributeList
            return true
        }

        checkpoint.Rewind()
        return false
    }

    private static func IsCompilationAttributeList(attributeList: AttributeListSyntax) -> bool {
        if (attributeList.Target is not AttributeTargetSpecifierSyntax target) {
            return false
        }

        let targetName = target.Identifier.GetValueText()
        return string.Equals(targetName, "assembly", StringComparison.Ordinal) ||
            string.Equals(targetName, "module", StringComparison.Ordinal)
    }

    private static func IsPossibleCompilationUnitMemberStart(token: SyntaxToken) -> bool {
        return MacroDeclarationParser.IsMacroKeyword(token) ||
            token.Kind is SyntaxKind.ImportKeyword or SyntaxKind.GlobalKeyword or SyntaxKind.AliasKeyword or SyntaxKind.NamespaceKeyword or SyntaxKind.ModuleKeyword or
            SyntaxKind.ConstKeyword or SyntaxKind.EnumKeyword or SyntaxKind.UnionKeyword or SyntaxKind.DelegateKeyword or SyntaxKind.StructKeyword or SyntaxKind.ClassKeyword or
            SyntaxKind.InterfaceKeyword or SyntaxKind.ExtensionKeyword or SyntaxKind.OpenBracketToken or SyntaxKind.HashToken or
            SyntaxKind.PublicKeyword or SyntaxKind.PrivateKeyword or SyntaxKind.InternalKeyword or SyntaxKind.ProtectedKeyword or SyntaxKind.FileprivateKeyword or
            SyntaxKind.StaticKeyword or SyntaxKind.RefKeyword or SyntaxKind.ReadonlyKeyword or SyntaxKind.AbstractKeyword or SyntaxKind.FinalKeyword or SyntaxKind.SealedKeyword or
            SyntaxKind.OpenKeyword or SyntaxKind.RecordKeyword or
            SyntaxKind.PartialKeyword or SyntaxKind.OverrideKeyword or SyntaxKind.AsyncKeyword or SyntaxKind.ExternKeyword
    }

    private func ParseNamespaceMemberDeclarations(
        nextToken: SyntaxToken,
        importDirectives: System.Collections.Generic.List<ImportDirectiveSyntax>,
        aliasDirectives: System.Collections.Generic.List<AliasDirectiveSyntax>,
        memberDeclarations: System.Collections.Generic.List<MemberDeclarationSyntax>,
        ref order: MemberOrder) {
        if (nextToken.IsKind(SyntaxKind.ImportKeyword)) {
            let start = Position
            let importDirective = ImportDirectiveSyntaxParser(self).ParseImportDirective()

            if (order > MemberOrder.Imports) {
                AddDiagnostic(
                    DiagnosticInfo.Create(
                        CompilerDiagnostics.ImportDirectiveOutOfOrder,
                        GetActualTextSpan(start, importDirective)))
                memberDeclarations.Add(PreserveMisplacedDirective(importDirective))
                order = MemberOrder.Members
                return
            }

            importDirectives.Add(importDirective)
            order = MemberOrder.Imports
        } else if (nextToken.IsKind(SyntaxKind.GlobalKeyword) &&
                 PeekToken(1).IsKind(SyntaxKind.OpenBraceToken)) {
            let start = Position
            let globalImportBlock = ParseGlobalImportBlock()

            if (order > MemberOrder.Imports) {
                AddDiagnostic(
                    DiagnosticInfo.Create(
                        CompilerDiagnostics.ImportDirectiveOutOfOrder,
                        GetActualTextSpan(start, globalImportBlock)))
            }

            AddMemberDeclaration(memberDeclarations, globalImportBlock)
            order = MemberOrder.Imports
        } else if (nextToken.IsKind(Raven.CodeAnalysis.Syntax.SyntaxKind.AliasKeyword)) {
            let start = Position
            let aliasDirective = AliasDirectiveSyntaxParser(self).ParseAliasDirective()

            if (order > MemberOrder.Aliases) {
                AddDiagnostic(
                    DiagnosticInfo.Create(
                        CompilerDiagnostics.AliasDirectiveOutOfOrder,
                        GetActualTextSpan(start, aliasDirective)))
                memberDeclarations.Add(PreserveMisplacedDirective(aliasDirective))
                order = MemberOrder.Members
                return
            }

            aliasDirectives.Add(aliasDirective)
            order = MemberOrder.Aliases
        } else if (nextToken.Kind is SyntaxKind.NamespaceKeyword or SyntaxKind.ModuleKeyword) {
            let namespaceDeclaration = NamespaceDeclarationParser(self).ParseNamespaceDeclaration()

            AddMemberDeclaration(memberDeclarations, namespaceDeclaration)
            order = MemberOrder.Members
        } else if (MacroDeclarationParser(self).IsDeclarationStart()) {
            let macroDeclaration = MacroDeclarationParser(self).Parse(
                SyntaxList.Empty,
                SyntaxList.Empty)

            AddMemberDeclaration(memberDeclarations, macroDeclaration)
            order = MemberOrder.Members
        } else if (MacroInvocationSyntaxParser(self).IsDeclarationInvocationStart()) {
            let declaration = MacroInvocationSyntaxParser(self).ParseDeclaration(
                SyntaxList.Empty,
                SyntaxList.Empty)

            AddMemberDeclaration(memberDeclarations, declaration)
            order = MemberOrder.Members
        } else if (nextToken.IsKind(SyntaxKind.ConstKeyword) ||
                 nextToken.IsKind(SyntaxKind.EnumKeyword) ||
                 nextToken.IsKind(SyntaxKind.UnionKeyword) ||
                 nextToken.IsKind(SyntaxKind.DelegateKeyword) ||
                 nextToken.IsKind(SyntaxKind.StructKeyword) || nextToken.IsKind(SyntaxKind.ClassKeyword) || nextToken.IsKind(SyntaxKind.InterfaceKeyword) || nextToken.IsKind(SyntaxKind.ExtensionKeyword) ||
                 nextToken.IsKind(SyntaxKind.PublicKeyword) || nextToken.IsKind(SyntaxKind.PrivateKeyword) ||
                 nextToken.IsKind(SyntaxKind.InternalKeyword) || nextToken.IsKind(SyntaxKind.ProtectedKeyword) ||
                 nextToken.IsKind(SyntaxKind.FileprivateKeyword) ||
                 nextToken.IsKind(SyntaxKind.StaticKeyword) || nextToken.IsKind(SyntaxKind.RefKeyword) || nextToken.IsKind(SyntaxKind.ReadonlyKeyword) || nextToken.IsKind(SyntaxKind.AbstractKeyword) ||
                 nextToken.IsKind(SyntaxKind.FinalKeyword) || nextToken.IsKind(SyntaxKind.SealedKeyword) ||
                 nextToken.IsKind(SyntaxKind.OpenKeyword) || nextToken.IsKind(SyntaxKind.RecordKeyword) ||
                 nextToken.IsKind(SyntaxKind.PartialKeyword) ||
                 nextToken.IsKind(SyntaxKind.OverrideKeyword) ||
                 (nextToken.IsKind(SyntaxKind.AsyncKeyword) &&
                  MacroDeclarationParser(self).IsDeclarationStartAfterModifiers()) ||
                 nextToken.IsKind(SyntaxKind.ExternKeyword) ||
                 nextToken.IsKind(SyntaxKind.OpenBracketToken) ||
                 nextToken.IsKind(SyntaxKind.HashToken)) {
            let checkpoint = CreateCheckpoint()
            let attributeLists = AttributeDeclarationParser.ParseAttributeLists(self)
            let modifiers = ParseModifiers()
            let hasRecordModifier = modifiers.GetChildren().Any(x => x.IsKind(SyntaxKind.RecordKeyword))

            let tokenAfterModifiers = PeekToken()

            let macroParser = MacroDeclarationParser(self)
            if (macroParser.IsDeclarationStart()) {
                let macroDeclaration = macroParser.Parse(attributeLists, modifiers)

                AddMemberDeclaration(memberDeclarations, macroDeclaration)
                order = MemberOrder.Members
                return
            }

            let declarationMacroParser = MacroInvocationSyntaxParser(self)
            if (declarationMacroParser.IsDeclarationInvocationStart()) {
                let declaration = declarationMacroParser.ParseDeclaration(attributeLists, modifiers)

                AddMemberDeclaration(memberDeclarations, declaration)
                order = MemberOrder.Members
                return
            }

            if (attributeLists.GetChildren()
                    .OfType<AttributeListSyntax>()
                    .Any(attributeList => attributeList.CloseBracketToken.IsMissing)) {
                // Malformed attribute prelude (for example collection expressions like
                // `[1, 2] |> ...`) should be reparsed as a normal statement.
                checkpoint.Rewind()

                let bracketStatement = StatementSyntaxParser(self).ParseStatement()
                if (bracketStatement is not null) {
                    AddGlobalMember(memberDeclarations, SyntaxList.Empty, SyntaxList.Empty, bracketStatement)
                    order = MemberOrder.Members
                    return
                }
            }

            if (tokenAfterModifiers.Kind is SyntaxKind.NamespaceKeyword or SyntaxKind.ModuleKeyword) {
                checkpoint.Rewind()

                let namespaceDeclaration = NamespaceDeclarationParser(self).ParseNamespaceDeclaration()

                AddMemberDeclaration(memberDeclarations, namespaceDeclaration)
                order = MemberOrder.Members
                return
            }

            let typeKeywordKind = tokenAfterModifiers.Kind

            if (typeKeywordKind == SyntaxKind.EnumKeyword) {
                checkpoint.Rewind()

                let enumDeclaration = EnumDeclarationParser(self).Parse()

                AddMemberDeclaration(memberDeclarations, enumDeclaration)
                order = MemberOrder.Members
                return
            }

            if (typeKeywordKind == SyntaxKind.UnionKeyword) {
                checkpoint.Rewind()

                let unionDeclaration = UnionDeclarationParser(self).Parse()

                AddMemberDeclaration(memberDeclarations, unionDeclaration)
                order = MemberOrder.Members
                return
            }

            if (typeKeywordKind == SyntaxKind.DelegateKeyword) {
                let delegateDeclaration = TypeDeclarationParser(self).ParseDelegateDeclaration(attributeLists, modifiers)

                AddMemberDeclaration(memberDeclarations, delegateDeclaration)
                order = MemberOrder.Members
                return
            }

            if (typeKeywordKind == SyntaxKind.ConstKeyword) {
                let constDeclaration = TypeDeclarationParser(self).ParseConstDeclaration(attributeLists, modifiers)

                AddMemberDeclaration(memberDeclarations, constDeclaration)
                order = MemberOrder.Members
                return
            }

            if (typeKeywordKind == SyntaxKind.ExtensionKeyword) {
                let extensionDeclaration = ExtensionDeclarationParser(self).Parse(attributeLists, modifiers)

                AddMemberDeclaration(memberDeclarations, extensionDeclaration)
                order = MemberOrder.Members
                return
            }

            if (typeKeywordKind is SyntaxKind.ClassKeyword or SyntaxKind.InterfaceKeyword or SyntaxKind.StructKeyword ||
                (hasRecordModifier && CanTokenBeIdentifier(tokenAfterModifiers))) {
                checkpoint.Rewind()

                let typeDeclaration = TypeDeclarationParser(self).Parse()

                AddMemberDeclaration(memberDeclarations, typeDeclaration)
                order = MemberOrder.Members
                return
            }

            let statementStartAfterModifiers = StatementSyntaxParser.IsTokenPotentialStatementStart(tokenAfterModifiers)

            if (!statementStartAfterModifiers) {
                // If self started with '[', we may have parsed a collection expression as
                // attributes. Rewind and parse it as a normal statement.
                if (nextToken.IsKind(SyntaxKind.OpenBracketToken)) {
                    checkpoint.Rewind()

                    let bracketStatement = StatementSyntaxParser(self).ParseStatement()
                    if (bracketStatement is not null) {
                        AddGlobalMember(memberDeclarations, SyntaxList.Empty, SyntaxList.Empty, bracketStatement)
                        order = MemberOrder.Members
                        return
                    }
                }

                let skippedToken = ParseIncompleteMemberTokens()
                TryConsumeTerminator(out let terminatorToken)
                let incompleteMember = IncompleteMemberDeclaration(attributeLists, modifiers, skippedToken, terminatorToken)

                AddMemberDeclaration(memberDeclarations, incompleteMember)
                order = MemberOrder.Members
                return
            }

            let statement = StatementSyntaxParser(self).ParseStatement()

            if (statement is null) {
                return
            }

            AddGlobalMember(memberDeclarations, attributeLists, modifiers, statement)
            order = MemberOrder.Members
        } else {
            let statementStart = StatementSyntaxParser.IsTokenPotentialStatementStart(nextToken)

            if (!statementStart) {
                let skippedToken = ParseIncompleteMemberTokens()
                TryConsumeTerminator(out let terminatorToken)
                let incompleteMember = IncompleteMemberDeclaration(SyntaxList.Empty, SyntaxList.Empty, skippedToken, terminatorToken)

                AddMemberDeclaration(memberDeclarations, incompleteMember)
                order = MemberOrder.Members
                return
            }

            let statement = StatementSyntaxParser(self).ParseStatement()

            if (statement is null) {
                return
            }

            AddGlobalMember(memberDeclarations, SyntaxList.Empty, SyntaxList.Empty, statement)
            order = MemberOrder.Members
        }
    }

    private func AddGlobalMember(
        memberDeclarations: System.Collections.Generic.List<MemberDeclarationSyntax>,
        initialAttributes: SyntaxList,
        initialModifiers: SyntaxList,
        initialStatement: StatementSyntax) {
        var attributeLists = initialAttributes
        var modifiers = initialModifiers
        var statement = initialStatement
        if (statement is FunctionStatementSyntax functionStatement) {
            let mergedAttributes = ConcatenateSyntaxLists(attributeLists, functionStatement.AttributeLists)
            let mergedModifiers = ConcatenateSyntaxLists(modifiers, functionStatement.Modifiers)

            statement = functionStatement.Update(
                mergedAttributes,
                mergedModifiers,
                functionStatement.FuncKeyword,
                functionStatement.Identifier,
                functionStatement.TypeParameterList,
                functionStatement.ParameterList,
                functionStatement.ReturnType,
                functionStatement.ConstraintClauses,
                functionStatement.Body,
                functionStatement.ExpressionBody,
                functionStatement.TerminatorToken)

            attributeLists = SyntaxList.Empty
            modifiers = SyntaxList.Empty
        }

        let globalStatement = GlobalStatement(attributeLists, modifiers, statement, Token(SyntaxKind.None))

        memberDeclarations.Add(globalStatement)
    }

    private func ParseGlobalImportBlock() -> GlobalImportBlockSyntax {
        let globalKeyword = ReadToken()
        ConsumeTokenOrMissing(SyntaxKind.OpenBraceToken, out let openBraceToken)

        let imports = System.Collections.Generic.List<ImportDirectiveSyntax>()
        var skippedTrivia = SyntaxTriviaList.Empty
        while (!IsNextToken(SyntaxKind.EndOfFileToken, out let nextToken) &&
               !nextToken.IsKind(SyntaxKind.CloseBraceToken)) {
            if (nextToken.IsKind(SyntaxKind.ImportKeyword)) {
                var importDirective = ImportDirectiveSyntaxParser(self).ParseImportDirective()
                if skippedTrivia.Count > 0 {
                    importDirective = importDirective.Update(
                        importDirective.ImportKeyword.WithLeadingTrivia(skippedTrivia.AddRange(importDirective.ImportKeyword.LeadingTrivia)),
                        importDirective.Name, importDirective.TerminatorToken)
                    skippedTrivia = SyntaxTriviaList.Empty
                }
                imports.Add(importDirective)
                continue
            }

            let span = GetSpanOfPeekedToken()
            let skippedToken = CreateSkippedToken([ReadToken()], span)
            skippedTrivia = skippedTrivia.AddRange(skippedToken.LeadingTrivia)
        }

        if (!ConsumeTokenOrMissing(SyntaxKind.CloseBraceToken, out var closeBraceToken)) {
            AddDiagnostic(
                DiagnosticInfo.Create(
                    CompilerDiagnostics.CharacterExpected,
                    GetEndOfLastToken(),
                    ['}']))
        }

        if skippedTrivia.Count > 0 {
            closeBraceToken = closeBraceToken.WithLeadingTrivia(skippedTrivia.AddRange(closeBraceToken.LeadingTrivia))
        }

        TryConsumeTerminator(out let terminatorToken)

        return GlobalImportBlock(
            SyntaxList.Empty,
            SyntaxList.Empty,
            globalKeyword,
            openBraceToken,
            List(imports),
            closeBraceToken,
            terminatorToken)
    }

    private static func ConcatenateSyntaxLists(first: SyntaxList, second: SyntaxList) -> SyntaxList {
        if (!first.GetChildren().Any()) {
            return second
        }

        if (!second.GetChildren().Any()) {
            return first
        }

        let nodes = System.Collections.Generic.List<GreenNode>()
        nodes.AddRange(first.GetChildren())
        nodes.AddRange(second.GetChildren())
        return List(nodes)
    }

    private func AddMemberDeclaration(
        memberDeclarations: System.Collections.Generic.List<MemberDeclarationSyntax>,
        declaration: MemberDeclarationSyntax) {
        memberDeclarations.Add(declaration)
        ValidateDeclarationSeparator(declaration)
    }

    private func ValidateDeclarationSeparator(member: MemberDeclarationSyntax) {
        if (member is GlobalStatementSyntax or IncompleteMemberDeclarationSyntax) {
            return
        }

        let next = PeekToken()
        if (!IsPossibleCompilationUnitMemberStart(next)) {
            return
        }

        if (HasLineBreakBeforePeekToken()) {
            return
        }

        if (!TryGetDeclarationTerminatorKind(member, out let terminatorKind)) {
            return
        }

        if (terminatorKind == SyntaxKind.None) {
            AddDiagnostic(
                DiagnosticInfo.Create(
                    CompilerDiagnostics.ExpectedNewLineBetweenDeclarations,
                    GetInsertionSpanBeforePeekedToken()))
        }
    }

    private static func TryGetDeclarationTerminatorKind(
        member: MemberDeclarationSyntax,
        out terminatorKind: SyntaxKind) -> bool {
        match member {
            BaseTypeDeclarationSyntax typeDeclaration => {
                terminatorKind = typeDeclaration.TerminatorToken.Kind
                return true
            }
            DelegateDeclarationSyntax delegateDeclaration => {
                terminatorKind = delegateDeclaration.TerminatorToken.Kind
                return true
            }
            NamespaceDeclarationSyntax namespaceDeclaration => {
                terminatorKind = namespaceDeclaration.TerminatorToken.Kind
                return true
            }
            FileScopedNamespaceDeclarationSyntax fileScopedNamespaceDeclaration => {
                terminatorKind = fileScopedNamespaceDeclaration.TerminatorToken.Kind
                return true
            }
            MacroDeclarationSyntax macroDeclaration => {
                terminatorKind = macroDeclaration.TerminatorToken.Kind
                return true
            }
            _ => {
                terminatorKind = SyntaxKind.None
                return false
            }
        }
    }

    private func ParseIncompleteMemberTokens() -> SyntaxToken {
        let span = GetSpanOfPeekedToken()

        let skippedTokens = ConsumeSkippedTokensUntil(token =>
            token.Kind is SyntaxKind.CloseBraceToken or SyntaxKind.EndOfFileToken ||
            IsPossibleCompilationUnitMemberStart(token) ||
            StatementSyntaxParser.IsTokenPotentialStatementStart(token),
            stopAtImplicitLineBreak: true)

        return CreateSkippedToken(skippedTokens, span)
    }

    private func ParseModifiers() -> SyntaxList {
        var modifiers: SyntaxList = SyntaxList.Empty

        while (true) {
            let kind = PeekToken().Kind

            if (kind is SyntaxKind.PublicKeyword or
                     SyntaxKind.PrivateKeyword or
                     SyntaxKind.InternalKeyword or
                     SyntaxKind.ProtectedKeyword or
                     SyntaxKind.FileprivateKeyword or
                     SyntaxKind.StaticKeyword or
                     SyntaxKind.RefKeyword or
                     SyntaxKind.ReadonlyKeyword or
                     SyntaxKind.AbstractKeyword or
                     SyntaxKind.FinalKeyword or
                     SyntaxKind.SealedKeyword or
                     SyntaxKind.PartialKeyword or
                     SyntaxKind.VirtualKeyword or
                     SyntaxKind.AsyncKeyword or
                     SyntaxKind.OpenKeyword or
                     SyntaxKind.RecordKeyword or
                     SyntaxKind.OverrideKeyword ||
                (kind == SyntaxKind.ExternKeyword &&
                 (IsExternConstDeclarationStart() || MacroDeclarationParser(self).IsDeclarationStartAfterModifiers()))) {
                modifiers = modifiers.Add(ReadToken())
            } else {
                break
            }
        }

        return modifiers
    }

    private func IsExternConstDeclarationStart() -> bool {
        var offset = 1
        while (true) {
            let kind = PeekToken(offset).Kind
            if (kind == SyntaxKind.ConstKeyword) {
                return true
            }

            if (kind is not (SyntaxKind.PublicKeyword or SyntaxKind.PrivateKeyword or
                SyntaxKind.InternalKeyword or SyntaxKind.ProtectedKeyword or SyntaxKind.FileprivateKeyword or
                SyntaxKind.StaticKeyword or SyntaxKind.ReadonlyKeyword)) {
                return false
            }
            offset++
        }
    }

}
