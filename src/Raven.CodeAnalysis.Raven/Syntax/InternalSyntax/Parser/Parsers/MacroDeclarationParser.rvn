namespace Raven.CodeAnalysis.Syntax.InternalSyntax.Parser

import System.*
import System.Linq.*
import Raven.CodeAnalysis.Syntax.InternalSyntax.SyntaxFactory.*

internal class MacroDeclarationParser : SyntaxParser {
    init(parent: ParseContext) : base(parent) {
    }

    override val IsInMacro: bool => true

    func IsDeclarationStart() -> bool
        => IsMacroKeyword(PeekToken()) && IsDeclarationNameOrRecoveryStart(1)

    func IsDeclarationStartAfterModifiers() -> bool {
        var offset = 0
        while IsDeclarationModifier(PeekToken(offset).Kind) { offset++ }

        return IsMacroKeyword(PeekToken(offset)) && IsDeclarationNameOrRecoveryStart(offset + 1)
    }

    func Parse(attributeLists: SyntaxList, modifiers: SyntaxList) -> MacroDeclarationSyntax {
        if !IsDeclarationStart() {
            throw InvalidOperationException("The current token does not begin a macro declaration.")
        }

        let macroKeyword = ReadToken()
        let identifier: SyntaxToken = if CanTokenBeIdentifier(PeekToken()) {
            ReadIdentifierToken()
        } else {
            let missing = MissingToken(SyntaxKind.IdentifierToken)
            AddDiagnostic(DiagnosticInfo.Create(CompilerDiagnostics.IdentifierExpected, GetEndOfLastToken()))
            missing
        }

        var typeParameterList: TypeParameterListSyntax? = null
        if IsNextToken(SyntaxKind.LessThanToken, out _) {
            let typeParameterParser = TypeDeclarationParser(self)
            typeParameterList = typeParameterParser.ParseTypeParameterList()
        }

        let parameterList = StatementSyntaxParser(self).ParseParameterList(allowMacroTargetModifier: true)
        let returnType = TypeAnnotationClauseSyntaxParser(self).ParseReturnTypeAnnotation()
        let constraintClauses = ConstrainClauseListParser(self).ParseConstraintClauseList()
        let capabilityClauses = ParseCapabilityClauses()
        let isExtern = modifiers.GetChildren().Any(child => child.IsKind(SyntaxKind.ExternKeyword))

        var body: BlockStatementSyntax? = null
        var expressionBody: ArrowExpressionClauseSyntax? = null
        if IsNextToken(SyntaxKind.OpenBraceToken, out _) {
            body = StatementSyntaxParser(self).ParseBlockStatementSyntax()
        } else if IsNextToken(SyntaxKind.FatArrowToken, out _) {
            expressionBody = ExpressionSyntaxParser(self).ParseArrowExpressionClause()
        } else if !isExtern {
            body = StatementSyntaxParser(self).ParseBlockStatementSyntax()
        }

        TryConsumeTerminator(out let terminatorToken)
        return MacroDeclaration(attributeLists, modifiers, macroKeyword, identifier,
            typeParameterList, parameterList, returnType, constraintClauses,
            capabilityClauses, body, expressionBody, terminatorToken)
    }

    private func ParseCapabilityClauses() -> SyntaxList {
        let restoreNewlinesAsTokens = TreatNewlinesAsTokens
        SetTreatNewlinesAsTokens(false)
        try {
            while IsNewLineLike(PeekToken()) { ReadToken() }

            let clauses = System.Collections.Generic.List<GreenNode>()
            while IsCapabilityKeyword(PeekToken()) && PeekToken(1).IsKind(SyntaxKind.ByKeyword) {
                let capabilityKeyword = ReadToken()
                let byKeyword = ReadToken()
                let handler = ExpressionSyntaxParser(self).ParseExpression()
                clauses.Add(MacroCapabilityClause(capabilityKeyword, byKeyword, handler))
            }

            return List(clauses)
        } finally {
            SetTreatNewlinesAsTokens(restoreNewlinesAsTokens)
        }
    }

    private static func IsCapabilityKeyword(token: SyntaxToken) -> bool
        => token.IsKind(SyntaxKind.IdentifierToken) &&
            token.GetValueText() is "keywords" or "tokens" or "tokenKinds" or
                "highlighting" or "fragments" or "symbols" or "completion" or "projection"

    private static func IsNewLineLike(token: SyntaxToken) -> bool
        => token.Kind is SyntaxKind.LineFeedToken or SyntaxKind.CarriageReturnToken or SyntaxKind.CarriageReturnLineFeedToken

    internal static func IsMacroKeyword(token: SyntaxToken) -> bool => IsContextualKeyword(token, "macro")

    private func IsDeclarationNameOrRecoveryStart(offset: int) -> bool {
        let token = PeekToken(offset)
        return CanTokenBeIdentifier(token) || token.IsKind(SyntaxKind.OpenParenToken)
    }

    private static func IsDeclarationModifier(kind: SyntaxKind) -> bool
        => kind is SyntaxKind.PublicKeyword or SyntaxKind.PrivateKeyword or
            SyntaxKind.InternalKeyword or SyntaxKind.ProtectedKeyword or
            SyntaxKind.FileprivateKeyword or SyntaxKind.StaticKeyword or SyntaxKind.ExternKeyword or
            SyntaxKind.RefKeyword or SyntaxKind.ReadonlyKeyword or
            SyntaxKind.AbstractKeyword or SyntaxKind.FinalKeyword or
            SyntaxKind.SealedKeyword or SyntaxKind.PartialKeyword or
            SyntaxKind.VirtualKeyword or SyntaxKind.AsyncKeyword or
            SyntaxKind.OpenKeyword or SyntaxKind.RecordKeyword or SyntaxKind.OverrideKeyword

    private static func IsContextualKeyword(token: SyntaxToken, value: string) -> bool
        => token.IsKind(SyntaxKind.IdentifierToken) && string.Equals(token.GetValueText(), value, StringComparison.Ordinal)
}
