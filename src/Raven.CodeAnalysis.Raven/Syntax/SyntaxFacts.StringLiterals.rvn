namespace Raven.CodeAnalysis.Syntax

import System.*
import System.Text.*

public static partial class SyntaxFacts {
    static func DecodeStringLiteralContent(text: ReadOnlySpan<char>, out hadInvalidEscape: bool) -> string {
        if text.IsEmpty {
            hadInvalidEscape = false
            return string.Empty
        }
        let builder = StringBuilder(text.Length)
        hadInvalidEscape = false
        var i = 0
        while i < text.Length {
            let ch = text[i]
            if ch != '\\' {
                builder.Append(ch)
                i++
                continue
            }
            if i + 1 >= text.Length {
                hadInvalidEscape = true
                builder.Append('?')
                break
            }
            i++
            let escape = text[i]
            escape match {
                '"' => builder.Append('"')
                '\'' => builder.Append('\'')
                '\\' => builder.Append('\\')
                '0' => builder.Append('\0')
                'a' => builder.Append('\a')
                'b' => builder.Append('\b')
                'f' => builder.Append('\f')
                'n' => builder.Append('\n')
                'r' => builder.Append('\r')
                't' => builder.Append('\t')
                'v' => builder.Append('\v')
                '$' => builder.Append('$')
                'u' => {
                    let remaining = text[(i + 1)..]
                    var rune: Rune = default
                    var consumed = 0
                    if !TryDecodeUnicodeEscape(remaining, 4, true, out rune, out consumed) {
                        hadInvalidEscape = true
                        builder.Append('?')
                        i += consumed
                    } else {
                        builder.Append(rune.ToString())
                        i += consumed
                    }
                }
                'U' => {
                    let remaining = text[(i + 1)..]
                    var rune: Rune = default
                    var consumed = 0
                    if !TryDecodeUnicodeEscape(remaining, 8, false, out rune, out consumed) {
                        hadInvalidEscape = true
                        builder.Append('?')
                        i += consumed
                    } else {
                        builder.Append(rune.ToString())
                        i += consumed
                    }
                }
                _ => {
                    hadInvalidEscape = true
                    builder.Append('?')
                }
            }
            i++
        }
        return builder.ToString()
    }

    static func TryDecodeUnicodeEscape(text: ReadOnlySpan<char>, digits: int, allowBraces: bool,
        out rune: Rune, out charsConsumed: int) -> bool {
        rune = default
        charsConsumed = 0
        if allowBraces && !text.IsEmpty && text[0] == '{' {
            var value = 0
            var digitCount = 0
            var i = 1
            while i < text.Length {
                let c = text[i]
                if c == '}' {
                    charsConsumed = i + 1
                    if digitCount == 0 { return false }
                    return Rune.TryCreate(value, out rune)
                }
                if !IsHexDigit(c) {
                    charsConsumed = i + 1
                    return false
                }
                value = (value << 4) + GetHexValue(c)
                if value > 0x10FFFF {
                    charsConsumed = i + 1
                    return false
                }
                digitCount++
                if digitCount > 8 {
                    charsConsumed = i + 1
                    return false
                }
                i++
            }
            charsConsumed = text.Length
            return false
        }
        if text.Length < digits {
            charsConsumed = text.Length
            return false
        }
        var scalar = 0
        var i = 0
        while i < digits {
            let c = text[i]
            if !IsHexDigit(c) {
                charsConsumed = i + 1
                return false
            }
            scalar = (scalar << 4) + GetHexValue(c)
            i++
        }
        charsConsumed = digits
        return Rune.TryCreate(scalar, out rune)
    }

    static func IsHexDigit(ch: char) -> bool {
        return (ch >= '0' && ch <= '9') || (ch >= 'a' && ch <= 'f') || (ch >= 'A' && ch <= 'F')
    }

    static func GetHexValue(ch: char) -> int {
        if ch >= '0' && ch <= '9' { return ch - '0' }
        if ch >= 'a' && ch <= 'f' { return ch - 'a' + 10 }
        if ch >= 'A' && ch <= 'F' { return ch - 'A' + 10 }
        throw ArgumentOutOfRangeException(nameof(ch))
    }
}
