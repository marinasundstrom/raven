namespace Raven.CodeAnalysis.Syntax

import System.*
import System.Collections.*
import System.Collections.Generic.*
import System.Linq.*
import Raven.CodeAnalysis.Text.*

public readonly struct SyntaxTokenList : IEnumerable<SyntaxToken> {
    static readonly field Empty: SyntaxTokenList = SyntaxTokenList(InternalSyntax.SyntaxList([]), null, 0)

    internal readonly field Green: InternalSyntax.SyntaxList

    private readonly field _parent: SyntaxNode?

    private readonly field _position: int

    private readonly field _span: TextSpan

    private readonly field _fullSpan: TextSpan

    internal init(greenList: InternalSyntax.SyntaxList, parent: SyntaxNode?, position: int) {
        Green = greenList ?? throw ArgumentNullException(nameof(greenList))
        _parent = parent
        _position = position
        GreenSpanHelper.ComputeSpanAndFullSpan(greenList, position, out _span, out _fullSpan)
    }

    val Count: int => Green.SlotCount

    val Span: TextSpan => _span

    val FullSpan: TextSpan => _fullSpan

    val self[index: int]: SyntaxToken {
        get {
            let child = (InternalSyntax.SyntaxToken)Green[index]!
            return SyntaxToken(child, _parent, _position + Green.GetChildStartPosition(index))
        }
    }

    func Add(syntaxToken: SyntaxToken) -> SyntaxTokenList => SyntaxTokenList(Green.Add(syntaxToken.Green), null, 0)

    func GetEnumerator() -> IEnumerator<SyntaxToken> {
        var i = 0
        while i < Count { yield self[i]; i++ }
    }

    func IEnumerable.GetEnumerator() -> IEnumerator => GetEnumerator()

    static func ==(left: SyntaxTokenList, right: SyntaxTokenList?) -> bool => Equals(left, right)

    static func !=(left: SyntaxTokenList, right: SyntaxTokenList?) -> bool => !Equals(left, right)

    static func ==(left: SyntaxTokenList?, right: SyntaxTokenList?) -> bool => Equals(left, right)

    static func !=(left: SyntaxTokenList?, right: SyntaxTokenList?) -> bool => !Equals(left, right)

    func Equals(other: SyntaxTokenList) -> bool => Green == other.Green && _parent == other._parent

    override func Equals(obj: object?) -> bool => obj is SyntaxTokenList other && Equals(other)

    override func GetHashCode() -> int => HashCode.Combine(Green, _parent)
}

public static partial class SyntaxFactory {
    static func TokenList() -> SyntaxTokenList => SyntaxTokenList.Empty

    static func TokenList(params tokens: IEnumerable<SyntaxToken>) -> SyntaxTokenList => SyntaxTokenList(InternalSyntax.SyntaxFactory.TokenList(tokens.Select(x => x.Green).ToArray()), null, 0)
}
