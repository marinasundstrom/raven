namespace Raven.CodeAnalysis.Syntax

import System.Runtime.CompilerServices.*

public static partial class SyntaxNodeExtensions {
    [Extension]
    static func NormalizeWhitespace<TSyntax>(node: TSyntax) -> TSyntax where TSyntax: SyntaxNode {
        return SyntaxNormalizer().Format(node, useFormatterAnnotation: false)
    }
}
