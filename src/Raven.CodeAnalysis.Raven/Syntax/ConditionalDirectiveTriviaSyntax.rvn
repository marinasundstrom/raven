namespace Raven.CodeAnalysis.Syntax

import Raven.CodeAnalysis.Text.*

public class ConditionalDirectiveTriviaSyntax : StructuredTriviaSyntax {
    internal init(greenNode: GreenNode, parent: SyntaxNode?, position: int) : base(greenNode, parent, position) { }

    private val GreenDirective: InternalSyntax.ConditionalDirectiveTriviaSyntax => (InternalSyntax.ConditionalDirectiveTriviaSyntax)Green

    val DirectiveToken: SyntaxToken => SyntaxToken((InternalSyntax.SyntaxToken)Green.GetSlot(0)!, self, Position + Green.GetChildStartPosition(0))

    val DirectiveKind: ConditionalDirectiveKind => GreenDirective.DirectiveKind

    val ConditionText: string => GreenDirective.ConditionText

    val IsBranchActive: bool => GreenDirective.IsBranchActive

    val BranchTaken: bool => GreenDirective.BranchTaken

    val KeywordSpan: TextSpan => TextSpan(Position + GreenDirective.KeywordOffset, GreenDirective.KeywordLength)

    val ConditionSpan: TextSpan => TextSpan(Position + GreenDirective.ConditionOffset, GreenDirective.ConditionLength)

    override func Accept(visitor: SyntaxVisitor) => visitor.DefaultVisit(self)

    override func Accept<TResult>(visitor: SyntaxVisitor<TResult>) -> TResult => visitor.DefaultVisit(self)
}
