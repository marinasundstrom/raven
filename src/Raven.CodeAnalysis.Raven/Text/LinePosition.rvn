namespace Raven.CodeAnalysis.Text

import System.*

public struct LinePosition : IComparable<LinePosition>, IEquatable<LinePosition> {
    public static val Zero: LinePosition = LinePosition(0, 0)

    public init(line: int, character: int) {
        if line < 0 {
            throw ArgumentOutOfRangeException(nameof(line), "Line must be non-negative.")
        }
        if character < 0 {
            throw ArgumentOutOfRangeException(nameof(character), "Character must be non-negative.")
        }
        Line = line
        Character = character
    }

    public val Character: int
    public val Line: int

    public func CompareTo(other: LinePosition) -> int {
        if Line < other.Line { return -1 }
        if Line > other.Line { return 1 }
        if Character < other.Character { return -1 }
        if Character > other.Character { return 1 }
        return 0
    }

    public func Equals(other: LinePosition) -> bool {
        return Line == other.Line && Character == other.Character
    }

    public override func Equals(obj: object?) -> bool {
        return obj is LinePosition other && Equals(other)
    }

    public override func GetHashCode() -> int => HashCode.Combine(Line, Character)
    public override func ToString() -> string => "Line ${Line}, Character ${Character}"

    public static func ==(left: LinePosition, right: LinePosition) -> bool => left.Equals(right)
    public static func !=(left: LinePosition, right: LinePosition) -> bool => !left.Equals(right)
    public static func <(left: LinePosition, right: LinePosition) -> bool => left.CompareTo(right) < 0
    public static func >(left: LinePosition, right: LinePosition) -> bool => left.CompareTo(right) > 0
    public static func <=(left: LinePosition, right: LinePosition) -> bool => left.CompareTo(right) <= 0
    public static func >=(left: LinePosition, right: LinePosition) -> bool => left.CompareTo(right) >= 0
}
