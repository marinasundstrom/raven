namespace Raven.CodeAnalysis.Text

public class TextLine {
    private readonly field _text: SourceText

    internal init(text: SourceText, lineNumber: int, start: int, end: int, endIncludingLineBreak: int) {
        _text = text
        LineNumber = lineNumber
        Start = start
        End = end
        EndIncludingLineBreak = endIncludingLineBreak
    }

    val LineNumber: int

    val Start: int

    val End: int

    val EndIncludingLineBreak: int

    val Span: TextSpan => TextSpan.FromBounds(Start, End)

    val SpanIncludingLineBreak: TextSpan => TextSpan.FromBounds(Start, EndIncludingLineBreak)

    override func ToString() -> string => _text.ToString(Span)
}
