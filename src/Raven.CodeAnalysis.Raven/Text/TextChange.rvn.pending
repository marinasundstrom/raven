namespace Raven.CodeAnalysis.Text

import System.Collections.Generic.*

public struct TextChange {
    private static field _noChanges: List<TextChange>?

    public val Span: TextSpan
    public val NewText: string
    public val NoChanges: IReadOnlyList<TextChange> {
        get {
            _noChanges ??= List<TextChange>()
            return _noChanges
        }
    }

    public init(span: TextSpan, newText: string) {
        Span = span
        NewText = newText
    }

    public override func ToString() -> string => "Span: ${Span}, NewText: ${NewText}"
}
