namespace Raven.CodeAnalysis.Text

public extension TextSpanExtensions for TextSpan {
    func Contains(innerSpan: TextSpan) -> bool {
        return self.Start <= innerSpan.Start && self.End >= innerSpan.End
    }

    func Contains(position: int) -> bool {
        return position >= self.Start && position < self.End
    }

    func IntersectsWith(otherSpan: TextSpan) -> bool {
        return self.Start < otherSpan.End && otherSpan.Start < self.End
    }
}
