    private func CreateParameterFields(iteratorMethod: MethodSymbol, enumeratorCancellationParameter: ParameterSymbol?, out parameterFieldMap: ImmutableDictionary<ParameterSymbol, SourceFieldSymbol>) -> ImmutableArray<SourceFieldSymbol> {
        if iteratorMethod.Parameters.IsDefaultOrEmpty {
            parameterFieldMap = ImmutableDictionary<ParameterSymbol, SourceFieldSymbol>.Empty
            return ImmutableArray<SourceFieldSymbol>.Empty
        }
        let orderedFields = ImmutableArray.CreateBuilder<SourceFieldSymbol>(iteratorMethod.Parameters.Length)
        let mapBuilder = ImmutableDictionary.CreateBuilder<ParameterSymbol, SourceFieldSymbol>(SymbolEqualityComparer.Default)
        for parameter in iteratorMethod.Parameters {
            let @field = CreateField("_${parameter . Name}" , parameter.Type)
            orderedFields.Add(@field)
            mapBuilder.Add(parameter, @field)
        }
        parameterFieldMap = mapBuilder.ToImmutable()
        return orderedFields.ToImmutable()
    }

    private func CreateField(name: string, type: TypeSymbol) -> SourceFieldSymbol {
        return SourceFieldSymbol(name, SubstituteMethodTypeParameters(type), isStatic: false, isMutable: true, isConst: false, constantValue: null, self, self, ContainingNamespace, s_emptyLocations, s_emptySyntax, declaredAccessibility: Accessibility.Internal)
    }

    private func CreateConstructor(compilation: StateMachineServices, iteratorMethod: MethodSymbol) -> SourceMethodSymbol {
        return SourceMethodSymbol(".ctor", compilation.GetSpecialType(SpecialType.System_Void), ImmutableArray<SourceParameterSymbol>.Empty, self, self, iteratorMethod.ContainingNamespace, s_emptyLocations, s_emptySyntax, isStatic: false, methodKind: MethodKind.Constructor, declaredAccessibility: Accessibility.Public)
    }

    private func CreateMoveNextMethod(compilation: StateMachineServices, iteratorMethod: MethodSymbol) -> SourceMethodSymbol {
        let boolType = compilation.GetSpecialType(SpecialType.System_Boolean)
        return SourceMethodSymbol("MoveNext", boolType, ImmutableArray<SourceParameterSymbol>.Empty, self, self, iteratorMethod.ContainingNamespace, s_emptyLocations, s_emptySyntax, isStatic: false, methodKind: MethodKind.Ordinary, declaredAccessibility: Accessibility.Public)
    }

    private func CreateAsyncMoveNextMethod(compilation: StateMachineServices, iteratorMethod: MethodSymbol) -> SourceMethodSymbol {
        let valueTaskBool = compilation.GetTypeByMetadataName("System.Threading.Tasks.ValueTask`1")as NamedTypeSymbol ?? compilation.ErrorTypeSymbol
        let boolType = compilation.GetSpecialType(SpecialType.System_Boolean)
        let returnType = (if valueTaskBool is NamedTypeSymbol valueTaskBoolNamed {
            valueTaskBoolNamed.Construct(boolType)
        } else {
            compilation.ErrorTypeSymbol
        }
        )
        let method = SourceMethodSymbol("MoveNextAsync", returnType, ImmutableArray<SourceParameterSymbol>.Empty, self, self, iteratorMethod.ContainingNamespace, s_emptyLocations, s_emptySyntax, isStatic: false, methodKind: MethodKind.ExplicitInterfaceImplementation, isAsync: true, declaredAccessibility: Accessibility.Private)
        let asyncEnumerator = compilation.GetTypeByMetadataName("System.Collections.Generic.IAsyncEnumerator`1")as NamedTypeSymbol
        if let interfaceMethod: MethodSymbol = asyncEnumerator?.Construct(ElementType).GetMembers("MoveNextAsync").OfType<MethodSymbol>().SingleOrDefault(func(m) => !m.IsStatic && m.Parameters.Length == 0) {
            method.SetExplicitInterfaceImplementations(ImmutableArray.Create(interfaceMethod))
        }
        return method
    }

    private func CreateAsyncDisposeMethod(compilation: StateMachineServices, iteratorMethod: MethodSymbol) -> SourceMethodSymbol {
        let valueTaskType = compilation.GetTypeByMetadataName("System.Threading.Tasks.ValueTask")as NamedTypeSymbol ?? compilation.ErrorTypeSymbol
        let method = SourceMethodSymbol("DisposeAsync", valueTaskType, ImmutableArray<SourceParameterSymbol>.Empty, self, self, iteratorMethod.ContainingNamespace, s_emptyLocations, s_emptySyntax, isStatic: false, isAsync: true, methodKind: MethodKind.ExplicitInterfaceImplementation, declaredAccessibility: Accessibility.Private)
        let asyncDisposable = compilation.GetTypeByMetadataName("System.IAsyncDisposable")as NamedTypeSymbol
        if let interfaceMethod: MethodSymbol = asyncDisposable?.GetMembers("DisposeAsync").OfType<MethodSymbol>().SingleOrDefault(func(m) => !m.IsStatic && m.Parameters.Length == 0) {
            method.SetExplicitInterfaceImplementations(ImmutableArray.Create(interfaceMethod))
        }
        return method
    }

    private func CreateCurrentProperty(compilation: StateMachineServices, iteratorMethod: MethodSymbol, elementType: TypeSymbol) -> SourcePropertySymbol {
        let property = SourcePropertySymbol("Current", elementType, self, self, iteratorMethod.ContainingNamespace, s_emptyLocations, s_emptySyntax, isStatic: false, declaredAccessibility: Accessibility.Public)
        let getter = SourceMethodSymbol("get_Current", elementType, ImmutableArray<SourceParameterSymbol>.Empty, property, self, iteratorMethod.ContainingNamespace, s_emptyLocations, s_emptySyntax, isStatic: false, methodKind: MethodKind.PropertyGet, declaredAccessibility: Accessibility.Public)
        property.SetAccessors(getter, null)
        return property
    }

    private func CreateNonGenericCurrentProperty(compilation: StateMachineServices, iteratorMethod: MethodSymbol) -> SourcePropertySymbol {
        let objectType = compilation.GetSpecialType(SpecialType.System_Object)
        let property = SourcePropertySymbol("System.Collections.IEnumerator.Current", objectType, self, self, iteratorMethod.ContainingNamespace, s_emptyLocations, s_emptySyntax, isStatic: false, metadataName: "System.Collections.IEnumerator.Current", declaredAccessibility: Accessibility.Private)
        let getter = SourceMethodSymbol("System.Collections.IEnumerator.get_Current", objectType, ImmutableArray<SourceParameterSymbol>.Empty, property, self, iteratorMethod.ContainingNamespace, s_emptyLocations, s_emptySyntax, isStatic: false, methodKind: MethodKind.PropertyGet, declaredAccessibility: Accessibility.Private)
        let enumerator = compilation.GetSpecialType(SpecialType.System_Collections_IEnumerator)
        if let interfaceGetter: MethodSymbol = enumerator.GetMembers("Current").OfType<PropertySymbol>().Single().GetMethod {
            getter.SetExplicitInterfaceImplementations(ImmutableArray.Create(interfaceGetter))
        }
        property.SetAccessors(getter, null)
        return property
    }

    private func CreateDisposeMethod(compilation: StateMachineServices, iteratorMethod: MethodSymbol) -> SourceMethodSymbol {
        let method = SourceMethodSymbol("Dispose", compilation.GetSpecialType(SpecialType.System_Void), ImmutableArray<SourceParameterSymbol>.Empty, self, self, iteratorMethod.ContainingNamespace, s_emptyLocations, s_emptySyntax, isStatic: false, methodKind: MethodKind.Ordinary, declaredAccessibility: Accessibility.Public)
        return method
    }

    private func CreateResetMethod(compilation: StateMachineServices, iteratorMethod: MethodSymbol) -> SourceMethodSymbol {
        let method = SourceMethodSymbol("Reset", compilation.GetSpecialType(SpecialType.System_Void), ImmutableArray<SourceParameterSymbol>.Empty, self, self, iteratorMethod.ContainingNamespace, s_emptyLocations, s_emptySyntax, isStatic: false, methodKind: MethodKind.Ordinary, declaredAccessibility: Accessibility.Public)
        return method
    }

    private func CreateGetEnumeratorMethod(compilation: StateMachineServices, iteratorMethod: MethodSymbol, elementType: TypeSymbol) -> SourceMethodSymbol {
        let enumerator = (NamedTypeSymbol)compilation.GetSpecialType(SpecialType.System_Collections_Generic_IEnumerator_T).Construct(elementType)
        let method = SourceMethodSymbol("GetEnumerator", enumerator, ImmutableArray<SourceParameterSymbol>.Empty, self, self, iteratorMethod.ContainingNamespace, s_emptyLocations, s_emptySyntax, isStatic: false, methodKind: MethodKind.Ordinary, declaredAccessibility: Accessibility.Public)
        return method
    }

    private func CreateNonGenericGetEnumeratorMethod(compilation: StateMachineServices, iteratorMethod: MethodSymbol) -> SourceMethodSymbol {
        let method = SourceMethodSymbol("System.Collections.IEnumerable.GetEnumerator", compilation.GetSpecialType(SpecialType.System_Collections_IEnumerator), ImmutableArray<SourceParameterSymbol>.Empty, self, self, iteratorMethod.ContainingNamespace, s_emptyLocations, s_emptySyntax, isStatic: false, methodKind: MethodKind.ExplicitInterfaceImplementation, declaredAccessibility: Accessibility.Private)
        let enumerable = compilation.GetSpecialType(SpecialType.System_Collections_IEnumerable)
        if let interfaceMethod: MethodSymbol = enumerable.GetMembers("GetEnumerator").OfType<MethodSymbol>().SingleOrDefault() {
            method.SetExplicitInterfaceImplementations(ImmutableArray.Create(interfaceMethod))
        }
        return method
    }

    private func CreateAsyncGetEnumeratorMethod(compilation: StateMachineServices, iteratorMethod: MethodSymbol, elementType: TypeSymbol) -> SourceMethodSymbol {
        let asyncEnumeratorDefinition = compilation.GetTypeByMetadataName("System.Collections.Generic.IAsyncEnumerator`1")as NamedTypeSymbol ?? compilation.ErrorTypeSymbol
        let asyncEnumeratorType = (if asyncEnumeratorDefinition is NamedTypeSymbol asyncEnumeratorNamed {
            asyncEnumeratorNamed.Construct(elementType)
        } else {
            compilation.ErrorTypeSymbol
        }
        )
        let cancellationTokenType = compilation.GetTypeByMetadataName("System.Threading.CancellationToken")as NamedTypeSymbol ?? compilation.ErrorTypeSymbol
        let method = SourceMethodSymbol("GetAsyncEnumerator", asyncEnumeratorType, ImmutableArray<SourceParameterSymbol>.Empty, self, self, iteratorMethod.ContainingNamespace, s_emptyLocations, s_emptySyntax, isStatic: false, methodKind: MethodKind.ExplicitInterfaceImplementation, declaredAccessibility: Accessibility.Private)
        let cancellationTokenParameter = SourceParameterSymbol("cancellationToken", cancellationTokenType, containingSymbol: method, containingType: self, containingNamespace: iteratorMethod.ContainingNamespace, locations: s_emptyLocations, declaringSyntaxReferences: s_emptySyntax, hasExplicitDefaultValue: true, explicitDefaultValue: null)
        method.SetParameters([cancellationTokenParameter])
        let asyncEnumerable = compilation.GetTypeByMetadataName("System.Collections.Generic.IAsyncEnumerable`1")as NamedTypeSymbol
        if let interfaceMethod: MethodSymbol = asyncEnumerable?.Construct(elementType).GetMembers("GetAsyncEnumerator").OfType<MethodSymbol>().SingleOrDefault(func(m) => !m.IsStatic && m.Parameters.Length == 1) {
            method.SetExplicitInterfaceImplementations(ImmutableArray.Create(interfaceMethod))
        }
        return method
    }

    private static func CreateInterfaceList(compilation: StateMachineServices, iteratorKind: IteratorMethodKind, elementType: TypeSymbol) -> ImmutableArray<NamedTypeSymbol> {
        let builder = ImmutableArray.CreateBuilder<NamedTypeSymbol>()
        if iteratorKind is IteratorMethodKind.Enumerable or IteratorMethodKind.Enumerator {
            let enumerator = compilation.GetSpecialType(SpecialType.System_Collections_IEnumerator)
            builder.Add(enumerator)
            let enumeratorGeneric = (NamedTypeSymbol)compilation.GetSpecialType(SpecialType.System_Collections_Generic_IEnumerator_T).Construct(elementType)
            builder.Add(enumeratorGeneric)
            if iteratorKind == IteratorMethodKind.Enumerable {
                let enumerable = compilation.GetSpecialType(SpecialType.System_Collections_IEnumerable)
                builder.Add(enumerable)
                let enumerableGeneric = (NamedTypeSymbol)compilation.GetSpecialType(SpecialType.System_Collections_Generic_IEnumerable_T).Construct(elementType)
                builder.Add(enumerableGeneric)
            }
        } else if iteratorKind is IteratorMethodKind.AsyncEnumerable or IteratorMethodKind.AsyncEnumerator {
            if let asyncEnumeratorDefinition: NamedTypeSymbol = compilation.GetTypeByMetadataName("System.Collections.Generic.IAsyncEnumerator`1")as NamedTypeSymbol {
                builder.Add((NamedTypeSymbol)asyncEnumeratorDefinition.Construct(elementType))
            }
            if let asyncDisposable: NamedTypeSymbol = compilation.GetTypeByMetadataName("System.IAsyncDisposable")as NamedTypeSymbol {
                builder.Add(asyncDisposable)
            }
            if iteratorKind == IteratorMethodKind.AsyncEnumerable {
                if let asyncEnumerableDefinition: NamedTypeSymbol = compilation.GetTypeByMetadataName("System.Collections.Generic.IAsyncEnumerable`1")as NamedTypeSymbol {
                    builder.Add((NamedTypeSymbol)asyncEnumerableDefinition.Construct(elementType))
                }
            }
        }
        return builder.ToImmutable()
    }

    private static func IsAsyncIteratorKind(kind: IteratorMethodKind) -> bool => kind is IteratorMethodKind.AsyncEnumerable or IteratorMethodKind.AsyncEnumerator
}
