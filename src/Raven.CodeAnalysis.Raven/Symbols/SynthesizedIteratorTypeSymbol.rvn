        if body is null {
            throw ArgumentNullException(nameof(body))
        }
        if GenericGetEnumeratorBody is not null && !ReferenceEquals(GenericGetEnumeratorBody, body) {
            throw InvalidOperationException("Generic GetEnumerator body already assigned.")
        }
        GenericGetEnumeratorBody = body
    }

