internal partial class SynthesizedIteratorTypeSymbol : SourceNamedTypeSymbol {
    private static readonly field s_emptyLocations: Location[] = Array.Empty<Location>()

    private static readonly field s_emptySyntax: SyntaxReference[] = Array.Empty<SyntaxReference>()

    private readonly field _methodToStateTypeParameters: Dictionary<TypeParameterSymbol, TypeParameterSymbol> = Dictionary<TypeParameterSymbol, TypeParameterSymbol>(SymbolEqualityComparer.Default)

    private field _substitutionContext: ConstructedNamedTypeSymbol? = null

    private field _hoistedLocals: ImmutableArray<SourceFieldSymbol> = default

    private readonly field _hoistedLocalMap: Dictionary<LocalSymbol, SourceFieldSymbol> = Dictionary<LocalSymbol, SourceFieldSymbol>(SymbolEqualityComparer.Default)

    private readonly field _parameterFieldMap: ImmutableDictionary<ParameterSymbol, SourceFieldSymbol>

    private readonly field _enumeratorCancellationParameter: ParameterSymbol?

    init(compilation: StateMachineServices, iteratorMethod: MethodSymbol, name: string, iteratorKind: IteratorMethodKind, elementType: TypeSymbol, selfType: TypeSymbol? = null) : base(name, compilation.GetSpecialType(SpecialType.System_Object), TypeKind.Class, iteratorMethod.ContainingSymbol ?? iteratorMethod, iteratorMethod.ContainingType, iteratorMethod.ContainingNamespace, s_emptyLocations, s_emptySyntax, isSealed: true, declaredAccessibility: Accessibility.Private) {
        if compilation is null {
            throw ArgumentNullException(nameof(compilation))
        }
        if iteratorMethod is null {
            throw ArgumentNullException(nameof(iteratorMethod))
        }
        if elementType is null {
            throw ArgumentNullException(nameof(elementType))
        }
        Services = compilation
        IteratorMethod = iteratorMethod
        IteratorKind = iteratorKind
        InitializeTypeParameters(iteratorMethod)
        let substitutedElementType = SubstituteMethodTypeParameters(elementType)
        ElementType = substitutedElementType
        StateField = CreateField("_state", compilation.GetSpecialType(SpecialType.System_Int32))
        CurrentField = CreateField("_current", substitutedElementType)
        if !iteratorMethod.IsStatic && iteratorMethod is not SourceLambdaSymbol {
            let thisType = selfType ?? iteratorMethod.ContainingType ?? compilation.GetSpecialType(SpecialType.System_Object)
            ThisField = CreateField("_this", thisType)
        }
        _enumeratorCancellationParameter = AsyncIteratorCancellationUtilities.GetEffectiveEnumeratorCancellationParameter(compilation, iteratorMethod, iteratorKind)
        ParameterFields = CreateParameterFields(iteratorMethod, _enumeratorCancellationParameter, out _parameterFieldMap)
        if let cancellationParameter: ParameterSymbol = _enumeratorCancellationParameter {
            EnumeratorCancellationOriginalParameterField = CreateField("_${cancellationParameter.Name}Original" , cancellationParameter.Type)
            if let cancellationTokenSourceType: NamedTypeSymbol = compilation.GetTypeByMetadataName("System.Threading.CancellationTokenSource") {
                CombinedTokensField = CreateField("_combinedTokens", cancellationTokenSourceType)
            }
        }
        _hoistedLocals = ImmutableArray<SourceFieldSymbol>.Empty
        Constructor = CreateConstructor(compilation, iteratorMethod)
        MoveNextMethod = CreateMoveNextMethod(compilation, iteratorMethod)
        CurrentProperty = CreateCurrentProperty(compilation, iteratorMethod, substitutedElementType)
        if IsAsyncIteratorKind(iteratorKind) {
            AsyncMoveNextMethod = CreateAsyncMoveNextMethod(compilation, iteratorMethod)
            AsyncDisposeMethod = CreateAsyncDisposeMethod(compilation, iteratorMethod)
        } else {
            NonGenericCurrentProperty = CreateNonGenericCurrentProperty(compilation, iteratorMethod)
            DisposeMethod = CreateDisposeMethod(compilation, iteratorMethod)
            ResetMethod = CreateResetMethod(compilation, iteratorMethod)
        }
        if iteratorKind == IteratorMethodKind.Enumerable {
            GenericGetEnumeratorMethod = CreateGetEnumeratorMethod(compilation, iteratorMethod, substitutedElementType)
            NonGenericGetEnumeratorMethod = CreateNonGenericGetEnumeratorMethod(compilation, iteratorMethod)
        } else if iteratorKind == IteratorMethodKind.AsyncEnumerable {
            AsyncGetEnumeratorMethod = CreateAsyncGetEnumeratorMethod(compilation, iteratorMethod, substitutedElementType)
        }
        SetInterfaces(CreateInterfaceList(compilation, iteratorKind, substitutedElementType))
    }

    private func InitializeTypeParameters(method: MethodSymbol) {
        if method.TypeParameters.IsDefaultOrEmpty {
            return
        }
        let parameters = ImmutableArray.CreateBuilder<TypeParameterSymbol>(method.TypeParameters.Length)
        for parameter in method.TypeParameters {
            let source = parameter as SourceTypeParameterSymbol
            let synthesized = SourceTypeParameterSymbol(parameter.Name, self, self, ContainingNamespace, s_emptyLocations, s_emptySyntax, parameter.Ordinal, source?.ConstraintKind ?? TypeParameterConstraintKind.None, source?.ConstraintTypeReferences ?? ImmutableArray<SyntaxReference>.Empty, parameter.Variance)
            parameters.Add(synthesized)
            _methodToStateTypeParameters.Add(parameter, synthesized)
        }
        SetTypeParameters(parameters.MoveToImmutable())
        _substitutionContext = ConstructedNamedTypeSymbol(self, TypeParameters.Cast<TypeSymbol>().ToImmutableArray())
        for parameter in method.TypeParameters {
            if parameter is SourceTypeParameterSymbol { HasResolvedConstraintTypes: true } source {
                ((SourceTypeParameterSymbol)_methodToStateTypeParameters[parameter]).SetConstraintTypes(source.ConstraintTypes.Select(SubstituteMethodTypeParameters).ToImmutableArray())
            }
        }
    }

    private func SubstituteMethodTypeParameters(type: TypeSymbol) -> TypeSymbol => _substitutionContext?.Substitute(type, _methodToStateTypeParameters) ?? type

    internal func GetConstructedStateMachine(method: MethodSymbol) -> NamedTypeSymbol {
        if !ReferenceEquals(method, IteratorMethod) {
            throw ArgumentException("State machine constructed for different method.", nameof(method))
        }
        if !TypeParameters.IsDefaultOrEmpty {
            return ConstructedNamedTypeSymbol(self, method.TypeParameters.Cast<TypeSymbol>().ToImmutableArray())
        }
        var nextOwner: NamedTypeSymbol? = ContainingType
        while let owner: NamedTypeSymbol = nextOwner {
            if !owner.TypeParameters.IsDefaultOrEmpty {
                return ConstructedNamedTypeSymbol(self, ImmutableArray<TypeSymbol>.Empty)
            }
            nextOwner = owner.ContainingType
        }
        return self
    }

    val Services: StateMachineServices {
        get;
    }

    val IteratorMethod: MethodSymbol {
        get;
    }

    val IteratorKind: IteratorMethodKind {
        get;
    }

    val ElementType: TypeSymbol {
        get;
    }

    val StateField: SourceFieldSymbol {
        get;
    }

    val CurrentField: SourceFieldSymbol {
        get;
    }

    val ThisField: SourceFieldSymbol? {
        get;
    }

    val ParameterFields: ImmutableArray<SourceFieldSymbol> {
        get;
    }

    val ParameterFieldMap: ImmutableDictionary<ParameterSymbol, SourceFieldSymbol> => _parameterFieldMap

    val EnumeratorCancellationParameter: ParameterSymbol? => _enumeratorCancellationParameter

    val EnumeratorCancellationOriginalParameterField: SourceFieldSymbol? {
        get;
    }

    val CombinedTokensField: SourceFieldSymbol? {
        get;
    }

    val HoistedLocals: ImmutableArray<SourceFieldSymbol> => _hoistedLocals

    val Constructor: SourceMethodSymbol {
        get;
    }

    val MoveNextMethod: SourceMethodSymbol {
        get;
    }

    val OriginalBody: BoundBlockStatement? {
        get;
        private set;
    }

    val MoveNextBody: BoundBlockStatement? {
        get;
        private set;
    }

    val CurrentGetterBody: BoundBlockStatement? {
        get;
        private set;
    }

    val NonGenericCurrentGetterBody: BoundBlockStatement? {
        get;
        private set;
    }

    val DisposeBody: BoundBlockStatement? {
        get;
        private set;
    }

    val AsyncDisposeBody: BoundBlockStatement? {
        get;
        private set;
    }

    val ResetBody: BoundBlockStatement? {
        get;
        private set;
    }

    val GenericGetEnumeratorBody: BoundBlockStatement? {
        get;
        private set;
    }

    val NonGenericGetEnumeratorBody: BoundBlockStatement? {
        get;
        private set;
    }

    val AsyncMoveNextBody: BoundBlockStatement? {
        get;
        private set;
    }

    val AsyncGetEnumeratorBody: BoundBlockStatement? {
        get;
        private set;
    }

    val CurrentProperty: SourcePropertySymbol {
        get;
    }

    val NonGenericCurrentProperty: SourcePropertySymbol? {
        get;
    }

    val DisposeMethod: SourceMethodSymbol? {
        get;
    }

    val ResetMethod: SourceMethodSymbol? {
        get;
    }

    val GenericGetEnumeratorMethod: SourceMethodSymbol? {
        get;
    }

    val NonGenericGetEnumeratorMethod: SourceMethodSymbol? {
        get;
    }

    val AsyncMoveNextMethod: SourceMethodSymbol? {
        get;
    }

    val AsyncDisposeMethod: SourceMethodSymbol? {
        get;
    }

    val AsyncGetEnumeratorMethod: SourceMethodSymbol? {
        get;
    }

    func AddHoistedLocal(name: string, type: TypeSymbol, local: LocalSymbol? = null) -> SourceFieldSymbol {
        if string.IsNullOrEmpty(name) {
            throw ArgumentException("Field name cannot be null or empty.", nameof(name))
        }
        if type is null {
            throw ArgumentNullException(nameof(type))
        }
        let @field = CreateField(name, type)
        if let capturedLocal: LocalSymbol = local {
            _hoistedLocalMap[capturedLocal] = @field
        }
        _hoistedLocals = _hoistedLocals.Add(@field)
        return @field
    }

    internal func TryGetHoistedLocalField(local: LocalSymbol, out @field: SourceFieldSymbol) -> bool => _hoistedLocalMap.TryGetValue(local, out @field!)

    func SetOriginalBody(body: BoundBlockStatement) {
        ArgumentNullException.ThrowIfNull(body)
        if OriginalBody is not null && !ReferenceEquals(OriginalBody, body) {
            throw InvalidOperationException("Original body already assigned.")
        }
        OriginalBody = body
    }

    func SetMoveNextBody(body: BoundBlockStatement) {
        if body is null {
            throw ArgumentNullException(nameof(body))
        }
        if MoveNextBody is not null && !ReferenceEquals(MoveNextBody, body) {
            throw InvalidOperationException("MoveNext body already assigned.")
        }
        MoveNextBody = body
    }

    func SetCurrentGetterBody(body: BoundBlockStatement) {
        if body is null {
            throw ArgumentNullException(nameof(body))
        }
        if CurrentGetterBody is not null && !ReferenceEquals(CurrentGetterBody, body) {
            throw InvalidOperationException("Current getter body already assigned.")
        }
        CurrentGetterBody = body
    }

    func SetNonGenericCurrentGetterBody(body: BoundBlockStatement) {
        if body is null {
            throw ArgumentNullException(nameof(body))
        }
        if NonGenericCurrentGetterBody is not null && !ReferenceEquals(NonGenericCurrentGetterBody, body) {
            throw InvalidOperationException("Non-generic Current getter body already assigned.")
        }
        NonGenericCurrentGetterBody = body
    }

    func SetDisposeBody(body: BoundBlockStatement) {
        if body is null {
            throw ArgumentNullException(nameof(body))
        }
        if DisposeBody is not null && !ReferenceEquals(DisposeBody, body) {
            throw InvalidOperationException("Dispose body already assigned.")
        }
        DisposeBody = body
    }

    func SetAsyncDisposeBody(body: BoundBlockStatement) {
        if body is null {
            throw ArgumentNullException(nameof(body))
        }
        if AsyncDisposeBody is not null && !ReferenceEquals(AsyncDisposeBody, body) {
            throw InvalidOperationException("Async dispose body already assigned.")
        }
        AsyncDisposeBody = body
    }

    func SetResetBody(body: BoundBlockStatement) {
        if body is null {
