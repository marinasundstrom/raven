namespace Raven.CodeAnalysis.Symbols

import System.*
import System.Reflection.*

internal static class PEReflectionTypeIdentity {
    static func AreEquivalent(left: Type?, right: Type?) -> bool {
        if ReferenceEquals(left, right) { return true }
        if left is null || right is null { return false }

        if left!.IsByRef || right!.IsByRef {
            if !(left!.IsByRef && right!.IsByRef) { return false }
            return AreEquivalent(left!.GetElementType(), right!.GetElementType())
        }

        if left!.IsPointer || right!.IsPointer {
            if !(left!.IsPointer && right!.IsPointer) { return false }
            return AreEquivalent(left!.GetElementType(), right!.GetElementType())
        }

        if left!.IsArray || right!.IsArray {
            if !(left!.IsArray && right!.IsArray) { return false }
            if left!.IsSZArray != right!.IsSZArray || left!.GetArrayRank() != right!.GetArrayRank() { return false }
            return AreEquivalent(left!.GetElementType(), right!.GetElementType())
        }

        if left!.IsGenericParameter || right!.IsGenericParameter {
            return AreEquivalentGenericParameter(left!, right!)
        }

        if left!.IsGenericType || right!.IsGenericType {
            return AreEquivalentGenericType(left!, right!)
        }

        return AreEquivalentNominalType(left!, right!)
    }

    private static func AreEquivalentNominalType(left: Type, right: Type) -> bool {
        let leftMetadataName = GetMetadataName(left)
        let rightMetadataName = GetMetadataName(right)
        if !string.Equals(leftMetadataName, rightMetadataName, StringComparison.Ordinal) {
            return false
        }

        return string.Equals(left.Assembly.GetName().Name, right.Assembly.GetName().Name,
            StringComparison.OrdinalIgnoreCase)
    }

    private static func AreEquivalentGenericParameter(left: Type, right: Type) -> bool {
        if !(left.IsGenericParameter && right.IsGenericParameter) { return false }
        if left.GenericParameterPosition != right.GenericParameterPosition { return false }
        let leftDeclaringMethod = left.DeclaringMethod
        let rightDeclaringMethod = right.DeclaringMethod

        if leftDeclaringMethod is not null || rightDeclaringMethod is not null {
            if leftDeclaringMethod is null || rightDeclaringMethod is null { return false }
            return string.Equals(leftDeclaringMethod!.Name, rightDeclaringMethod!.Name, StringComparison.Ordinal) &&
                AreEquivalent(leftDeclaringMethod!.DeclaringType, rightDeclaringMethod!.DeclaringType)
        }

        return AreEquivalent(left.DeclaringType, right.DeclaringType)
    }

    private static func AreEquivalentGenericType(left: Type, right: Type) -> bool {
        if !(left.IsGenericType && right.IsGenericType) { return false }
        let leftDefinition = if left.IsGenericTypeDefinition { left } else { left.GetGenericTypeDefinition() }
        let rightDefinition = if right.IsGenericTypeDefinition { right } else { right.GetGenericTypeDefinition() }

        // Definitions are nominal identities. Recursing through their type
        // parameters revisits the same declaring definition across load contexts.
        if !AreEquivalentNominalType(leftDefinition, rightDefinition) { return false }
        if left.IsGenericTypeDefinition || right.IsGenericTypeDefinition {
            return left.IsGenericTypeDefinition && right.IsGenericTypeDefinition
        }

        let leftArguments = left.GetGenericArguments()
        let rightArguments = right.GetGenericArguments()
        if leftArguments.Length != rightArguments.Length { return false }

        var i = 0
        while i < leftArguments.Length {
            if !AreEquivalent(leftArguments[i], rightArguments[i]) { return false }
            i++
        }

        return true
    }

    private static func GetMetadataName(type: Type) -> string {
        if type.DeclaringType is { } declaringType {
            let declaringName = GetMetadataName(declaringType)
            return "${declaringName}+${type.Name}"
        }

        return type.FullName ?? type.Name
    }
}
