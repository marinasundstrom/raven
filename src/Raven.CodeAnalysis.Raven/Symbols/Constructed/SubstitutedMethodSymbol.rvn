namespace Raven.CodeAnalysis.Symbols

import System.*
import System.Collections.Concurrent.*
import System.Collections.Generic.*
import System.Collections.Immutable.*
import System.Diagnostics.*
import System.Linq.*
import Raven.CodeAnalysis.*
import Raven.CodeAnalysis.Documentation.*
import Raven.CodeAnalysis.Metadata.*

internal class SubstitutedMethodSymbol : MethodSymbol {
    private readonly field _original: MethodSymbol

    private readonly field _constructed: ConstructedNamedTypeSymbol

    private readonly field _associatedSymbol: Symbol?

    private field _parameters: ImmutableArray<ParameterSymbol>? = null

    private field _constraintTypeMap: Dictionary<TypeParameterSymbol, ImmutableArray<TypeSymbol>>? = null

    private field _explicitInterfaceImplementations: ImmutableArray<MethodSymbol>? = null

    private readonly field _typeParameters: ImmutableArray<TypeParameterSymbol>

    private readonly field _methodTypeParameterMap: Dictionary<TypeParameterSymbol, TypeParameterSymbol>

    private field _returnType: TypeSymbol? = null

    init(original: MethodSymbol, constructed: ConstructedNamedTypeSymbol, associatedSymbol: Symbol? = null) {
        _original = original
        _constructed = constructed
        _associatedSymbol = associatedSymbol
        if !_original.TypeParameters.IsDefaultOrEmpty {
            let builder = ImmutableArray.CreateBuilder<TypeParameterSymbol>(_original.TypeParameters.Length)
            _methodTypeParameterMap = Dictionary<TypeParameterSymbol, TypeParameterSymbol>(_original.TypeParameters.Length, TypeParameterSubstitutionComparer.Instance)
            for typeParameter in _original.TypeParameters {
                let substituted = SubstitutedMethodTypeParameterSymbol(typeParameter, self, _constructed, _constructed.ContainingNamespace ?? typeParameter.ContainingNamespace)
                builder.Add(substituted)
                _methodTypeParameterMap[typeParameter] = substituted
            }
            _typeParameters = builder.ToImmutable()
        } else {
            _typeParameters = (if _original.TypeParameters.IsDefault {
                ImmutableArray<TypeParameterSymbol>.Empty
            } else {
                _original.TypeParameters
            }
            )
            _methodTypeParameterMap = Dictionary<TypeParameterSymbol, TypeParameterSymbol>(TypeParameterSubstitutionComparer.Instance)
        }
    }

    val DeclaredFunctionType: TypeSymbol? => (if let type: TypeSymbol = _original.DeclaredFunctionType {
        _constructed.Substitute(type, _methodTypeParameterMap)
    } else {
        null
    }
    )

    val Name: string => _original.Name

    val ReturnType: TypeSymbol => {
        _returnType ??= _constructed.ReanchorNestedTypeIfNeeded(_constructed.Substitute(_original.ReturnType, _methodTypeParameterMap), _methodTypeParameterMap)
        _returnType!
    }

    val Parameters: ImmutableArray<ParameterSymbol> => {
        _parameters ??= (if let shape: IStructuralFunctionIdentity = DeclaredFunctionType {
            shape.ParameterTypes.Select(func(type, index) => (ParameterSymbol)SourceParameterSymbol("arg${index}", type, self, ContainingType, ContainingNamespace, [], [], shape.ParameterRefKinds[index])).ToImmutableArray()
        } else {
            _original.Parameters.Select(func(p) => (ParameterSymbol)SubstitutedParameterSymbol(p, _constructed, _methodTypeParameterMap, self)).ToImmutableArray()
        }
        )
        _parameters!
    }

    val ContainingSymbol: Symbol => _constructed

    func GetReturnTypeAttributes() -> ImmutableArray<AttributeData> => _original.GetReturnTypeAttributes()

    val MethodKind: MethodKind => _original.MethodKind

    val IsConstructor: bool => _original.IsConstructor

    val OriginalDefinition: MethodSymbol? => _original

    val IsAbstract: bool => _original.IsAbstract

    val IsAsync: bool => _original.IsAsync

    val IsCheckedBuiltin: bool => _original.IsCheckedBuiltin

    val IsDefinition: bool => _original.IsDefinition

    val IsExtensionMethod: bool => _original.IsExtensionMethod

    val IsExtern: bool => _original.IsExtern

    val IsUnsafe: bool => _original.IsUnsafe

    val IsGenericMethod: bool => _original.IsGenericMethod

    val IsOverride: bool => _original.IsOverride

    val IsReadOnly: bool => _original.IsReadOnly

    val IsFinal: bool => _original.IsFinal

    val IsVirtual: bool => _original.IsVirtual

    val SetsRequiredMembers: bool => _original.SetsRequiredMembers

    val IsIterator: bool => _original.IsIterator

    val IteratorKind: IteratorMethodKind => _original.IteratorKind

    val IteratorElementType: TypeSymbol? => _original.IteratorElementType

    val ExplicitInterfaceImplementations: ImmutableArray<MethodSymbol> {
        get {
            if _explicitInterfaceImplementations.HasValue {
                return _explicitInterfaceImplementations.Value
            }
            let originals = _original.ExplicitInterfaceImplementations
            if originals.IsDefaultOrEmpty || originals.Length == 0 {
                _explicitInterfaceImplementations = originals
                return originals
            }
            let builder = ImmutableArray.CreateBuilder<MethodSymbol>(originals.Length)
            for origImpl in originals {
                let origIface: NamedTypeSymbol = origImpl.ContainingType else {
                    builder.Add(origImpl)
                    continue
                }
                // Substitute the interface type with the constructed type’s substitution
                let substitutedIface: NamedTypeSymbol = _constructed.Substitute(origIface) as NamedTypeSymbol else {
                    builder.Add(origImpl)
                    continue
                }
                if SymbolEqualityComparer.Default.Equals(origIface, substitutedIface) {
                    builder.Add(origImpl)
                    continue
                }
                // Find the corresponding method on the substituted interface
                var substitutedMethod: MethodSymbol? = null
                for candidate in substitutedIface.GetMembers(origImpl.Name).OfType<MethodSymbol>() {                    // Match via OriginalDefinition – this is the key
                    if SymbolEqualityComparer.Default.Equals(candidate.OriginalDefinition, origImpl.OriginalDefinition) {
                        substitutedMethod = candidate
                        break
                    }
                }
                builder.Add(substitutedMethod ?? origImpl)
            }
            _explicitInterfaceImplementations = builder.ToImmutable()
            return _explicitInterfaceImplementations.Value
        }
    }

    val TypeParameters: ImmutableArray<TypeParameterSymbol> => _typeParameters

    val TypeArguments: ImmutableArray<TypeSymbol> => _original.TypeArguments

    val ConstructedFrom: MethodSymbol? => _original.ConstructedFrom ?? _original

    val Kind: SymbolKind => _original.Kind

    val MetadataName: string => _original.MetadataName

    val ContainingAssembly: AssemblySymbol? => _original.ContainingAssembly

    val ContainingModule: ModuleSymbol? => _original.ContainingModule

    val ContainingType: NamedTypeSymbol? => _constructed

    val ContainingNamespace: NamespaceSymbol? => _original.ContainingNamespace

    val AssociatedSymbol: Symbol? => _associatedSymbol ?? _original.AssociatedSymbol

    val Locations: ImmutableArray<Location> => _original.Locations

    val DeclaredAccessibility: Accessibility => _original.DeclaredAccessibility

    val DeclaringSyntaxReferences: ImmutableArray<SyntaxReference> => _original.DeclaringSyntaxReferences

    val IsImplicitlyDeclared: bool => _original.IsImplicitlyDeclared

    val IsStatic: bool => _original.IsStatic

    val UnderlyingSymbol: Symbol => self

    val IsAlias: bool => false

    func GetAttributes() -> ImmutableArray<AttributeData> => _original.GetAttributes()

    func GetDocumentationComment() -> DocumentationComment? => _original.GetDocumentationComment()

    func Accept(visitor: SymbolVisitor) {
        visitor.VisitMethod(self)
    }

    func Accept<TResult>(visitor: SymbolVisitor<TResult>) -> TResult {
        return visitor.VisitMethod(self)
    }

    func Equals(other: Symbol?, comparer: SymbolEqualityComparer) -> bool => comparer.Equals(self, other)

    func Equals(other: Symbol?) -> bool => SymbolEqualityComparer.Default.Equals(self, other)

    func Construct(params typeArguments: TypeSymbol[]) -> MethodSymbol {
        return ConstructedMethodSymbol(self, typeArguments.ToImmutableArray(), _constructed)
    }

    internal func TryGetSubstitutedConstraintTypes(typeParameter: TypeParameterSymbol, out substituted: ImmutableArray<TypeSymbol>) -> bool {
        substituted = default
        if _typeParameters.IsDefaultOrEmpty || !_typeParameters.Any(func(tp) => TypeParameterSubstitutionComparer.Instance.Equals(tp, typeParameter)) {
            return false
        }
        _constraintTypeMap ??= Dictionary<TypeParameterSymbol, ImmutableArray<TypeSymbol>>(TypeParameterSubstitutionComparer.Instance)
        if _constraintTypeMap!.TryGetValue(typeParameter, out substituted) {
            return true
        }
        let originalConstraints = typeParameter.ConstraintTypes
        if originalConstraints.IsDefaultOrEmpty || originalConstraints.Length == 0 {
            substituted = originalConstraints
            (_constraintTypeMap!)[typeParameter] = substituted
            return true
        }
        let builder = ImmutableArray.CreateBuilder<TypeSymbol>(originalConstraints.Length)
        for constraint in originalConstraints {
            builder.Add(_constructed.Substitute(constraint, _methodTypeParameterMap))
        }
        substituted = builder.ToImmutable()
        (_constraintTypeMap!)[typeParameter] = substituted
        return true
    }

    private func GetDebuggerDisplay() -> string {
        try {
            return "${Kind}: ${self.ToDisplayString(SymbolDisplayFormat.FullyQualifiedFormat)}"
        } catch (Exception exc) {
            return "${Kind}: <${exc.GetType().Name}>"
        }
    }

    override func ToString() -> string {
        return self.ToDisplayString()
    }
}