namespace Raven.CodeAnalysis.Symbols

import System.*
import System.Collections.Concurrent.*
import System.Collections.Generic.*
import System.Collections.Immutable.*
import System.Diagnostics.*
import System.Linq.*
import Raven.CodeAnalysis.*
import Raven.CodeAnalysis.Documentation.*
import Raven.CodeAnalysis.Metadata.*

internal class SubstitutedEventSymbol : EventSymbol {
    private readonly field _original: EventSymbol

    private readonly field _constructed: ConstructedNamedTypeSymbol

    private field _explicitInterfaceImplementations: ImmutableArray<EventSymbol>? = null

    private field _addMethod: MethodSymbol? = null

    private field _removeMethod: MethodSymbol? = null

    init(original: EventSymbol, constructed: ConstructedNamedTypeSymbol) {
        _original = original
        _constructed = constructed
    }

    val Name: string => _original.Name

    val Type: TypeSymbol => _constructed.Substitute(_original.Type)

    val ContainingSymbol: Symbol => _constructed

    val AddMethod: MethodSymbol? => if let originalAccessor: MethodSymbol = _original.AddMethod {
        _addMethod ??= SubstitutedMethodSymbol(originalAccessor, _constructed, self)
        _addMethod
    } else {
        null
    }

    val RemoveMethod: MethodSymbol? => if let originalAccessor: MethodSymbol = _original.RemoveMethod {
        _removeMethod ??= SubstitutedMethodSymbol(originalAccessor, _constructed, self)
        _removeMethod
    } else {
        null
    }

    val Kind: SymbolKind => _original.Kind

    val MetadataName: string => _original.MetadataName

    val ContainingAssembly: AssemblySymbol? => _original.ContainingAssembly

    val ContainingModule: ModuleSymbol? => _original.ContainingModule

    val ContainingType: NamedTypeSymbol? => _constructed

    val ContainingNamespace: NamespaceSymbol? => _original.ContainingNamespace

    val Locations: ImmutableArray<Location> => _original.Locations

    val DeclaredAccessibility: Accessibility => _original.DeclaredAccessibility

    val DeclaringSyntaxReferences: ImmutableArray<SyntaxReference> => _original.DeclaringSyntaxReferences

    val IsImplicitlyDeclared: bool => _original.IsImplicitlyDeclared

    val IsStatic: bool => _original.IsStatic

    val UnderlyingSymbol: Symbol => self

    val IsAlias: bool => false

    func GetAttributes() -> ImmutableArray<AttributeData> => _original.GetAttributes()

    func GetDocumentationComment() -> DocumentationComment? => _original.GetDocumentationComment()

    val ExplicitInterfaceImplementations: ImmutableArray<EventSymbol> {
        get {
            if _explicitInterfaceImplementations.HasValue {
                return _explicitInterfaceImplementations.Value
            }
            let originals = _original.ExplicitInterfaceImplementations
            if originals.IsDefaultOrEmpty || originals.Length == 0 {
                _explicitInterfaceImplementations = originals
                return originals
            }
            let builder = ImmutableArray.CreateBuilder<EventSymbol>(originals.Length)
            for originalImplementation in originals {
                let originalInterfaceType: NamedTypeSymbol = originalImplementation.ContainingType else {
                    builder.Add(originalImplementation)
                    continue
                }
                let substitutedInterfaceType: NamedTypeSymbol = _constructed.Substitute(originalInterfaceType) as NamedTypeSymbol else {
                    builder.Add(originalImplementation)
                    continue
                }
                if SymbolEqualityComparer.Default.Equals(originalInterfaceType, substitutedInterfaceType) {
                    builder.Add(originalImplementation)
                    continue
                }
                var substitutedEvent: EventSymbol? = null
                for candidate in substitutedInterfaceType.GetMembers(originalImplementation.Name).OfType<EventSymbol>() {
                    if!SymbolEqualityComparer.Default.Equals(candidate.Type, originalImplementation.Type) {
                        continue
                    }
                    substitutedEvent = candidate
                    break
                }
                builder.Add(substitutedEvent ?? originalImplementation)
            }
            _explicitInterfaceImplementations = builder.ToImmutable()
            return _explicitInterfaceImplementations.Value
        }
    }

    func Accept(visitor: SymbolVisitor) => visitor.VisitEvent(self)

    func Accept<TResult>(visitor: SymbolVisitor<TResult>) -> TResult => visitor.VisitEvent(self)

    func Equals(other: Symbol?, comparer: SymbolEqualityComparer) -> bool => comparer.Equals(self, other)

    func Equals(other: Symbol?) -> bool => SymbolEqualityComparer.Default.Equals(self, other)
}