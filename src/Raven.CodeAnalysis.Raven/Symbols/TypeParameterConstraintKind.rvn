namespace Raven.CodeAnalysis

import System.*

[Flags]
public enum TypeParameterConstraintKind {
    None = 0,
    ReferenceType = 1 << 0,
    ValueType = 1 << 1,
    TypeConstraint = 1 << 2,
    NotNull = 1 << 3,
    Constructor = 1 << 4,
    AllowByRefLike = 1 << 5,

    /// <summary>A native neoCLR structural function signature; nominal delegates do not satisfy this constraint.</summary>
    FunctionType = 1 << 6,
}
