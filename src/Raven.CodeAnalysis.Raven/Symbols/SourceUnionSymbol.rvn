namespace Raven.CodeAnalysis.Symbols

import System.*
import System.Collections.Generic.*
import System.Collections.Immutable.*
import System.Diagnostics.CodeAnalysis.*
import System.Linq.*
import Raven.CodeAnalysis.*

internal class SourceUnionSymbol : SourceNamedTypeSymbol, UnionSymbol {
    internal override val HasMutableMemberShape: bool => true

    private field _variants: ImmutableArray<TypeSymbol> = ImmutableArray<TypeSymbol>.Empty

    private field _declaredCases: ImmutableArray<UnionCaseTypeSymbol> = ImmutableArray<UnionCaseTypeSymbol>.Empty

    private field _memberTypes: ImmutableArray<TypeSymbol> = ImmutableArray<TypeSymbol>.Empty

    private field _contentMayBeNull: bool = default

    init(name: string, baseType: NamedTypeSymbol, typeKind: TypeKind, containingSymbol: Symbol, containingType: NamedTypeSymbol?, containingNamespace: NamespaceSymbol?, locations: Location[], declaringSyntaxReferences: SyntaxReference[], declaredAccessibility: Accessibility, metadataName: string? = null): base(name, baseType, typeKind, containingSymbol, containingType, containingNamespace, locations, declaringSyntaxReferences, isSealed: true, declaredAccessibility: declaredAccessibility, metadataName: metadataName) {
    }

    override val IsReadOnly: bool => IsValueType

    val Variants: ImmutableArray<TypeSymbol> => _variants

    val DeclaredCaseTypes: ImmutableArray<UnionCaseTypeSymbol> => _declaredCases

    val MemberTypes: ImmutableArray<TypeSymbol> => _memberTypes

    val ContentMayBeNull: bool => _contentMayBeNull || _memberTypes.Any(UnionContentNullability.IsNullableContentType)

    val DiscriminatorField: FieldSymbol {
        get;
        private set;
    }
    = null!

    val PayloadField: FieldSymbol {
        get;
        private set;
    }
    = null!

    val PayloadFields: ImmutableArray<FieldSymbol> {
        get;
        private set;
    }
    = ImmutableArray<FieldSymbol>.Empty

    internal val CompanionType: SynthesizedUnionCompanionTypeSymbol? {
        get;
        private set;
    }

    internal func GetMetadataCaseContainer() -> NamedTypeSymbol {
        if!IsGenericType {
            return self
        }
        CompanionType ??= SynthesizedUnionCompanionTypeSymbol(self)
        return CompanionType!
    }

    internal func SetCases(cases: IEnumerable<UnionCaseTypeSymbol>) {
        _declaredCases = cases.ToImmutableArray()
    }

    internal func SetVariants(variants: IEnumerable<TypeSymbol>) {
        _variants = variants.ToImmutableArray()
    }

    internal func SetMemberTypes(memberTypes: IEnumerable<TypeSymbol>) {
        _memberTypes = memberTypes.ToImmutableArray()
    }

    internal func SetContentMayBeNull(contentMayBeNull: bool) {
        _contentMayBeNull = contentMayBeNull
    }

    internal func SetDiscriminatorField(discriminator: SourceFieldSymbol) {
        DiscriminatorField = discriminator
    }

    internal func SetPayloadFields(payloadFields: IEnumerable<SourceFieldSymbol>) {
        PayloadFields = payloadFields.ToImmutableArray<FieldSymbol>()
        if!PayloadFields.IsDefaultOrEmpty {
            PayloadField = PayloadFields[0]
        }
    }
}