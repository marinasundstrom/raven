namespace Raven.CodeAnalysis

import Raven.CodeAnalysis.Syntax.*

internal enum OperatorArity {
    Unary,
    Binary,
    CompoundAssignment,
    InstanceIncrement
}

internal readonly record struct UserDefinedOperatorInfo(MetadataName: string, Arity: OperatorArity)

internal static class OperatorFacts {
    static func TryGetUserDefinedOperatorInfo(declaration: OperatorDeclarationSyntax, out info: UserDefinedOperatorInfo) -> bool {
        if !TryGetUserDefinedOperatorInfo(declaration.OperatorToken.Kind, declaration.ParameterList.Parameters.Count, out info) {
            return false
        }
        if declaration.CheckedKeyword.Kind == SyntaxKind.CheckedKeyword {
            if let name: string = GetCheckedMetadataName(info.MetadataName) {
                info = info with { MetadataName = name }
            }
        }
        return true
    }

    static func TryGetConversionOperatorMetadataName(declaration: ConversionOperatorDeclarationSyntax, out name: string) -> bool {
        if !TryGetConversionOperatorMetadataName(declaration.ConversionKindKeyword.Kind, out name) {
            return false
        }
        if declaration.CheckedKeyword.Kind == SyntaxKind.CheckedKeyword {
            if let checkedName: string = GetCheckedMetadataName(name) {
                name = checkedName
            }
        }
        return true
    }

    internal static func GetCheckedMetadataName(name: string) -> string? => match name {
        "op_UnaryNegation" or "op_Increment" or "op_Decrement" or
        "op_Addition" or "op_Subtraction" or "op_Multiply" or "op_Division" or
        "op_Explicit" or "op_IncrementAssignment" or "op_DecrementAssignment" or
        "op_AdditionAssignment" or "op_SubtractionAssignment" or
        "op_MultiplicationAssignment" or "op_DivisionAssignment" => "op_Checked" + name[3..]
        _ => null
    }

    static func GetDisplayText(operatorToken: SyntaxKind) -> string => SyntaxFacts.GetSyntaxTokenText(operatorToken) ?? operatorToken.ToString()

    static func GetConversionOperatorDisplayText(conversionKindKeyword: SyntaxKind) -> string {
        let keywordText = SyntaxFacts.GetSyntaxTokenText(conversionKindKeyword) ?? conversionKindKeyword.ToString()
        return "${keywordText} operator"
    }

    static func TryGetConversionOperatorMetadataName(conversionKindKeyword: SyntaxKind, out metadataName: string) -> bool {
        metadataName = match conversionKindKeyword {
            SyntaxKind.ExplicitKeyword => "op_Explicit"
            SyntaxKind.ImplicitKeyword => "op_Implicit"
            _ => string.Empty
        }
        return metadataName.Length > 0
    }

    static func TryGetUserDefinedOperatorInfo(operatorToken: SyntaxKind, parameterCount: int, out info: UserDefinedOperatorInfo) -> bool {
        info = default
        if let compoundName: string = GetCompoundAssignmentMetadataName(operatorToken) {
            if parameterCount != 1 {
                return false
            }
            info = UserDefinedOperatorInfo(compoundName, OperatorArity.CompoundAssignment)
            return true
        }
        if parameterCount == 0 {
            if let incrementName: string = GetInstanceIncrementMetadataName(operatorToken) {
                info = UserDefinedOperatorInfo(incrementName, OperatorArity.InstanceIncrement)
                return true
            }
        }
        let arity: OperatorArity? = match parameterCount {
            1 => OperatorArity.Unary
            2 => OperatorArity.Binary
            _ => null
        }
        if arity is null {
            return false
        }
        let metadataName = if arity == OperatorArity.Unary {
            GetUnaryMetadataName(operatorToken)
        } else {
            GetBinaryMetadataName(operatorToken)
        }
        if let name: string = metadataName {
            info = UserDefinedOperatorInfo(name, arity.Value)
            return true
        }
        return false
    }

    static func GetExpectedParameterCountDescription(operatorToken: SyntaxKind) -> string {
        if GetCompoundAssignmentMetadataName(operatorToken) is not null {
            return "1"
        }
        return match operatorToken {
            SyntaxKind.PlusToken or SyntaxKind.MinusToken => "1 or 2"
            SyntaxKind.PlusPlusToken or SyntaxKind.MinusMinusToken => "0 or 1"
            SyntaxKind.ExclamationToken or SyntaxKind.TildeToken or SyntaxKind.TrueKeyword or SyntaxKind.FalseKeyword => "1"
            _ => "2"
        }
    }

    internal static func GetCompoundAssignmentMetadataName(operatorToken: SyntaxKind) -> string? => match operatorToken {
        SyntaxKind.PlusEqualsToken => "op_AdditionAssignment"
        SyntaxKind.MinusEqualsToken => "op_SubtractionAssignment"
        SyntaxKind.StarEqualsToken => "op_MultiplicationAssignment"
        SyntaxKind.SlashEqualsToken => "op_DivisionAssignment"
        SyntaxKind.PercentEqualsToken => "op_ModulusAssignment"
        SyntaxKind.LessThanLessThanEqualsToken => "op_LeftShiftAssignment"
        SyntaxKind.GreaterThanGreaterThanEqualsToken => "op_RightShiftAssignment"
        SyntaxKind.GreaterThanGreaterThanGreaterThanEqualsToken => "op_UnsignedRightShiftAssignment"
        SyntaxKind.AmpersandEqualsToken => "op_BitwiseAndAssignment"
        SyntaxKind.BarEqualsToken => "op_BitwiseOrAssignment"
        SyntaxKind.CaretEqualsToken => "op_ExclusiveOrAssignment"
        _ => null
    }

    internal static func GetInstanceIncrementMetadataName(token: SyntaxKind) -> string? => match token {
        SyntaxKind.PlusPlusToken => "op_IncrementAssignment"
        SyntaxKind.MinusMinusToken => "op_DecrementAssignment"
        _ => null
    }

    private static func GetUnaryMetadataName(operatorToken: SyntaxKind) -> string? => match operatorToken {
        SyntaxKind.PlusToken => "op_UnaryPlus"
        SyntaxKind.MinusToken => "op_UnaryNegation"
        SyntaxKind.PlusPlusToken => "op_Increment"
        SyntaxKind.MinusMinusToken => "op_Decrement"
        SyntaxKind.ExclamationToken => "op_LogicalNot"
        SyntaxKind.TildeToken => "op_OnesComplement"
        SyntaxKind.TrueKeyword => "op_True"
        SyntaxKind.FalseKeyword => "op_False"
        _ => null
    }

    private static func GetBinaryMetadataName(operatorToken: SyntaxKind) -> string? => match operatorToken {
        SyntaxKind.PlusToken => "op_Addition"
        SyntaxKind.MinusToken => "op_Subtraction"
        SyntaxKind.StarToken => "op_Multiply"
        SyntaxKind.SlashToken => "op_Division"
        SyntaxKind.PercentToken => "op_Modulus"
        SyntaxKind.CaretToken => "op_ExclusiveOr"
        SyntaxKind.AmpersandToken => "op_BitwiseAnd"
        SyntaxKind.AmpersandAmpersandToken or SyntaxKind.AndToken => "op_LogicalAnd"
        SyntaxKind.BarToken => "op_BitwiseOr"
        SyntaxKind.BarBarToken or SyntaxKind.OrToken => "op_LogicalOr"
        SyntaxKind.LessThanLessThanToken => "op_LeftShift"
        SyntaxKind.GreaterThanGreaterThanToken => "op_RightShift"
        SyntaxKind.GreaterThanGreaterThanGreaterThanToken => "op_UnsignedRightShift"
        SyntaxKind.EqualsEqualsToken => "op_Equality"
        SyntaxKind.NotEqualsToken => "op_Inequality"
        SyntaxKind.LessThanToken => "op_LessThan"
        SyntaxKind.LessThanOrEqualsToken => "op_LessThanOrEqual"
        SyntaxKind.GreaterThanToken => "op_GreaterThan"
        SyntaxKind.GreaterThanOrEqualsToken => "op_GreaterThanOrEqual"
        _ => null
    }
}
