namespace Raven.CodeAnalysis.Macros

import System.*
import System.Reflection.*
import System.Diagnostics.CodeAnalysis.*

internal static partial class MacroExpressionTypeFacts {
    static func TryGetConstraint(runtimeType: Type, [NotNullWhen(true)] out constraint: Type?) -> bool {
        if runtimeType.IsGenericType && runtimeType.GetGenericTypeDefinition() == typeof(ExpressionSyntax<>) {
            constraint = runtimeType.GetGenericArguments()[0]
            return true
        }
        constraint = null
        return false
    }

    static func CreateFacade(facadeType: Type, argument: MacroArgument) -> object {
        let constructor = facadeType.GetConstructor(
            BindingFlags.Instance | BindingFlags.NonPublic,
            binder: null,
            [typeof(Raven.CodeAnalysis.Syntax.ExpressionSyntax), typeof(TypeSymbol)],
            modifiers: null) ?? throw InvalidOperationException(
                "Macro expression facade '${facadeType}' does not expose its compiler constructor.")
        return constructor.Invoke([argument.Expression, argument.SemanticType!])
    }
}
