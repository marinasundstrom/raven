<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\eng\Package.props" />

  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <!-- <WarningsAsErrors>Nullable</WarningsAsErrors> -->
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <NoWarn>CS8669,CS1591,CS1574</NoWarn>
    <PackageId>Raven.CodeAnalysis</PackageId>
    <Title>Raven Compiler APIs</Title>
    <Description>Syntax, semantic analysis, diagnostics, workspaces, and emission APIs for the Raven compiler.</Description>
    <PackageTags>$(PackageTags);code-analysis;compiler-api</PackageTags>
  </PropertyGroup>

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <!-- A generator may be requested by concurrent builds of this multi-targeted
         project. Isolate the tool build itself as well as its target framework;
         the generator's in-process lock is acquired only after `dotnet run` has
         compiled the tool. -->
    <GeneratorArtifactsInstance>$([System.Guid]::NewGuid())</GeneratorArtifactsInstance>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Build" Version="17.7.2" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Build.Locator" Version="1.9.1" />
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="9.0.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" />
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="FrameworkProjections/standard.json"
      LogicalName="Raven.CodeAnalysis.FrameworkProjections.standard.json" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Diagnostics/Analyzers/PreferNewLineBetweenDeclarationsAnalyzer.cs" />
    <Compile Remove="Diagnostics/Analyzers/ConstructorParameterNamingAnalyzer.cs" />
    <Compile Remove="Diagnostics/Analyzers/UnnecessaryTrailingSeparatorAnalyzer.cs" />
    <Compile Remove="Diagnostics/Analyzers/PreferLetInsteadOfValAnalyzer.cs" />
    <Compile Remove="Diagnostics/Analyzers/PreferLoopOverWhileTrueAnalyzer.cs" />
    <Compile Remove="Diagnostics/CodeFixes/PreferNewLineBetweenDeclarationsCodeFixProvider.cs" />
    <Compile Remove="Diagnostics/CodeFixes/ConstructorParameterNamingCodeFixProvider.cs" />
    <Compile Remove="Diagnostics/CodeFixes/PreferLetInsteadOfValCodeFixProvider.cs" />
    <Compile Remove="Diagnostics/CodeFixes/PreferLoopOverWhileTrueCodeFixProvider.cs" />
  </ItemGroup>

  <ItemGroup>
    <BoundNodeGeneratorInput Include="BoundTree\**\*.cs"
      Exclude="BoundTree\Generated\**\*.*;BoundTree\generated\**\*.*" />
    <BoundNodeGeneratorInput Include="Symbols\**\*.cs"
      Exclude="Symbols\Generated\**\*.*;Symbols\generated\**\*.*" />
    <BoundNodeGeneratorInput Include="..\..\tools\BoundNodeGenerator\**\*.cs" />
    <BoundNodeGeneratorInput Include="..\..\tools\BoundNodeGenerator\BoundNodeGenerator.csproj" />
  </ItemGroup>

  <!-- Single hook into CoreCompile; order is deterministic via DependsOnTargets -->
  <Target Name="GenerateSources"
    BeforeTargets="CoreCompile"
    DependsOnTargets="RunNodeGenerator;RunBoundNodeGenerator;RunDiagnosticsGenerator"
    Condition="'$(DesignTimeBuild)' != 'true'" />

  <Target Name="RunNodeGenerator"
    Inputs="Syntax/Model.xml;Syntax/Factories.xml;Syntax/Tokens.xml;Syntax/NodeKinds.xml;../../tools/NodeGenerator/**/*.cs;../../tools/NodeGenerator/NodeGenerator.csproj;../../tools/NodesShared/**/*.cs;../../tools/NodesShared/NodesShared.csproj"
    Outputs="Syntax/generated/.stamp"
    Condition="'$(DesignTimeBuild)' != 'true'">
    <MakeDir Directories="Syntax/generated" />
    <!-- WorkingDirectory is Syntax, so the project path is relative to that folder -->
    <Exec Command="dotnet run --project ../../../tools/NodeGenerator --artifacts-path &quot;$(MSBuildProjectDirectory)/obj/generator-artifacts/NodeGenerator/$(TargetFramework)/$(GeneratorArtifactsInstance)&quot;"
      WorkingDirectory="Syntax" />
    <Touch Files="Syntax/generated/.stamp" AlwaysCreate="true" />
  </Target>

  <Target Name="RunBoundNodeGenerator"
    Inputs="@(BoundNodeGeneratorInput)"
    Outputs="BoundTree/generated/.stamp"
    Condition="'$(DesignTimeBuild)' != 'true'">
    <MakeDir Directories="BoundTree/generated" />
    <Exec Command="dotnet run --project ../../tools/BoundNodeGenerator --artifacts-path &quot;$(MSBuildProjectDirectory)/obj/generator-artifacts/BoundNodeGenerator/$(TargetFramework)/$(GeneratorArtifactsInstance)&quot;" />
    <Touch Files="BoundTree/generated/.stamp" AlwaysCreate="true" />
  </Target>

  <Target Name="RunDiagnosticsGenerator"
    Inputs="DiagnosticDescriptors.xml;../../tools/DiagnosticsGenerator/**/*.cs;../../tools/DiagnosticsGenerator/DiagnosticsGenerator.csproj"
    Outputs=".diagnostics.stamp"
    Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="dotnet run --framework net10.0 --project ../../tools/DiagnosticsGenerator --artifacts-path &quot;$(MSBuildProjectDirectory)/obj/generator-artifacts/DiagnosticsGenerator/$(TargetFramework)/$(GeneratorArtifactsInstance)&quot;" />
    <Touch Files=".diagnostics.stamp" AlwaysCreate="true" />
  </Target>

</Project>
