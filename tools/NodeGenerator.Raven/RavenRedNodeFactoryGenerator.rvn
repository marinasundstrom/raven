namespace Raven.Generators

import System.*
import System.Collections.Generic.*
import System.Linq.*
import System.Text.*
import NodesShared.*

public static partial class RavenRedNodeGenerator
{
    static func GenerateFactory(node: SyntaxNodeModel, definition: FactoryDefinitionModel? = null) -> string?
    {
        if node.IsAbstract { return null }
        let builder = StringBuilder()
        Line(builder, "namespace Raven.CodeAnalysis.Syntax")
        Line(builder, "import System.*")
        Line(builder, "public static partial class SyntaxFactory {")
        if definition is not null
        {
            for overload in definition!.Overloads
            {
                let parameters = List<string>()
                let values = Dictionary<string, string>(StringComparer.Ordinal)
                for parameter in overload.Parameters
                {
                    if parameter.Slot == "Kind"
                    {
                        parameters.Add("kind: SyntaxKind")
                        values["Kind"] = "kind"
                    }
                    else
                    {
                        let slot = node.Slots.Single(s => s.Name == parameter.Slot)
                        parameters.Add(Camel(slot.Name) + ": " + MapType(slot.FullTypeName, slot.IsNullable))
                        values[slot.Name] = Camel(slot.Name)
                    }
                }
                for value in overload.Defaults { values[value.Slot] = FactoryDefault(value) }
                let arguments = List<string>()
                if node.HasExplicitKind { arguments.Add(values["Kind"]) }
                arguments.AddRange(node.Slots.Select(s => values[s.Name]))
                if !string.IsNullOrWhiteSpace(overload.Summary) { FactorySummary(builder, overload.Summary!) }
                FactoryMethod(builder, node.Name, node.Name + "Syntax", node.Name + "Syntax", parameters, arguments)
                if !string.IsNullOrWhiteSpace(overload.Alias)
                {
                    FactorySummary(builder, if string.IsNullOrWhiteSpace(overload.Summary) { "Alias for " + node.Name + "." } else { overload.Summary! })
                    Line(builder, "    /// <remarks>")
                    Line(builder, "    /// Alias for <c>" + node.Name + "</c>. Prefer the canonical factory name unless the alias is clearer at the call site.")
                    Line(builder, "    /// </remarks>")
                    FactoryMethod(builder, overload.Alias!, node.Name + "Syntax", node.Name + "Syntax", parameters, arguments)
                }
            }
        }
        else
        {
            let parameters = List<string>()
            let minimal = List<string>()
            let arguments = List<string>()
            let defaults = List<string>()
            if node.HasExplicitKind
            {
                parameters.Add("kind: SyntaxKind")
                minimal.Add("kind: SyntaxKind")
                arguments.Add("kind")
                defaults.Add("kind")
            }
            for slot in node.Slots
            {
                let parameter = Camel(slot.Name) + ": " + MapType(slot.FullTypeName, slot.IsNullable)
                parameters.Add(parameter)
                arguments.Add(Camel(slot.Name))
                if slot.Type == "Token" && slot.DefaultToken is string token { defaults.Add(FactoryToken(token)) }
                else if slot.Type == "Token" && slot.IsOptionalToken { defaults.Add(FactoryToken("None")) }
                else if slot.IsNullable { defaults.Add("null") }
                else
                {
                    minimal.Add(parameter)
                    defaults.Add(Camel(slot.Name))
                }
            }
            if minimal.Count < parameters.Count { FactoryMethod(builder, node.Name, node.Name + "Syntax", node.Name, minimal, defaults) }
            FactoryMethod(builder, node.Name, node.Name + "Syntax", node.Name + "Syntax", parameters, arguments)
        }
        Line(builder, "}")
        return builder.ToString()
    }

    private static func FactoryMethod(builder: StringBuilder, name: string, typeName: string, callee: string, parameters: List<string>, arguments: List<string>)
    {
        Line(builder, "    static func " + name + "(" + string.Join(", ", parameters) + ") -> " + typeName + " => " + callee + "(" + string.Join(", ", arguments) + ")")
    }

    private static func FactoryDefault(value: FactoryDefaultModel) -> string
    {
        if value.Token is string token { return FactoryToken(token) }
        if value.Null { return "null" }
        throw InvalidOperationException("Factory default for slot '" + value.Slot + "' is missing a supported value.")
    }

    private static func FactoryToken(token: string) -> string => "Token(SyntaxKind." + token + ")"

    private static func FactorySummary(builder: StringBuilder, summary: string)
    {
        Line(builder, "    /// <summary>")
        Line(builder, "    /// " + (System.Security.SecurityElement.Escape(summary) ?? summary))
        Line(builder, "    /// </summary>")
    }
}
