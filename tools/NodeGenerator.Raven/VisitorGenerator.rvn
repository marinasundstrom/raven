namespace Raven.Generators

import System.*
import System.Collections.Generic.*
import System.Linq.*
import System.Text.*
import Microsoft.CodeAnalysis.*
import Microsoft.CodeAnalysis.CSharp.*
import Microsoft.CodeAnalysis.CSharp.Syntax.*
import Microsoft.CodeAnalysis.CSharp.SyntaxFactory.*
import NodesShared.*

public static class VisitorGenerator
{
    private static func IsDerivedFrom(
        candidate: SyntaxNodeModel,
        rootName: string,
        byName: IReadOnlyDictionary<string, SyntaxNodeModel>) -> bool
    {
        var current = candidate
        while !string.IsNullOrEmpty(current.Inherits)
        {
            if string.Equals(current.Inherits, rootName, StringComparison.Ordinal) {
                return true
            }

            if !byName.TryGetValue(current.Inherits, out current) {
                break
            }
        }

        return false
    }

    private static func GetDispatchGroups(allNodes: List<SyntaxNodeModel>) -> IEnumerable<(Root: SyntaxNodeModel, Cases: List<SyntaxNodeModel>)>
    {
        let byName = allNodes.ToDictionary(n => n.Name, StringComparer.Ordinal)
        for root in allNodes.Where(n => n.IsAbstract)
        {
            let cases = allNodes
                .Where(n => !n.IsAbstract && IsDerivedFrom(n, root.Name, byName))
                .OrderBy(n => n.Name, StringComparer.Ordinal)
                .ToList()

            if cases.Count > 0 {
                yield (root, cases)
            }
        }
    }

    private static func BuildVisitorDispatchMethod(root: SyntaxNodeModel, cases: IReadOnlyList<SyntaxNodeModel>) -> MemberDeclarationSyntax
    {
        let sb = StringBuilder()
        sb.AppendLine("public virtual void Visit${root.Name}(${root.Name}Syntax node)")
        sb.AppendLine("{")
        sb.AppendLine("    switch (node)")
        sb.AppendLine("    {")
        for c in cases {
            sb.AppendLine("        case ${c.Name}Syntax n: Visit${c.Name}(n); return;")
        }
        sb.AppendLine("        default: DefaultVisit(node); return;")
        sb.AppendLine("    }")
        sb.AppendLine("}")
        return ParseMemberDeclaration(sb.ToString())!
    }

    private static func BuildGenericVisitorDispatchMethod(root: SyntaxNodeModel, cases: IReadOnlyList<SyntaxNodeModel>) -> MemberDeclarationSyntax
    {
        let sb = StringBuilder()
        sb.AppendLine("public virtual TResult Visit${root.Name}(${root.Name}Syntax node)")
        sb.AppendLine("{")
        sb.AppendLine("    return node switch")
        sb.AppendLine("    {")
        for c in cases {
            sb.AppendLine("        ${c.Name}Syntax n => Visit${c.Name}(n),")
        }
        sb.AppendLine("        _ => DefaultVisit(node),")
        sb.AppendLine("    };")
        sb.AppendLine("}")
        return ParseMemberDeclaration(sb.ToString())!
    }

    private static func BuildRewriterDispatchMethod(root: SyntaxNodeModel, cases: IReadOnlyList<SyntaxNodeModel>) -> MemberDeclarationSyntax
    {
        let sb = StringBuilder()
        sb.AppendLine("public override SyntaxNode? Visit${root.Name}(${root.Name}Syntax node)")
        sb.AppendLine("{")
        sb.AppendLine("    return node switch")
        sb.AppendLine("    {")
        for c in cases {
            sb.AppendLine("        ${c.Name}Syntax n => Visit${c.Name}(n),")
        }
        sb.AppendLine("        _ => node,")
        sb.AppendLine("    };")
        sb.AppendLine("}")
        return ParseMemberDeclaration(sb.ToString())!
    }

    public static func GenerateVisitorClass(allNodes: List<SyntaxNodeModel>, isPublic: bool = true, namespaceName: string = "Raven.CodeAnalysis.Syntax") -> CompilationUnitSyntax
    {
        let dispatchMethods = GetDispatchGroups(allNodes)
            .Select(group => BuildVisitorDispatchMethod(group.Root, group.Cases))
            .ToArray()

        let methods = allNodes
            .Where(n => !n.IsAbstract)
            .Select(n =>
                MethodDeclaration(
                    PredefinedType(Token(SyntaxKind.VoidKeyword)),
                    Identifier("Visit" + n.Name))
                .AddModifiers(Token(SyntaxKind.PublicKeyword), Token(SyntaxKind.VirtualKeyword))
                .AddParameterListParameters(
                    Parameter(Identifier("node"))
                        .WithType(IdentifierName(n.Name + "Syntax")))
                .WithBody(Block(
                    ExpressionStatement(
                        InvocationExpression(
                            IdentifierName("DefaultVisit"))
                        .WithArgumentList(ArgumentList(SingletonSeparatedList(
                            Argument(IdentifierName("node")))))))))
            .ToArray()

        let visitorClass =
            ClassDeclaration("SyntaxVisitor")
                .AddModifiers(if isPublic { Token(SyntaxKind.PublicKeyword) } else { Token(SyntaxKind.InternalKeyword) }, Token(SyntaxKind.AbstractKeyword), Token(SyntaxKind.PartialKeyword))
                .AddMembers(dispatchMethods.Concat(methods).ToArray())

        return CompilationUnit()
            .AddUsings(UsingDirective(ParseName(namespaceName)))
            .AddMembers(NamespaceDeclaration(ParseName(namespaceName))
                .AddMembers(visitorClass))
            .NormalizeWhitespace()
    }

    public static func GenerateGenericVisitorClass(allNodes: List<SyntaxNodeModel>, isPublic: bool = true, namespaceName: string = "Raven.CodeAnalysis.Syntax") -> CompilationUnitSyntax
    {
        let dispatchMethods = GetDispatchGroups(allNodes)
            .Select(group => BuildGenericVisitorDispatchMethod(group.Root, group.Cases))
            .ToArray()

        let methods = allNodes
            .Where(n => !n.IsAbstract)
            .Select(n =>
                MethodDeclaration(
                    IdentifierName("TResult"),
                    "Visit" + n.Name)
                .AddModifiers(Token(SyntaxKind.PublicKeyword), Token(SyntaxKind.VirtualKeyword))
                .AddParameterListParameters(
                    Parameter(Identifier("node"))
                        .WithType(IdentifierName(n.Name + "Syntax")))
                .WithBody(Block(
                    ReturnStatement(
                        InvocationExpression(
                            IdentifierName("DefaultVisit"))
                        .WithArgumentList(ArgumentList(SingletonSeparatedList(
                            Argument(IdentifierName("node"))))))))
            ).ToArray()

        let visitorClass =
            ClassDeclaration("SyntaxVisitor")
                .AddModifiers(if isPublic { Token(SyntaxKind.PublicKeyword) } else { Token(SyntaxKind.InternalKeyword) }, Token(SyntaxKind.AbstractKeyword), Token(SyntaxKind.PartialKeyword))
                .AddTypeParameterListParameters(TypeParameter("TResult"))
                .AddMembers(dispatchMethods.Concat(methods).ToArray())

        return CompilationUnit()
            .AddUsings(UsingDirective(ParseName(namespaceName)))
            .AddMembers(NamespaceDeclaration(ParseName(namespaceName))
                .AddMembers(visitorClass))
            .NormalizeWhitespace()
    }

    public static func GenerateSyntaxRewriterClass(allNodes: List<SyntaxNodeModel>, isPublic: bool = true, namespaceName: string = "Raven.CodeAnalysis.Syntax") -> CompilationUnitSyntax
    {
        let dispatchMethods = GetDispatchGroups(allNodes)
            .Select(group => BuildRewriterDispatchMethod(group.Root, group.Cases))
            .ToArray()

        let methods = allNodes
            .Where(n => !n.IsAbstract)
            .Select(n =>
            {
                // SyntaxFactory also imports a List<T>() method; qualify construction.
                let visitArgs = System.Collections.Generic.List<ArgumentSyntax>()

                if n.HasExplicitKind
                {
                    // Add: node.Kind
                    visitArgs.Add(Argument(
                        MemberAccessExpression(
                            SyntaxKind.SimpleMemberAccessExpression,
                            IdentifierName("node"),
                            IdentifierName("Kind"))))
                }

                for prop in n.Slots
                {
                    let memberAccess = MemberAccessExpression(
                        SyntaxKind.SimpleMemberAccessExpression,
                        IdentifierName("node"),
                        IdentifierName(prop.Name))

                    let b = namespaceName.Contains("InternalSyntax")

                    let visitMethodName = "Visit" + (if b { GetVisitorMethodNameGreen(prop.FullTypeName) } else { GetVisitorMethodName(prop.FullTypeName) })
                    let visitInvocation = InvocationExpression(
                        IdentifierName(visitMethodName))
                        .WithArgumentList(ArgumentList(SingletonSeparatedList(Argument(memberAccess))))

                    // Decide if cast is needed
                    let visitedArg: ExpressionSyntax = visitMethodName match
                    {
                        "VisitToken" or "VisitList" => visitInvocation,
                        _ => CastExpression(ParseTypeName((if b { MapGreenType(prop.FullTypeName, prop.IsNullable) } else { MapRedType(prop.FullTypeName, prop.IsNullable) })), visitInvocation)
                    }

                    visitArgs.Add(Argument(visitedArg))
                }

                return MethodDeclaration(NullableType(IdentifierName("SyntaxNode")), "Visit" + n.Name)
                    .AddModifiers(Token(SyntaxKind.PublicKeyword), Token(SyntaxKind.OverrideKeyword))
                    .AddParameterListParameters(
                        Parameter(Identifier("node"))
                            .WithType(IdentifierName(n.Name + "Syntax")))
                    .WithBody(Block(ReturnStatement(
                            InvocationExpression(
                                ConditionalAccessExpression(
                                    IdentifierName("node"),
                                    MemberBindingExpression(IdentifierName("Update"))))
                            .WithArgumentList(ArgumentList(SeparatedList(visitArgs))))))
            }).Cast<MemberDeclarationSyntax>().ToArray()

        let classDecl =
            ClassDeclaration("SyntaxRewriter")
                .AddModifiers(if isPublic { Token(SyntaxKind.PublicKeyword) } else { Token(SyntaxKind.InternalKeyword) }, Token(SyntaxKind.AbstractKeyword), Token(SyntaxKind.PartialKeyword))
                .WithBaseList(BaseList(SingletonSeparatedList<BaseTypeSyntax>(
                    SimpleBaseType(GenericName("SyntaxVisitor")
                        .WithTypeArgumentList(TypeArgumentList(SingletonSeparatedList<TypeSyntax>(
                            NullableType(IdentifierName("SyntaxNode")))))))))
                .AddMembers(dispatchMethods.Concat(methods).ToArray())

        return CompilationUnit()
            .AddUsings(UsingDirective(ParseName(namespaceName)))
            .AddMembers(NamespaceDeclaration(ParseName(namespaceName))
                .AddMembers(classDecl))
            .NormalizeWhitespace()
    }

    private static func MapRedType(rawType: string, nullable: bool) -> string => rawType match
    {
        "Token" => if nullable { "SyntaxToken?" } else { "SyntaxToken" },
        "TokenList" => "SyntaxTokenList",
        let t when t.StartsWith("List<") => "SyntaxList<${t[(t.IndexOf('<') + 1)..^1]}Syntax>",
        let t when t.StartsWith("SeparatedList<") => "SeparatedList<${t[(t.IndexOf('<') + 1)..^1]}Syntax>",
        _ => rawType + "Syntax" + (if nullable { "?" } else { "" })
    }

    private static func MapGreenType(rawType: string, nullable: bool) -> string => rawType match
    {
        "Token" => if nullable { "SyntaxToken?" } else { "SyntaxToken" },
        "TokenList" => "SyntaxList",
        let t when t.StartsWith("List<") || t.StartsWith("SeparatedList<") => "SyntaxList",
        _ => rawType + "Syntax" + (if nullable { "?" } else { "" })
    }

    private static func GetVisitorMethodName(type: string) -> string => type match
    {
        "Token" => type, // Tokens don't use Visit
        "TokenList" => "TokenList", // TokenLists don't either
        let t when t.StartsWith("List<") || t.StartsWith("SeparatedList<") => "List", // Lists skipped
        _ => type // Other nodes use their type
    }

    private static func GetVisitorMethodNameGreen(type: string) -> string => type match
    {
        "Token" => type, // Tokens don't use Visit
        "TokenList" => "List", // TokenLists don't either
        let t when t.StartsWith("List<") || t.StartsWith("SeparatedList<") => "List", // Lists skipped
        _ => type // Other nodes use their type
    }
}
