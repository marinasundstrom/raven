namespace Raven.Generators

import System.*
import System.Collections.Generic.*
import System.Linq.*
import System.Text.*
import NodesShared.*

public static class RavenRedNodeGenerator
{
    static func GenerateNode(node: SyntaxNodeModel, directSubtypes: IReadOnlyList<string>) -> string
    {
        let builder = StringBuilder()
        Line(builder, "namespace Raven.CodeAnalysis.Syntax")
        Line(builder, "import System.*")
        let name = node.Name + "Syntax"
        if node.IsAbstract && directSubtypes.Count > 0
        {
            let types = string.Join(", ", directSubtypes.Select(t => "typeof(" + t + ")"))
            Line(builder, "[System.Runtime.CompilerServices.ClosedHierarchy(" + types + ")]")
        }
        let modifier = if node.IsAbstract { "abstract " } else { "" }
        let baseName = MapType(node.Inherits, false)
        Line(builder, "public ${modifier}partial class ${name} : ${baseName} {")
        Line(builder, "    internal init(green: InternalSyntax.${name}, parent: SyntaxNode?, position: int) : base(green, parent, position) { }")
        let slots = node.Slots.Where(s => !node.IsAbstract || s.IsInherited).ToList()
        if !node.IsAbstract
        {
            let parameters = Parameters(node, slots)
            let arguments = List<string>()
            if node.HasExplicitKind {
                arguments.Add("kind")
            }
            for slot in slots
            {
                let access = Camel(slot.Name) + (if slot.IsNullable { "?.Green" } else { ".Green" })
                let type = GreenType(slot.FullTypeName) + (if slot.IsNullable { "?" } else { "" })
                arguments.Add("(" + type + ")" + access)
            }
            arguments.Add("null")
            arguments.Add("null")
            let greenArguments = string.Join(", ", arguments)
            Line(builder, "    init(${parameters}) : self(InternalSyntax.${name}(${greenArguments}), null, 0) { }")
            let updateArguments = string.Join(", ", Arguments(node, slots))
            let comparisons = slots.Select(s => s.Name + " != " + Camel(s.Name)).ToList()
            if node.HasExplicitKind {
                comparisons.Insert(0, "Kind != kind")
            }
            let condition = if comparisons.Count == 0 { "false" } else { string.Join(" || ", comparisons) }
            Line(builder, "    func Update(${parameters}) -> ${name} {")
            Line(builder, "        if ${condition} { return ${name}(${updateArguments}) }")
            Line(builder, "        return self")
            Line(builder, "    }")
            for slot in slots
            {
                let values = slots.Select(s => if s.Name == slot.Name { Camel(s.Name) } else { "self." + s.Name }).ToList()
                if node.HasExplicitKind {
                    values.Insert(0, "Kind")
                }
                let valuesText = string.Join(", ", values)
                let parameter = Camel(slot.Name) + ": " + MapType(slot.FullTypeName, slot.IsNullable)
                Line(builder, "    func With${slot.Name}(${parameter}) -> ${name} => Update(${valuesText})")
            }
            if node.HasExplicitKind
            {
                let values = List<string>(["kind"])
                values.AddRange(slots.Select(s => "self." + s.Name))
                let valuesText = string.Join(", ", values)
                Line(builder, "    func WithKind(kind: SyntaxKind) -> ${name} => Update(${valuesText})")
            }
            Line(builder, "    override func Accept(visitor: SyntaxVisitor) => visitor.Visit${node.Name}(self)")
            Line(builder, "    override func Accept<T>(visitor: SyntaxVisitor<T>) -> T => visitor.Visit${node.Name}(self)")
        }
        for slot in node.Slots.Where(s => node.IsAbstract && s.IsAbstract && !s.IsInherited) {
            Line(builder, "    abstract val ${slot.Name}: ${MapType(slot.FullTypeName, slot.IsNullable)} { get; }")
        }
        let nodeCases = List<string>()
        var index = 0
        while index < slots.Count
        {
            let slot = slots[index]
            let rawType = slot.FullTypeName
            let type = MapType(rawType, slot.IsNullable)
            let requiredType = MapType(rawType, false)
            let propertyModifier = if slot.IsInherited { "override " } else { "" }
            let access = "Green.GetSlot(" + index + ")"
            let position = "Position + Green.GetChildStartPosition(" + index + ")"
            if rawType == "Token" || rawType == "TokenList"
            {
                var value = requiredType + "((" + GreenType(rawType) + ")" + access + "!, self, " + position + ")"
                if slot.IsNullable {
                    value = "if " + access + " is null { null } else { " + value + " }"
                }
                Line(builder, "    ${propertyModifier}val ${slot.Name}: ${type} => ${value}")
            }
            else if IsList(rawType)
            {
                let fieldName = "_" + Camel(slot.Name)
                Line(builder, "    private field ${fieldName}: ${requiredType} = default(${requiredType})")
                Line(builder, "    ${propertyModifier}val ${slot.Name}: ${type} { get {")
                if slot.IsNullable {
                    Line(builder, "        if ${access} is null { return null }")
                }
                Line(builder, "        if ${fieldName} == default(${requiredType}) { ${fieldName} = ${requiredType}((InternalSyntax.SyntaxList)${access}!, self, ${position}) }")
                Line(builder, "        return ${fieldName}")
                Line(builder, "    } }")
            }
            else
            {
                let fieldName = "_" + Camel(slot.Name)
                Line(builder, "    private field ${fieldName}: ${requiredType}? = null")
                let assertion = if slot.IsNullable { "" } else { "!" }
                Line(builder, "    ${propertyModifier}val ${slot.Name}: ${type} => (${type})GetNodeSlot(${index})${assertion}")
                nodeCases.Add("            ${index} => GetRed(ref ${fieldName}, ${index}),")
            }
            index += 1
        }
        if nodeCases.Count > 0
        {
            Line(builder, "    internal override func GetNodeSlot(index: int) -> SyntaxNode? {")
            Line(builder, "        return index match {")
            for item in nodeCases {
                Line(builder, item)
            }
            Line(builder, "            _ => throw ArgumentOutOfRangeException(nameof(index)),")
            Line(builder, "        }")
            Line(builder, "    }")
        }
        Line(builder, "}")
        return builder.ToString()
    }

    private static func Parameters(node: SyntaxNodeModel, slots: List<SlotModel>) -> string
    {
        let parameters = slots.Select(s => Camel(s.Name) + ": " + MapType(s.FullTypeName, s.IsNullable)).ToList()
        if node.HasExplicitKind {
            parameters.Insert(0, "kind: SyntaxKind")
        }
        return string.Join(", ", parameters)
    }

    private static func Arguments(node: SyntaxNodeModel, slots: List<SlotModel>) -> List<string>
    {
        let arguments = slots.Select(s => Camel(s.Name)).ToList()
        if node.HasExplicitKind {
            arguments.Insert(0, "kind")
        }
        return arguments
    }

    private static func IsList(type: string) -> bool => type.StartsWith("List<") || type.StartsWith("SeparatedList<")
    private static func GreenType(type: string) -> string => "InternalSyntax." + (if type == "Node" { "SyntaxNode" } else if type == "Token" { "SyntaxToken" } else if type == "TokenList" || IsList(type) { "SyntaxList" } else { type + "Syntax" })
    private static func MapType(type: string, nullable: bool) -> string
    {
        var mapped = if type == "Node" { "SyntaxNode" } else if type == "Token" { "SyntaxToken" } else if type == "TokenList" { "SyntaxTokenList" } else { type + "Syntax" }
        if IsList(type)
        {
            let element = type.Substring(type.IndexOf('<') + 1, type.Length - type.IndexOf('<') - 2)
            mapped = (if type.StartsWith("SeparatedList<") { "SeparatedSyntaxList<" } else { "SyntaxList<" }) + element + "Syntax>"
        }
        return if nullable { mapped + "?" } else { mapped }
    }
    private static func Camel(name: string) -> string => char.ToLowerInvariant(name[0]) + name.Substring(1)
    private static func Line(builder: StringBuilder, line: string) { _ = builder.AppendLine(line) }
}
