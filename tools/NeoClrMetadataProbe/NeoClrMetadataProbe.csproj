<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Raven.CodeAnalysis/Raven.CodeAnalysis.csproj" />
    <ProjectReference Include="$(NeoClrMetadataProject)" Condition="'$(NeoClrMetadataProject)' != ''" />
  </ItemGroup>
  <Target Name="RequireMetadataProject" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(NeoClrMetadataProject)' == ''" Text="Set NeoClrMetadataProject to the independent NeoCLR.Metadata.Experimental.csproj." />
  </Target>
</Project>
