<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <AssemblyName>NodesShared.Raven</AssemblyName>
    <OutputType>Library</OutputType>
    <ImplicitImports>false</ImplicitImports>
    <RavenEmitCoreTypesOnly>true</RavenEmitCoreTypesOnly>
    <IsPackable>false</IsPackable>
    <RavenGenerateDocumentation>false</RavenGenerateDocumentation>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <GenerateMarkdownDocumentationFile>false</GenerateMarkdownDocumentationFile>
    <GenerateXmlDocumentationFromMarkdownComments>false</GenerateXmlDocumentationFromMarkdownComments>
  </PropertyGroup>
</Project>
